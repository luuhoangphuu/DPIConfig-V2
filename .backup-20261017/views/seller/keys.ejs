<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Key của tôi</title>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    body { margin: 0; min-height: 100vh; font-family: 'Inter', sans-serif; background: url('/images/starry-night.jpg') center/cover fixed; color: #fff; }
    body::before { content: ''; position: fixed; inset: 0; background: rgba(5,13,31,0.65); z-index: -1; }
    .nav { background: rgba(10,30,63,0.85); backdrop-filter: blur(20px); border-bottom: 1px solid rgba(255,215,0,0.2); padding: 16px 32px; display: flex; justify-content: space-between; align-items: center; }
    .nav h2 { font-family: 'Caveat'; font-size: 1.6rem; color: #ffd700; margin: 0; }
    .nav a { color: #8ba3c7; text-decoration: none; margin-right: 20px; font-weight: 600; }
    .nav a.active { color: #ffd700; }
    .container-main { max-width: 1300px; margin: 0 auto; padding: 30px; }
    .page-title { font-family: 'Caveat'; font-size: 2.2rem; color: #ffd700; margin-bottom: 20px; }
    .btn-gold { padding: 11px 24px; background: linear-gradient(135deg, #ffd700, #f59e0b); color: #0a1e3f; border: none; border-radius: 12px; font-weight: 800; text-decoration: none; display: inline-block; cursor: pointer; }
    .btn-gold:hover { color: #0a1e3f; }
    .btn-ghost { padding: 9px 18px; background: rgba(5,13,31,0.6); color: #4fc3f7; border: 1.5px solid rgba(79,195,247,0.4); border-radius: 10px; text-decoration: none; }
    .btn-ghost:hover { color: #4fc3f7; }
    .data-table { background: rgba(10,30,63,0.5); backdrop-filter: blur(20px); border: 1px solid rgba(255,215,0,0.15); border-radius: 20px; overflow: hidden; }
    table { width: 100%; border-collapse: separate; border-spacing: 0; }
    th { text-align: left; padding: 14px 18px; color: #ffd700; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 2px; font-weight: 700; background: rgba(255,215,0,0.08); border-bottom: 1px solid rgba(255,215,0,0.2); }
    td { padding: 14px 18px; color: #fff; font-size: 0.9rem; border-bottom: 1px solid rgba(79,195,247,0.08); }
    tr:hover td { background: rgba(79,195,247,0.05); }
    code { background: rgba(5,13,31,0.8); color: #4fc3f7; padding: 4px 10px; border-radius: 6px; font-weight: 700; border: 1px solid rgba(79,195,247,0.3); }
    .badge-vip { padding: 4px 12px; border-radius: 12px; background: linear-gradient(135deg, #ffd700, #f59e0b); color: #0a1e3f; font-weight: 800; font-size: 0.72rem; }
    .badge-normal { padding: 4px 12px; border-radius: 12px; background: rgba(139,163,199,0.2); color: #b8c5d9; font-weight: 700; font-size: 0.72rem; }
    .toggle { position: relative; display: inline-block; width: 46px; height: 26px; }
    .toggle input { opacity: 0; width: 0; height: 0; }
    .slider { position: absolute; cursor: pointer; inset: 0; background: rgba(184,197,217,0.3); transition: 0.4s; border-radius: 26px; border: 1.5px solid rgba(184,197,217,0.3); }
    .slider:before { content: ""; position: absolute; height: 18px; width: 18px; left: 3px; bottom: 3px; background: #fff; transition: 0.4s; border-radius: 50%; }
    input:checked + .slider { background: linear-gradient(135deg, #ffd700, #f59e0b); border-color: transparent; }
    input:checked + .slider:before { transform: translateX(20px); }
    .search { width: 100%; padding: 13px 20px; background: rgba(5,13,31,0.6); border: 1.5px solid rgba(79,195,247,0.3); border-radius: 12px; color: #fff; }
    .search:focus { outline: none; border-color: #ffd700; }
    .modal-content { background: linear-gradient(180deg, rgba(10,30,63,0.98), rgba(5,13,31,0.98)); border: 1.5px solid rgba(255,215,0,0.3); border-radius: 20px; color: #fff; }
    .modal-header { border-bottom: 1px solid rgba(255,215,0,0.2); }
    .modal-title { font-family: 'Caveat'; font-size: 1.7rem; color: #ffd700; }
    .form-label { color: #ffd700; font-weight: 700; font-size: 0.78rem; letter-spacing: 1.5px; text-transform: uppercase; }
    .form-control, .form-select { background: rgba(5,13,31,0.8); border: 1.5px solid rgba(79,195,247,0.3); color: #fff; padding: 11px 16px; border-radius: 10px; }
    .form-control:focus, .form-select:focus { background: rgba(5,13,31,0.95); border-color: #ffd700; color: #fff; }
    .form-select option { background: #0a1e3f; color: #fff; }
    .countdown.safe { color: #81c784; } .countdown.warning { color: #ffd700; } .countdown.danger { color: #ef5350; }
  </style>
</head>
<body>
<div class="nav">
  <div style="display: flex; align-items: center; gap: 24px;">
    <h2><i class="fas fa-store"></i> Seller Panel</h2>
    <div>
      <a href="/seller/dashboard">Dashboard</a>
      <a href="/seller/keys" class="active">Key của tôi</a>
    </div>
  </div>
  <div style="display: flex; align-items: center; gap: 14px;">
    <span style="color: #81d4fa; font-size: 0.9rem;">
      <i class="fas fa-user-circle"></i> <%= seller.name %>
      · <span style="color: #ffd700;">Còn <%= Math.max(0, seller.quota - seller.quota_used) %> quota</span>
    </span>
    <a href="/seller/logout" class="btn-ghost" style="color: #ef5350; border-color: rgba(239,83,80,0.4);"><i class="fas fa-sign-out-alt"></i></a>
  </div>
</div>
<div class="container-main">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h1 class="page-title"><i class="fas fa-key"></i> Key của tôi</h1>
    <button class="btn-gold" data-bs-toggle="modal" data-bs-target="#createKeyModal"><i class="fas fa-plus"></i> Tạo Key</button>
  </div>
  <form method="GET" style="margin-bottom: 20px;">
    <input type="text" name="search" class="search" placeholder="🔍 Tìm kiếm..." value="<%= search %>">
  </form>
  <div class="data-table">
    <table>
      <thead><tr><th>Key</th><th>Hạng</th><th>TB</th><th>Hết hạn</th><th>Còn</th><th>Bật/Tắt</th></tr></thead>
      <tbody>
        <% keys.forEach(k => {
             const devs = k.devices || [];
             const active = devs.filter(d => d.is_active).length;
        %>
          <tr>
            <td><code><%= k.key %></code></td>
            <td><span class="<%= k.tier === 'VIP' ? 'badge-vip' : 'badge-normal' %>"><%= k.tier === 'VIP' ? '★ VIP' : 'Thường' %></span></td>
            <td><span style="color: #4fc3f7; font-weight: 700;"><%= active %></span>/<%= k.max_devices %></td>
            <td style="font-size: 0.85rem; color: #8ba3c7;"><%= new Date(k.expires_at).toLocaleString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh' }) %></td>
            <td><span class="countdown" data-expiry="<%= k.expires_at.toISOString() %>">--</span></td>
            <td>
              <form method="POST" action="/seller/keys/toggle/<%= k.id %>" style="margin:0;">
                <label class="toggle"><input type="checkbox" <%= k.is_active ? 'checked' : '' %> onchange="this.form.submit()"><span class="slider"></span></label>
              </form>
            </td>
          </tr>
        <% }) %>
        <% if (keys.length === 0) { %>
          <tr><td colspan="6" style="text-align:center; padding: 60px; color: #8ba3c7;">Chưa có key nào</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <% if (totalPages > 1) { %>
    <div style="display: flex; justify-content: center; gap: 8px; margin-top: 24px;">
      <% for (let i = 1; i <= totalPages; i++) { %>
        <a href="?page=<%= i %>&search=<%= search %>" style="padding: 10px 16px; background: <%= i === currentPage ? 'linear-gradient(135deg, #ffd700, #f59e0b)' : 'rgba(5,13,31,0.6)' %>; color: <%= i === currentPage ? '#0a1e3f' : '#4fc3f7' %>; text-decoration: none; border-radius: 10px; font-weight: 700;">
          <%= i %>
        </a>
      <% } %>
    </div>
  <% } %>
</div>

<div class="modal fade" id="createKeyModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title"><i class="fas fa-key"></i> Tạo Key</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
    <form method="POST" action="/seller/keys/create">
      <div class="modal-body">
        <div class="mb-3"><label class="form-label">Tiền tố</label><input type="text" name="prefix" class="form-control" value="HoangPhu"></div>
        <% if (seller.can_choose_tier) { %>
          <div class="mb-3"><label class="form-label">Hạng</label><select name="tier" class="form-select"><option value="VIP">★ VIP</option><option value="Normal" selected>Thường</option></select></div>
        <% } else { %>
          <input type="hidden" name="tier" value="<%= seller.default_tier %>">
        <% } %>
        <% if (seller.can_choose_duration) { %>
          <div class="mb-3"><label class="form-label">Thời hạn</label><select name="duration" class="form-select"><option value="1">1 ngày</option><option value="7">7 ngày</option><option value="30" selected>30 ngày</option><option value="90">90 ngày</option><option value="365">1 năm</option><option value="forever">♾️ Vĩnh viễn</option></select></div>
        <% } else { %>
          <input type="hidden" name="duration" value="30">
        <% } %>
        <div style="background: rgba(255,215,0,0.08); padding: 12px; border-radius: 10px; font-size: 0.9rem;">
          Còn <strong style="color: #ffd700;"><%= Math.max(0, seller.quota - seller.quota_used) %></strong> quota.
        </div>
      </div>
      <div class="modal-footer"><button type="submit" class="btn-gold">Tạo</button></div>
    </form>
  </div></div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('created') === '1') Swal.fire({ icon: 'success', title: 'Đã tạo key', timer: 2000, showConfirmButton: false });
  if (urlParams.get('error') === 'quota_exceeded') Swal.fire({ icon: 'error', title: 'Hết quota' });

  function updateCountdowns() {
    document.querySelectorAll('.countdown').forEach(el => {
      const diff = new Date(el.getAttribute('data-expiry')).getTime() - Date.now();
      if (diff <= 0) { el.textContent = 'Hết hạn'; el.className = 'countdown danger'; }
      else {
        const d = Math.floor(diff/86400000), h = Math.floor((diff%86400000)/3600000);
        el.textContent = d > 0 ? `${d}n ${h}g` : `${h}g`;
        el.className = d <= 3 ? 'countdown warning' : 'countdown safe';
      }
    });
  }
  updateCountdowns(); setInterval(updateCountdowns, 60000);
</script>
</body>
</html>
