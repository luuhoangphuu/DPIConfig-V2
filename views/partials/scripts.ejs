<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
  // ==========================================
  // STARRY NIGHT CANVAS
  // ==========================================
  (function() {
    const canvas = document.getElementById('starryCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    let width, height;

    function resize() {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
      drawStaticSky();
    }
    window.addEventListener('resize', () => {
      resize();
    });
    resize();

    // Vẽ nét cọ (brush stroke) - tăng dần độ dày
    function brushStroke(points, color, baseWidth, opacity) {
      ctx.save();
      ctx.globalAlpha = opacity;
      ctx.strokeStyle = color;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';

      for (let i = 0; i < points.length - 1; i++) {
        const t = i / points.length;
        const w = baseWidth * (0.4 + Math.sin(t * Math.PI) * 0.8);
        ctx.beginPath();
        ctx.lineWidth = w;
        ctx.moveTo(points[i][0], points[i][1]);
        ctx.lineTo(points[i + 1][0], points[i + 1][1]);
        ctx.stroke();
      }
      ctx.restore();
    }

    // Tạo đường cong xoáy (swirl)
    function makeSwirl(cx, cy, radiusX, radiusY, startAngle, endAngle, steps, noise) {
      const pts = [];
      for (let i = 0; i <= steps; i++) {
        const t = i / steps;
        const angle = startAngle + (endAngle - startAngle) * t;
        const noiseVal = Math.sin(angle * 5 + noise) * 8 + Math.sin(angle * 11) * 4;
        const r = 1 + t * 0.5;
        const x = cx + Math.cos(angle) * radiusX * r + noiseVal;
        const y = cy + Math.sin(angle) * radiusY * r + noiseVal * 0.7;
        pts.push([x, y]);
      }
      return pts;
    }

    // Vẽ sao spiral
    function drawSpiralStar(cx, cy, size, color) {
      // Glow lớn
      const glow = ctx.createRadialGradient(cx, cy, 0, cx, cy, size * 4);
      glow.addColorStop(0, color.replace('rgb', 'rgba').replace(')', ', 0.6)'));
      glow.addColorStop(0.4, color.replace('rgb', 'rgba').replace(')', ', 0.15)'));
      glow.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.fillStyle = glow;
      ctx.beginPath();
      ctx.arc(cx, cy, size * 4, 0, Math.PI * 2);
      ctx.fill();

      // Vòng xoáy quanh sao
      for (let ring = 0; ring < 3; ring++) {
        const pts = [];
        const steps = 60;
        for (let i = 0; i <= steps; i++) {
          const t = i / steps;
          const angle = t * Math.PI * 3.5;
          const radius = size * (0.5 + ring * 0.5 + t * 1.5);
          const noise = Math.sin(angle * 3) * 3;
          const x = cx + Math.cos(angle) * radius + noise;
          const y = cy + Math.sin(angle) * radius * 0.6 + noise;
          pts.push([x, y]);
        }
        brushStroke(pts, color, 2, 0.7 - ring * 0.2);
      }

      // Lõi sao
      ctx.fillStyle = color;
      ctx.beginPath();
      ctx.arc(cx, cy, size, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = '#fff8e1';
      ctx.beginPath();
      ctx.arc(cx, cy, size * 0.5, 0, Math.PI * 2);
      ctx.fill();
    }

    // Sao nhỏ nhấp nháy (animated)
    const twinkles = [];
    function drawTwinkleStars() {
      twinkles.length = 0;
      for (let i = 0; i < 50; i++) {
        twinkles.push({
          x: Math.random() * width,
          y: Math.random() * height * 0.75,
          r: 0.8 + Math.random() * 1.5,
          phase: Math.random() * Math.PI * 2,
          speed: 0.02 + Math.random() * 0.03
        });
      }
    }

    let time = 0;
    function drawStaticSky() {
      // Nền trời gradient - xanh Phổ
      const grad = ctx.createLinearGradient(0, 0, 0, height);
      grad.addColorStop(0, '#0a1e3f');
      grad.addColorStop(0.5, '#14305c');
      grad.addColorStop(0.75, '#1a4275');
      grad.addColorStop(1, '#0a1e3f');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, width, height);

      // ===== XOÁY LỚN (như Starry Night) =====
      const centerX = width * 0.5;
      const centerY = height * 0.35;

      // Xoáy trung tâm lớn nhất (đặc trưng Starry Night)
      for (let band = 0; band < 5; band++) {
        const offset = band * 12;
        const pts = makeSwirl(
          centerX + 30, centerY,
          100 + band * 15, 60 + band * 10,
          0, Math.PI * 2.5,
          180, band * 1.5
        );
        const colors = ['#4fc3f7', '#81d4fa', '#29b6f6', '#0d47a1', '#4fc3f7'];
        brushStroke(pts, colors[band], 4 + band, 0.5);
      }

      // Xoáy bên trái
      for (let band = 0; band < 4; band++) {
        const pts = makeSwirl(
          width * 0.2, height * 0.25,
          80 + band * 12, 50 + band * 8,
          0, Math.PI * 2,
          140, band * 2
        );
        const colors = ['#4fc3f7', '#29b6f6', '#81d4fa', '#0d47a1'];
        brushStroke(pts, colors[band], 3 + band, 0.45);
      }

      // Xoáy bên phải
      for (let band = 0; band < 4; band++) {
        const pts = makeSwirl(
          width * 0.78, height * 0.3,
          90 + band * 12, 55 + band * 8,
          -Math.PI / 2, Math.PI * 1.5,
          140, band * 2.5
        );
        const colors = ['#4fc3f7', '#29b6f6', '#0d47a1', '#81d4fa'];
        brushStroke(pts, colors[band], 3 + band, 0.45);
      }

      // ===== NÉT CỌ NGANG GỢN SÓNG =====
      for (let line = 0; line < 25; line++) {
        const y = 30 + line * (height * 0.03);
        const pts = [];
        const steps = 80;
        for (let i = 0; i <= steps; i++) {
          const x = (i / steps) * width;
          const wave = Math.sin(i * 0.3 + line * 0.5) * 12
                     + Math.sin(i * 0.15 + line) * 8;
          pts.push([x, y + wave]);
        }
        const colors = ['#4fc3f7', '#29b6f6', '#81d4fa', '#0d47a1', '#1565c0'];
        const color = colors[line % colors.length];
        brushStroke(pts, color, 1.5 + Math.sin(line) * 0.8, 0.25);
      }

      // ===== SAO SPIRAL LỚN =====
      drawSpiralStar(width * 0.13, height * 0.18, 14, '#ffd700');
      drawSpiralStar(width * 0.87, height * 0.15, 12, '#ffd700');
      drawSpiralStar(width * 0.62, height * 0.42, 10, '#ffc107');
      drawSpiralStar(width * 0.32, height * 0.5, 8, '#ffd54f');
      drawSpiralStar(width * 0.75, height * 0.55, 7, '#ffeb3b');

      // ===== TRĂNG LƯỠI LIỀM =====
      const moonX = width * 0.88;
      const moonY = height * 0.32;

      // Glow trăng
      const moonGlow = ctx.createRadialGradient(moonX, moonY, 0, moonX, moonY, 80);
      moonGlow.addColorStop(0, 'rgba(255, 215, 0, 0.5)');
      moonGlow.addColorStop(0.5, 'rgba(255, 215, 0, 0.15)');
      moonGlow.addColorStop(1, 'rgba(255, 215, 0, 0)');
      ctx.fillStyle = moonGlow;
      ctx.beginPath();
      ctx.arc(moonX, moonY, 80, 0, Math.PI * 2);
      ctx.fill();

      // Trăng tròn
      ctx.fillStyle = '#ffd700';
      ctx.beginPath();
      ctx.arc(moonX, moonY, 25, 0, Math.PI * 2);
      ctx.fill();
      // Tạo hình lưỡi liềm
      ctx.fillStyle = '#0a1e3f';
      ctx.beginPath();
      ctx.arc(moonX - 10, moonY - 5, 22, 0, Math.PI * 2);
      ctx.fill();

      // ===== CÂY BÁCH (Cypress) Ở GÓC TRÁI =====
      ctx.save();
      ctx.globalAlpha = 0.85;
      const cypressX = width * 0.05;
      const cypressBaseY = height * 0.95;
      const cypressTopY = height * 0.35;

      // Thân cây - nét cọ dọc
      for (let i = 0; i < 30; i++) {
        const offsetX = (Math.random() - 0.5) * 40;
        const pts = [];
        for (let t = 0; t <= 1; t += 0.1) {
          const y = cypressBaseY - (cypressBaseY - cypressTopY) * t;
          const wiggle = Math.sin(t * 8 + i) * 5;
          const narrow = 1 - t * 0.7;
          pts.push([cypressX + offsetX * narrow + wiggle, y]);
        }
        const greenColors = ['#0d2818', '#1a3d28', '#0a1e3f', '#1b5e20'];
        brushStroke(pts, greenColors[i % 4], 1.5, 0.4);
      }
      ctx.restore();

      // ===== LÀNG NHỎ BÊN DƯỚI =====
      ctx.save();
      const villageY = height * 0.88;
      // Đồi đen
      ctx.fillStyle = '#000814';
      ctx.beginPath();
      ctx.moveTo(0, height);
      for (let x = 0; x <= width; x += 10) {
        const y = villageY + Math.sin(x * 0.005) * 15 + Math.random() * 3;
        ctx.lineTo(x, y);
      }
      ctx.lineTo(width, height);
      ctx.closePath();
      ctx.fill();

      // Cửa sổ nhà phát sáng
      for (let i = 0; i < 8; i++) {
        const x = width * 0.25 + i * (width * 0.08);
        const y = villageY + Math.random() * 10 + 5;
        const glowWin = ctx.createRadialGradient(x, y, 0, x, y, 15);
        glowWin.addColorStop(0, 'rgba(255, 215, 0, 0.8)');
        glowWin.addColorStop(1, 'rgba(255, 215, 0, 0)');
        ctx.fillStyle = glowWin;
        ctx.beginPath();
        ctx.arc(x, y, 15, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#ffd700';
        ctx.fillRect(x - 2, y - 3, 4, 6);
      }
      ctx.restore();

      // Tạo twinkle stars cho animation
      drawTwinkleStars();
    }

    // Animation loop - chỉ vẽ sao nhấp nháy
    let skySnapshot = null;
    function animate() {
      if (!skySnapshot) {
        skySnapshot = ctx.getImageData(0, 0, width, height);
      }

      time += 0.03;
      // Chỉ vẽ lại các ngôi sao nhấp nháy
      twinkles.forEach(s => {
        s.phase += s.speed;
        const alpha = 0.4 + Math.sin(s.phase) * 0.6;
        const glow = ctx.createRadialGradient(s.x, s.y, 0, s.x, s.y, s.r * 8);
        glow.addColorStop(0, `rgba(255, 235, 150, ${alpha * 0.9})`);
        glow.addColorStop(0.5, `rgba(255, 215, 0, ${alpha * 0.3})`);
        glow.addColorStop(1, 'rgba(255, 215, 0, 0)');
        ctx.fillStyle = glow;
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.r * 8, 0, Math.PI * 2);
        ctx.fill();
      });

      requestAnimationFrame(animate);
    }
    // Chạy animation sau khi vẽ nền xong
    setTimeout(() => animate(), 100);
  })();

  // ==========================================
  // TIME
  // ==========================================
  function updateTime() {
    const t = document.getElementById('vgTime');
    if (t) {
      t.textContent = new Date().toLocaleString('vi-VN', {
        timeZone: 'Asia/Ho_Chi_Minh',
        hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false
      });
    }
    const d = document.getElementById('todayDate');
    if (d) {
      d.textContent = new Date().toLocaleDateString('vi-VN', {
        weekday: 'long', day: '2-digit', month: '2-digit', year: 'numeric',
        timeZone: 'Asia/Ho_Chi_Minh'
      });
    }
  }
  updateTime();
  setInterval(updateTime, 1000);

  // ==========================================
  // COUNTDOWN
  // ==========================================
  function updateCountdowns() {
    document.querySelectorAll('.countdown').forEach(el => {
      const expiry = new Date(el.getAttribute('data-expiry')).getTime();
      const diff = expiry - Date.now();
      if (diff <= 0) {
        el.textContent = '✕ Hết hạn';
        el.className = 'countdown danger';
      } else {
        const d = Math.floor(diff / 86400000);
        const h = Math.floor((diff % 86400000) / 3600000);
        const m = Math.floor((diff % 3600000) / 60000);
        if (d > 0) el.textContent = `${d}n ${h}g`;
        else if (h > 0) el.textContent = `${h}g ${m}p`;
        else el.textContent = `${m} phút`;
        el.className = d <= 3 ? 'countdown warning' : 'countdown safe';
      }
    });
  }
  updateCountdowns();
  setInterval(updateCountdowns, 30000);

  // ==========================================
  // TOAST
  // ==========================================
  const urlParams = new URLSearchParams(window.location.search);
  const Toast = Swal.mixin({
    toast: true,
    position: 'top-end',
    showConfirmButton: false,
    timer: 3000,
    timerProgressBar: true,
    background: 'rgba(10, 30, 63, 0.98)',
    color: '#ffd700',
    iconColor: '#4fc3f7'
  });

  const messages = {
    created: { icon: 'success', title: 'Đã tạo Key mới!' },
    toggled: { icon: 'success', title: 'Đã đổi trạng thái' },
    kicked: { icon: 'warning', title: 'Đã khóa tất cả thiết bị' },
    deleted_all_devices: { icon: 'error', title: 'Đã xóa tất cả thiết bị' },
    device_toggled: { icon: 'success', title: 'Đã đổi trạng thái thiết bị' },
    device_deleted: { icon: 'error', title: 'Đã xóa thiết bị' },
    extended: { icon: 'success', title: 'Đã gia hạn Key' },
    deleted: { icon: 'error', title: 'Đã xóa Key' }
  };
  for (const [key, val] of Object.entries(messages)) {
    if (urlParams.get(key) === '1') Toast.fire(val);
  }
</script>
</body>
</html>
