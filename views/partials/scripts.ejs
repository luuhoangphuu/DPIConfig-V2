<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
  // ==================== WAVE GRID (LUÔN ĐỘNG) ====================
  (function() {
    const canvas = document.getElementById('waveGrid');
    const ctx = canvas.getContext('2d');
    let width, height;
    const spacing = 50; // Khoảng cách lưới
    let cols, rows;
    let points = [];
    let mouse = { x: -1000, y: -1000, radius: 200 };
    let time = 0;

    function resize() {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
      cols = Math.floor(width / spacing) + 2;
      rows = Math.floor(height / spacing) + 2;
      initPoints();
    }
    window.addEventListener('resize', resize);

    function initPoints() {
      points = [];
      for (let i = 0; i < cols; i++) {
        points[i] = [];
        for (let j = 0; j < rows; j++) {
          points[i][j] = {
            x: i * spacing,
            y: j * spacing,
            originX: i * spacing,
            originY: j * spacing
          };
        }
      }
    }

    document.addEventListener('mousemove', (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
    });
    document.addEventListener('mouseleave', () => {
      mouse.x = -1000;
      mouse.y = -1000;
    });

    resize();

    function animate() {
      ctx.clearRect(0, 0, width, height);
      time += 0.005;

      // Cập nhật vị trí các điểm
      for (let i = 0; i < cols; i++) {
        for (let j = 0; j < rows; j++) {
          let p = points[i][j];

          // ---- Dao động nền tự nhiên (luôn chạy) ----
          let wave1 = Math.sin(time * 1.3 + i * 0.5 + j * 0.4) * 3.5;
          let wave2 = Math.cos(time * 0.9 + i * 0.7 - j * 0.3) * 2.5;
          let wave3 = Math.sin(time * 0.7 + (i + j) * 0.6) * 2.0;
          let targetX = p.originX + wave1 + wave3;
          let targetY = p.originY + wave2 + wave3 * 0.8;

          // ---- Tương tác chuột (đẩy mạnh hơn) ----
          let dx = p.originX - mouse.x;
          let dy = p.originY - mouse.y;
          let dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < mouse.radius) {
            let force = (mouse.radius - dist) / mouse.radius;
            let angle = Math.atan2(dy, dx);
            let pushX = Math.cos(angle) * force * 55;
            let pushY = Math.sin(angle) * force * 55;
            targetX += pushX;
            targetY += pushY;
            // Thêm dao động phụ khi có chuột
            targetX += Math.sin(time * 15 + dist * 0.1) * force * 12;
            targetY += Math.cos(time * 15 + dist * 0.1) * force * 12;
          }

          // Di chuyển mượt về vị trí mục tiêu
          p.x += (targetX - p.x) * 0.06;
          p.y += (targetY - p.y) * 0.06;
        }
      }

      // Vẽ đường nối lưới
      ctx.strokeStyle = '#6C5CE7';
      ctx.lineWidth = 1;
      ctx.globalAlpha = 0.2;
      for (let i = 0; i < cols - 1; i++) {
        for (let j = 0; j < rows - 1; j++) {
          let p1 = points[i][j];
          let p2 = points[i + 1][j];
          let p3 = points[i][j + 1];

          ctx.beginPath();
          ctx.moveTo(p1.x, p1.y);
          ctx.lineTo(p2.x, p2.y);
          ctx.stroke();

          ctx.beginPath();
          ctx.moveTo(p1.x, p1.y);
          ctx.lineTo(p3.x, p3.y);
          ctx.stroke();
        }
      }

      // Vẽ các điểm
      ctx.fillStyle = '#6C5CE7';
      ctx.globalAlpha = 0.6;
      for (let i = 0; i < cols; i++) {
        for (let j = 0; j < rows; j++) {
          let p = points[i][j];
          ctx.beginPath();
          ctx.arc(p.x, p.y, 2.5, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      requestAnimationFrame(animate);
    }
    animate();
  })();

  // ==================== DARK MODE ====================
  const html = document.documentElement;
  const toggleBtn = document.getElementById('darkModeToggle');
  const icon = toggleBtn.querySelector('i');
  function updateIcon() {
    icon.className = html.getAttribute('data-bs-theme') === 'dark' ? 'fas fa-sun' : 'fas fa-moon';
  }
  updateIcon();
  toggleBtn.addEventListener('click', () => {
    const isDark = html.getAttribute('data-bs-theme') === 'dark';
    html.setAttribute('data-bs-theme', isDark ? 'light' : 'dark');
    localStorage.setItem('darkMode', isDark ? 'false' : 'true');
    updateIcon();
  });
  const saved = localStorage.getItem('darkMode');
  if (saved === 'true') html.setAttribute('data-bs-theme', 'dark');
  else if (saved === 'false') html.setAttribute('data-bs-theme', 'light');

  // ==================== COUNTDOWN ====================
  function updateCountdowns() {
    document.querySelectorAll('.countdown').forEach(el => {
      const expiry = new Date(el.getAttribute('data-expiry')).getTime();
      const diff = expiry - Date.now();
      if (diff <= 0) { el.textContent = 'Hết hạn'; el.className = 'countdown danger'; }
      else {
        const d = Math.floor(diff/86400000), h = Math.floor((diff%86400000)/3600000);
        el.textContent = d>0 ? d+'d '+h+'h' : h+'h';
        el.className = d<=3 ? 'countdown warning' : 'countdown safe';
      }
    });
  }
  setInterval(updateCountdowns, 60000);
  updateCountdowns();
</script>
</body>
</html>
