<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
  // Mạng lưới sóng (Wave Grid) - tương tác chuột
  (function() {
    const canvas = document.getElementById('gridCanvas');
    const ctx = canvas.getContext('2d');
    let width, height;
    const spacing = 50; // khoảng cách giữa các điểm lưới
    let cols, rows;
    let points = [];
    let mouse = { x: -1000, y: -1000 };

    function resize() {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
      cols = Math.floor(width / spacing) + 2;
      rows = Math.floor(height / spacing) + 2;
      initPoints();
    }
    window.addEventListener('resize', resize);

    function initPoints() {
      points = [];
      for (let i = 0; i < cols; i++) {
        points[i] = [];
        for (let j = 0; j < rows; j++) {
          points[i][j] = {
            origX: i * spacing,
            origY: j * spacing,
            x: i * spacing,
            y: j * spacing
          };
        }
      }
    }

    document.addEventListener('mousemove', (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
    });
    document.addEventListener('mouseleave', () => {
      mouse.x = -1000;
      mouse.y = -1000;
    });

    resize();

    function animate() {
      ctx.clearRect(0, 0, width, height);

      // Cập nhật vị trí điểm theo sóng
      for (let i = 0; i < cols; i++) {
        for (let j = 0; j < rows; j++) {
          const p = points[i][j];
          const dx = p.origX - mouse.x;
          const dy = p.origY - mouse.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          const maxDist = 200;

          if (dist < maxDist) {
            const force = (maxDist - dist) / maxDist;
            const angle = Math.atan2(dy, dx);
            // Tạo hiệu ứng sóng: đẩy ra xa và dao động
            p.x = p.origX + Math.cos(angle) * force * 30 + Math.sin(dist * 0.05 + Date.now() * 0.005) * force * 15;
            p.y = p.origY + Math.sin(angle) * force * 30 + Math.cos(dist * 0.05 + Date.now() * 0.005) * force * 15;
          } else {
            // Trở về vị trí gốc từ từ
            p.x += (p.origX - p.x) * 0.05;
            p.y += (p.origY - p.y) * 0.05;
          }
        }
      }

      // Vẽ đường nối giữa các điểm gần nhau
      ctx.strokeStyle = '#6C5CE7';
      ctx.lineWidth = 1;
      ctx.globalAlpha = 0.25;

      for (let i = 0; i < cols - 1; i++) {
        for (let j = 0; j < rows - 1; j++) {
          const p1 = points[i][j];
          const p2 = points[i + 1][j];
          const p3 = points[i][j + 1];

          ctx.beginPath();
          ctx.moveTo(p1.x, p1.y);
          ctx.lineTo(p2.x, p2.y);
          ctx.stroke();

          ctx.beginPath();
          ctx.moveTo(p1.x, p1.y);
          ctx.lineTo(p3.x, p3.y);
          ctx.stroke();
        }
      }

      // Vẽ các điểm
      ctx.fillStyle = '#6C5CE7';
      ctx.globalAlpha = 0.5;
      for (let i = 0; i < cols; i++) {
        for (let j = 0; j < rows; j++) {
          const p = points[i][j];
          ctx.beginPath();
          ctx.arc(p.x, p.y, 2, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      requestAnimationFrame(animate);
    }
    animate();
  })();

  // Dark mode toggle
  const html = document.documentElement;
  const toggleBtn = document.getElementById('darkModeToggle');
  const icon = toggleBtn.querySelector('i');
  function updateIcon() {
    icon.className = html.getAttribute('data-bs-theme') === 'dark' ? 'fas fa-sun' : 'fas fa-moon';
  }
  updateIcon();
  toggleBtn.addEventListener('click', () => {
    const isDark = html.getAttribute('data-bs-theme') === 'dark';
    html.setAttribute('data-bs-theme', isDark ? 'light' : 'dark');
    localStorage.setItem('darkMode', isDark ? 'false' : 'true');
    updateIcon();
  });
  const saved = localStorage.getItem('darkMode');
  if (saved === 'true') html.setAttribute('data-bs-theme', 'dark');
  else if (saved === 'false') html.setAttribute('data-bs-theme', 'light');

  // Countdown
  function updateCountdowns() {
    document.querySelectorAll('.countdown').forEach(el => {
      const expiry = new Date(el.getAttribute('data-expiry')).getTime();
      const diff = expiry - Date.now();
      if (diff <= 0) { el.textContent = 'Hết hạn'; el.className = 'countdown danger'; }
      else {
        const d = Math.floor(diff/86400000), h = Math.floor((diff%86400000)/3600000);
        el.textContent = d>0 ? d+'d '+h+'h' : h+'h';
        el.className = d<=3 ? 'countdown warning' : 'countdown safe';
      }
    });
  }
  setInterval(updateCountdowns, 60000);
  updateCountdowns();
</script>
</body>
</html>
