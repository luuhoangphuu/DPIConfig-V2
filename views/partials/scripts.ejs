<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
  // Mạng lưới (mesh) tương tác chuột
  (function() {
    const canvas = document.getElementById('meshCanvas');
    const ctx = canvas.getContext('2d');
    let width, height;
    const spacing = 60; // khoảng cách giữa các nút
    let nodes = [];
    let mouse = { x: -1000, y: -1000 };
    const repelRadius = 150;
    const repelStrength = 8;

    function resize() {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
      createNodes();
    }
    window.addEventListener('resize', resize);

    function createNodes() {
      nodes = [];
      const cols = Math.ceil(width / spacing) + 1;
      const rows = Math.ceil(height / spacing) + 1;
      for (let i = 0; i < cols; i++) {
        for (let j = 0; j < rows; j++) {
          nodes.push({
            x: i * spacing,
            y: j * spacing,
            ox: i * spacing,
            oy: j * spacing
          });
        }
      }
    }

    document.addEventListener('mousemove', (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
    });
    document.addEventListener('mouseleave', () => {
      mouse.x = -1000;
      mouse.y = -1000;
    });

    function animate() {
      ctx.clearRect(0, 0, width, height);

      // Cập nhật vị trí nút (bị đẩy bởi chuột, rồi hồi về)
      for (let n of nodes) {
        const dx = n.x - mouse.x;
        const dy = n.y - mouse.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < repelRadius && dist > 0) {
          const angle = Math.atan2(dy, dx);
          const force = (repelRadius - dist) / repelRadius * repelStrength;
          n.x += Math.cos(angle) * force;
          n.y += Math.sin(angle) * force;
        }
        // Hồi về vị trí gốc
        n.x += (n.ox - n.x) * 0.08;
        n.y += (n.oy - n.y) * 0.08;
      }

      // Vẽ đường nối
      ctx.strokeStyle = 'rgba(108,92,231,0.25)';
      ctx.lineWidth = 1;
      const cols = Math.ceil(width / spacing) + 1;
      const rows = Math.ceil(height / spacing) + 1;
      for (let i = 0; i < nodes.length; i++) {
        const col = i % cols;
        const row = Math.floor(i / cols);
        // Nối ngang
        if (col < cols - 1) {
          ctx.beginPath();
          ctx.moveTo(nodes[i].x, nodes[i].y);
          ctx.lineTo(nodes[i + 1].x, nodes[i + 1].y);
          ctx.stroke();
        }
        // Nối dọc
        if (row < rows - 1) {
          const below = i + cols;
          if (below < nodes.length) {
            ctx.beginPath();
            ctx.moveTo(nodes[i].x, nodes[i].y);
            ctx.lineTo(nodes[below].x, nodes[below].y);
            ctx.stroke();
          }
        }
      }

      // Vẽ chấm nút
      ctx.fillStyle = 'rgba(108,92,231,0.6)';
      for (let n of nodes) {
        ctx.beginPath();
        ctx.arc(n.x, n.y, 2.5, 0, Math.PI * 2);
        ctx.fill();
      }

      requestAnimationFrame(animate);
    }

    resize();
    animate();
  })();

  // Dark mode toggle
  const html = document.documentElement;
  const toggleBtn = document.getElementById('darkModeToggle');
  const icon = toggleBtn.querySelector('i');
  function updateIcon() {
    icon.className = html.getAttribute('data-bs-theme') === 'dark' ? 'fas fa-sun' : 'fas fa-moon';
  }
  updateIcon();
  toggleBtn.addEventListener('click', () => {
    const isDark = html.getAttribute('data-bs-theme') === 'dark';
    html.setAttribute('data-bs-theme', isDark ? 'light' : 'dark');
    localStorage.setItem('darkMode', isDark ? 'false' : 'true');
    updateIcon();
  });
  const saved = localStorage.getItem('darkMode');
  if (saved === 'true') html.setAttribute('data-bs-theme', 'dark');
  else if (saved === 'false') html.setAttribute('data-bs-theme', 'light');

  // Countdown
  function updateCountdowns() {
    document.querySelectorAll('.countdown').forEach(el => {
      const expiry = new Date(el.getAttribute('data-expiry')).getTime();
      const diff = expiry - Date.now();
      if (diff <= 0) { el.textContent = 'Hết hạn'; el.className = 'countdown danger'; }
      else {
        const d = Math.floor(diff/86400000), h = Math.floor((diff%86400000)/3600000);
        el.textContent = d>0 ? d+'d '+h+'h' : h+'h';
        el.className = d<=3 ? 'countdown warning' : 'countdown safe';
      }
    });
  }
  setInterval(updateCountdowns, 60000);
  updateCountdowns();
</script>
</body>
</html>
