<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
  // ============ VANGOGH STARRY NIGHT CANVAS ============
  (function() {
    const canvas = document.getElementById('vgCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    let width, height;
    let time = 0;

    function resize() {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resize);
    resize();

    // Sao xoáy
    const stars = [];
    for (let i = 0; i < 40; i++) {
      stars.push({
        x: Math.random() * width,
        y: Math.random() * height,
        r: Math.random() * 2.5 + 1,
        phase: Math.random() * Math.PI * 2,
        speed: 0.002 + Math.random() * 0.003,
        baseX: Math.random() * width,
        baseY: Math.random() * height,
        amp: 8 + Math.random() * 20
      });
    }

    // Đường xoáy
    const swirls = [];
    for (let i = 0; i < 3; i++) {
      swirls.push({
        x: width * (0.3 + i * 0.2),
        y: height * 0.3,
        radius: 100 + i * 80,
        phase: Math.random() * Math.PI * 2
      });
    }

    function draw() {
      ctx.clearRect(0, 0, width, height);

      // Gradient nền trời đêm
      const grad = ctx.createLinearGradient(0, 0, 0, height);
      grad.addColorStop(0, '#0a1128');
      grad.addColorStop(0.5, '#1a1e42');
      grad.addColorStop(1, '#0f172a');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, width, height);

      // Sóng xoáy (Van Gogh's swirls)
      time += 1;
      for (let i = 0; i < 5; i++) {
        ctx.beginPath();
        const cx = width * (0.15 + i * 0.2);
        const cy = height * (0.2 + (i % 2) * 0.5);
        const radius = 120 + i * 40;
        const offset = Math.sin(time * 0.01 + i) * 30;

        for (let angle = 0; angle < Math.PI * 4; angle += 0.1) {
          const r = radius + Math.sin(angle * 3 + time * 0.02 + i) * 20;
          const x = cx + Math.cos(angle) * r * 0.8 + offset;
          const y = cy + Math.sin(angle) * r * 0.6;
          if (angle === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.strokeStyle = `hsla(${200 + i * 20}, 70%, 60%, 0.08)`;
        ctx.lineWidth = 30;
        ctx.stroke();
      }

      // Sao nhấp nháy
      stars.forEach(s => {
        s.phase += s.speed;
        const twinkle = 0.5 + Math.sin(s.phase * 10) * 0.5;
        const offsetX = Math.sin(time * 0.005 + s.phase) * s.amp;
        const offsetY = Math.cos(time * 0.005 + s.phase) * s.amp * 0.6;
        const x = s.baseX + offsetX;
        const y = s.baseY + offsetY;

        // Glow lớn
        const glow = ctx.createRadialGradient(x, y, 0, x, y, s.r * 15);
        glow.addColorStop(0, `rgba(251,191,36,${0.6 * twinkle})`);
        glow.addColorStop(0.5, `rgba(251,191,36,${0.15 * twinkle})`);
        glow.addColorStop(1, 'rgba(251,191,36,0)');
        ctx.fillStyle = glow;
        ctx.beginPath();
        ctx.arc(x, y, s.r * 15, 0, Math.PI * 2);
        ctx.fill();

        // Lõi sao
        ctx.beginPath();
        ctx.arc(x, y, s.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(254,243,199,${0.8 * twinkle})`;
        ctx.fill();
      });

      // Mặt trăng
      const moonX = width - 150;
      const moonY = 120;
      const moonGlow = ctx.createRadialGradient(moonX, moonY, 0, moonX, moonY, 100);
      moonGlow.addColorStop(0, 'rgba(252,211,77,0.5)');
      moonGlow.addColorStop(0.4, 'rgba(252,211,77,0.15)');
      moonGlow.addColorStop(1, 'rgba(252,211,77,0)');
      ctx.fillStyle = moonGlow;
      ctx.beginPath();
      ctx.arc(moonX, moonY, 100, 0, Math.PI * 2);
      ctx.fill();

      ctx.beginPath();
      ctx.arc(moonX, moonY, 32, 0, Math.PI * 2);
      const moonGrad = ctx.createRadialGradient(moonX - 8, moonY - 8, 0, moonX, moonY, 32);
      moonGrad.addColorStop(0, '#fef3c7');
      moonGrad.addColorStop(1, '#fbbf24');
      ctx.fillStyle = moonGrad;
      ctx.fill();

      requestAnimationFrame(draw);
    }
    draw();
  })();

  // ============ SERVER TIME (Giờ VN) ============
  function updateTime() {
    const el = document.getElementById('vgTime');
    if (el) {
      const now = new Date();
      const options = { timeZone: 'Asia/Ho_Chi_Minh', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false };
      el.textContent = now.toLocaleString('vi-VN', options);
    }
    const dateEl = document.getElementById('vnDate');
    if (dateEl) {
      dateEl.textContent = new Date().toLocaleDateString('vi-VN', { weekday: 'long', day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'Asia/Ho_Chi_Minh' });
    }
  }
  updateTime();
  setInterval(updateTime, 1000);

  // ============ COUNTDOWN ============
  function updateCountdowns() {
    document.querySelectorAll('.countdown').forEach(el => {
      const expiry = new Date(el.getAttribute('data-expiry')).getTime();
      const diff = expiry - Date.now();
      if (diff <= 0) {
        el.textContent = '✕ Hết hạn';
        el.className = 'countdown danger';
      } else {
        const d = Math.floor(diff / 86400000);
        const h = Math.floor((diff % 86400000) / 3600000);
        const m = Math.floor((diff % 3600000) / 60000);
        if (d > 0) el.textContent = `⏳ ${d}n ${h}g`;
        else if (h > 0) el.textContent = `⏳ ${h}g ${m}p`;
        else el.textContent = `⏳ ${m} phút`;
        el.className = d <= 3 ? 'countdown warning' : 'countdown safe';
      }
    });
  }
  setInterval(updateCountdowns, 30000);
  updateCountdowns();

  // ============ TOAST ============
  const urlParams = new URLSearchParams(window.location.search);
  const Toast = Swal.mixin({
    toast: true,
    position: 'top-end',
    showConfirmButton: false,
    timer: 3000,
    timerProgressBar: true,
    background: 'rgba(15,23,42,0.95)',
    color: '#fbbf24',
    didOpen: (toast) => {
      toast.addEventListener('mouseenter', Swal.stopTimer);
      toast.addEventListener('mouseleave', Swal.resumeTimer);
    }
  });

  const messages = {
    created: { icon: 'success', title: 'Đã vẽ Key mới! 🎨' },
    toggled: { icon: 'success', title: 'Đã đổi trạng thái' },
    kicked: { icon: 'warning', title: 'Đã khóa tất cả thiết bị' },
    deleted_all_devices: { icon: 'error', title: 'Đã xóa tất cả thiết bị' },
    device_toggled: { icon: 'success', title: 'Đã đổi trạng thái thiết bị' },
    device_deleted: { icon: 'error', title: 'Đã xóa thiết bị' },
    extended: { icon: 'success', title: 'Đã gia hạn Key' },
    deleted: { icon: 'error', title: 'Đã xóa Key' }
  };
  for (const [key, val] of Object.entries(messages)) {
    if (urlParams.get(key) === '1') Toast.fire(val);
  }
</script>
</body>
</html>
