<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
  // === HIỆU ỨNG NỀN MÉO MÓ KHI DI CHUỘT ===
  const bgInteractive = document.getElementById('bgInteractive');
  document.addEventListener('mousemove', (e) => {
    const x = e.clientX / window.innerWidth;
    const y = e.clientY / window.innerHeight;
    const gradient = `radial-gradient(circle at ${x*100}% ${y*100}%, rgba(79,70,229,0.15) 0%, transparent 70%)`;
    bgInteractive.style.background = gradient;
  });

  // === PARTICLES NHẸ NHÀNG ===
  particlesJS('particles-js', {
    particles: {
      number: { value: 40, density: { enable: true, value_area: 1000 } },
      color: { value: '#4F46E5' },
      shape: { type: 'circle' },
      opacity: { value: 0.12, random: true },
      size: { value: 3, random: true },
      line_linked: { enable: false },
      move: { enable: true, speed: 0.8, direction: 'none', random: true }
    },
    interactivity: {
      events: { onhover: { enable: true, mode: 'repulse' } },
      modes: { repulse: { distance: 60 } }
    },
    retina_detect: true
  });

  // === ÂM THANH ĐA DẠNG ===
  const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

  function playTone(frequency, type, duration, volume = 0.1) {
    const oscillator = audioCtx.createOscillator();
    const gainNode = audioCtx.createGain();
    oscillator.connect(gainNode);
    gainNode.connect(audioCtx.destination);
    oscillator.frequency.value = frequency;
    oscillator.type = type;
    gainNode.gain.setValueAtTime(volume, audioCtx.currentTime);
    gainNode.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
    oscillator.start(audioCtx.currentTime);
    oscillator.stop(audioCtx.currentTime + duration);
  }

  // Click nút thường (button, .btn)
  function playClickNormal() {
    playTone(600, 'sine', 0.08, 0.08);
  }

  // Toggle ON (bật)
  function playToggleOn() {
    playTone(800, 'sine', 0.1, 0.1);
    setTimeout(() => playTone(1200, 'sine', 0.08, 0.08), 50);
  }

  // Toggle OFF (tắt)
  function playToggleOff() {
    playTone(400, 'triangle', 0.15, 0.1);
  }

  // Modal mở
  function playModalOpen() {
    playTone(500, 'sine', 0.2, 0.06);
    setTimeout(() => playTone(700, 'sine', 0.15, 0.06), 80);
  }

  // Gắn sự kiện
  document.addEventListener('click', function(e) {
    const target = e.target;
    // Toggle switch
    if (target.closest('.toggle-switch input')) {
      const checkbox = target.closest('.toggle-switch input');
      if (checkbox.checked) playToggleOn();
      else playToggleOff();
    }
    // Modal (khi bấm nút mở modal)
    else if (target.closest('[data-bs-toggle="modal"]')) {
      playModalOpen();
    }
    // Các nút khác
    else if (target.closest('button, .btn, .nav-link, .page-link')) {
      playClickNormal();
    }
  });

  // === TOAST ===
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('created') === '1') {
    Swal.fire({ icon: 'success', title: 'Thành công', text: 'Key đã được tạo!', timer: 2000, showConfirmButton: false });
  }

  // === COUNTDOWN ===
  function updateCountdowns() {
    document.querySelectorAll('.countdown').forEach(el => {
      const expiry = new Date(el.getAttribute('data-expiry')).getTime();
      const now = Date.now();
      const diff = expiry - now;
      if (diff <= 0) {
        el.textContent = 'Hết hạn';
        el.className = 'countdown danger';
      } else {
        const days = Math.floor(diff / (1000*60*60*24));
        const hours = Math.floor((diff % (1000*60*60*24)) / (1000*60*60));
        const minutes = Math.floor((diff % (1000*60*60)) / (1000*60));
        if (days > 0) {
          el.textContent = days + ' ngày ' + hours + ' giờ';
          el.className = days <= 3 ? 'countdown warning' : 'countdown safe';
        } else {
          el.textContent = hours + ' giờ ' + minutes + ' phút';
          el.className = 'countdown warning';
        }
      }
    });
  }
  setInterval(updateCountdowns, 60000);
  document.addEventListener('DOMContentLoaded', updateCountdowns);

  // === TOOLTIP ===
  var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
  var tooltipList = tooltipTriggerList.map(function (el) { return new bootstrap.Tooltip(el) });
</script>
</body>
</html>
