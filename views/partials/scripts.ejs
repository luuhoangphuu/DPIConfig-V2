<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
  function updateTime() {
    const t = document.getElementById('vgTime');
    if (t) t.textContent = new Date().toLocaleString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
    const d = document.getElementById('todayDate');
    if (d) d.textContent = new Date().toLocaleDateString('vi-VN', { weekday: 'long', day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'Asia/Ho_Chi_Minh' });
  }
  updateTime();
  setInterval(updateTime, 1000);

  function updateCountdowns() {
    document.querySelectorAll('.countdown').forEach(el => {
      const expiry = new Date(el.getAttribute('data-expiry')).getTime();
      const diff = expiry - Date.now();
      if (diff <= 0) { el.textContent = '✕ Hết hạn'; el.className = 'countdown danger'; }
      else {
        const d = Math.floor(diff / 86400000);
        const h = Math.floor((diff % 86400000) / 3600000);
        const m = Math.floor((diff % 3600000) / 60000);
        if (d > 0) el.textContent = `${d}n ${h}g`;
        else if (h > 0) el.textContent = `${h}g ${m}p`;
        else el.textContent = `${m} phút`;
        el.className = d <= 3 ? 'countdown warning' : 'countdown safe';
      }
    });
  }
  updateCountdowns();
  setInterval(updateCountdowns, 30000);

  const urlParams = new URLSearchParams(window.location.search);
  const Toast = Swal.mixin({
    toast: true, position: 'top-end', showConfirmButton: false, timer: 3000, timerProgressBar: true,
    background: 'rgba(10, 30, 63, 0.98)', color: '#ffd700', iconColor: '#4fc3f7'
  });
  const messages = {
    created: { icon: 'success', title: 'Đã tạo Key mới!' },
    toggled: { icon: 'success', title: 'Đã đổi trạng thái' },
    kicked: { icon: 'warning', title: 'Đã khóa tất cả thiết bị' },
    deleted_all_devices: { icon: 'error', title: 'Đã xóa tất cả thiết bị' },
    device_toggled: { icon: 'success', title: 'Đã đổi trạng thái thiết bị' },
    device_deleted: { icon: 'error', title: 'Đã xóa thiết bị' },
    extended: { icon: 'success', title: 'Đã gia hạn Key' },
    deleted: { icon: 'error', title: 'Đã xóa Key' }
  };
  for (const [key, val] of Object.entries(messages)) {
    if (urlParams.get(key) === '1') Toast.fire(val);
  }

  // Toggle hiệu ứng động
  const effectToggle = document.getElementById('effectToggle');
  if (effectToggle) {
    const savedEffect = localStorage.getItem('effectOff') === 'true';
    if (savedEffect) {
      document.body.classList.add('effect-off');
      effectToggle.querySelector('i').className = 'fas fa-play';
    }
    effectToggle.addEventListener('click', function() {
      const isOff = document.body.classList.toggle('effect-off');
      this.querySelector('i').className = isOff ? 'fas fa-play' : 'fas fa-pause';
      localStorage.setItem('effectOff', isOff);
      // Reload để WebGL khởi động lại đúng
      if (!isOff) location.reload();
    });
  }

  // ===== MOBILE MENU =====
  const mobileMenuBtn = document.getElementById('mobileMenuBtn');
  const mobileOverlay = document.getElementById('mobileOverlay');
  const sidebar = document.querySelector('.vg-sidebar');
  
  if (mobileMenuBtn && sidebar) {
    mobileMenuBtn.addEventListener('click', () => {
      sidebar.classList.toggle('open');
      mobileOverlay.classList.toggle('active');
    });
    
    mobileOverlay.addEventListener('click', () => {
      sidebar.classList.remove('open');
      mobileOverlay.classList.remove('active');
    });
    
    // Click vào menu thì đóng sidebar
    sidebar.querySelectorAll('.nav-link').forEach(link => {
      link.addEventListener('click', () => {
        if (window.innerWidth <= 768) {
          sidebar.classList.remove('open');
          mobileOverlay.classList.remove('active');
        }
      });
    });
  }
</script>
</body>
</html>

<script>
// ============================================
// SPRINT 1: TOPBAR + COMMAND PALETTE + TOAST
// ============================================
(function() {
  // ========== TOAST SYSTEM ==========
  window.showToast = function(type, title, desc) {
    const container = document.getElementById('snToastContainer');
    if (!container) return;
    
    const icons = { success: 'fa-check', error: 'fa-times', warning: 'fa-exclamation', info: 'fa-info' };
    const toast = document.createElement('div');
    toast.className = 'sn-toast ' + type;
    toast.innerHTML = 
      '<div class="sn-toast-icon"><i class="fas ' + (icons[type] || icons.info) + '"></i></div>' +
      '<div class="sn-toast-body">' +
        '<div class="sn-toast-title">' + title + '</div>' +
        (desc ? '<div class="sn-toast-desc">' + desc + '</div>' : '') +
      '</div>' +
      '<button class="sn-toast-close" type="button"><i class="fas fa-times"></i></button>';
    
    container.appendChild(toast);
    
    const close = () => {
      toast.classList.add('removing');
      setTimeout(() => toast.remove(), 300);
    };
    toast.querySelector('.sn-toast-close').addEventListener('click', close);
    setTimeout(close, 4000);
  };
  
  // Auto-convert URL params to toasts
  const params = new URLSearchParams(window.location.search);
  const toastMap = {
    created: ['success', 'Đã tạo thành công!', ''],
    toggled: ['success', 'Đã đổi trạng thái', ''],
    deleted: ['error', 'Đã xóa', ''],
    updated: ['success', 'Đã cập nhật', ''],
    kicked: ['warning', 'Đã khóa thiết bị', ''],
    extended: ['success', 'Đã gia hạn Key', '']
  };
  for (const [key, val] of Object.entries(toastMap)) {
    if (params.get(key) === '1' || params.get(key)) {
      window.showToast(val[0], val[1], params.get(key) !== '1' ? params.get(key) : val[2]);
      break;
    }
  }
  
  // ========== USER DROPDOWN ==========
  const userTrigger = document.getElementById('userTrigger');
  const userMenu = document.getElementById('userMenu');
  if (userTrigger && userMenu) {
    userTrigger.addEventListener('click', (e) => {
      e.stopPropagation();
      userMenu.classList.toggle('show');
    });
    document.addEventListener('click', () => userMenu.classList.remove('show'));
    userMenu.addEventListener('click', (e) => e.stopPropagation());
  }
  
  // ========== COMMAND PALETTE ==========
  const cmdkOverlay = document.getElementById('cmdkOverlay');
  const cmdkInput = document.getElementById('cmdkInput');
  const cmdkResults = document.getElementById('cmdkResults');
  const openBtn = document.getElementById('openCmdK');
  
  if (!cmdkOverlay || !cmdkInput || !cmdkResults) return;
  
  const isSuper = typeof window.__isSuper !== 'undefined' ? window.__isSuper : false;
  
  // Detect super from user role badge text
  const roleBadge = document.querySelector('.sn-user-role');
  const isSuperDetected = roleBadge && roleBadge.textContent.toLowerCase().includes('super');
  
  const allCommands = [
    { section: 'Hành động', icon: 'fa-plus-circle', label: 'Tạo Key mới', action: () => { window.location.href = '/admin/keys'; } },
    { section: 'Điều hướng', icon: 'fa-chart-pie', label: 'Dashboard', action: () => { window.location.href = '/admin/dashboard'; } },
    { section: 'Điều hướng', icon: 'fa-key', label: 'Quản lý Key', action: () => { window.location.href = '/admin/keys'; } },
    { section: 'Điều hướng', icon: 'fa-user-cog', label: 'Tài khoản', action: () => { window.location.href = '/admin/profile'; } },
  ];
  
  if (isSuperDetected) {
    allCommands.push(
      { section: 'Quản lý', icon: 'fa-user-shield', label: 'Quản trị viên', action: () => { window.location.href = '/admin/admins'; } },
      { section: 'Quản lý', icon: 'fa-store', label: 'Người bán', action: () => { window.location.href = '/admin/sellers'; } },
      { section: 'Hệ thống', icon: 'fa-cloud-download-alt', label: 'Phiên bản App', action: () => { window.location.href = '/admin/versions'; } },
      { section: 'Hệ thống', icon: 'fa-bullhorn', label: 'Thông báo', action: () => { window.location.href = '/admin/announcements'; } }
    );
  }
  
  allCommands.push(
    { section: 'Khác', icon: 'fa-sign-out-alt', label: 'Đăng xuất', action: () => { window.location.href = '/admin/logout'; } }
  );
  
  let activeIdx = 0;
  let filtered = allCommands;
  
  function renderCmds(items) {
    if (!items.length) {
      cmdkResults.innerHTML = '<div class="sn-cmdk-empty"><i class="fas fa-search" style="font-size:2rem;opacity:0.3;"></i><p style="margin-top:12px;">Không tìm thấy lệnh nào</p></div>';
      return;
    }
    let html = '';
    let lastSection = '';
    items.forEach((cmd, i) => {
      if (cmd.section !== lastSection) {
        html += '<div class="sn-cmdk-section">' + cmd.section + '</div>';
        lastSection = cmd.section;
      }
      html += '<div class="sn-cmdk-item' + (i === activeIdx ? ' active' : '') + '" data-idx="' + i + '"><i class="fas ' + cmd.icon + '"></i><span>' + cmd.label + '</span></div>';
    });
    cmdkResults.innerHTML = html;
    
    cmdkResults.querySelectorAll('.sn-cmdk-item').forEach(el => {
      el.addEventListener('click', () => {
        const idx = parseInt(el.dataset.idx);
        filtered[idx].action();
        closeCmdK();
      });
    });
  }
  
  function openCmdK() {
    cmdkOverlay.style.display = 'flex';
    cmdkInput.value = '';
    activeIdx = 0;
    filtered = allCommands;
    renderCmds(filtered);
    setTimeout(() => cmdkInput.focus(), 50);
  }
  
  function closeCmdK() {
    cmdkOverlay.style.display = 'none';
  }
  
  if (openBtn) openBtn.addEventListener('click', openCmdK);
  
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
      e.preventDefault();
      openCmdK();
    }
    if (e.key === 'Escape' && cmdkOverlay.style.display === 'flex') closeCmdK();
    
    if (cmdkOverlay.style.display === 'flex') {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        activeIdx = Math.min(activeIdx + 1, filtered.length - 1);
        renderCmds(filtered);
      }
      if (e.key === 'ArrowUp') {
        e.preventDefault();
        activeIdx = Math.max(activeIdx - 1, 0);
        renderCmds(filtered);
      }
      if (e.key === 'Enter' && filtered[activeIdx]) {
        e.preventDefault();
        filtered[activeIdx].action();
        closeCmdK();
      }
    }
  });
  
  cmdkInput.addEventListener('input', () => {
    const q = cmdkInput.value.toLowerCase().trim();
    filtered = q ? allCommands.filter(c => c.label.toLowerCase().includes(q)) : allCommands;
    activeIdx = 0;
    renderCmds(filtered);
  });
  
  cmdkOverlay.addEventListener('click', (e) => {
    if (e.target === cmdkOverlay) closeCmdK();
  });
})();
</script>

<script>
/* snMobileToggleJS */
(function() {
  var toggleBtn = document.getElementById('mobileToggle');
  var overlay = document.getElementById('snMobileOverlay');
  var sidebar = document.querySelector('.vg-sidebar') || document.querySelector('.sn-sidebar');
  if (!toggleBtn || !sidebar) return;
  function openSidebar() {
    sidebar.classList.add('open');
    if (overlay) overlay.classList.add('active');
    document.body.style.overflow = 'hidden';
  }
  function closeSidebar() {
    sidebar.classList.remove('open');
    if (overlay) overlay.classList.remove('active');
    document.body.style.overflow = '';
  }
  toggleBtn.addEventListener('click', function() {
    if (sidebar.classList.contains('open')) closeSidebar(); else openSidebar();
  });
  if (overlay) overlay.addEventListener('click', closeSidebar);
  document.querySelectorAll('.vg-sidebar .nav-link').forEach(function(link) {
    link.addEventListener('click', function() { if (window.innerWidth <= 768) closeSidebar(); });
  });
})();
</script>
