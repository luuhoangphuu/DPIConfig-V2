<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
  // ============== SKY & CLOUDS CANVAS ==============
  (function() {
    const canvas = document.getElementById('skyCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    let width, height;

    function resize() {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resize);
    resize();

    // Vẽ mây puffy theo Van Gogh style nhưng mềm mại
    function drawCloud(cx, cy, scale, opacity) {
      ctx.save();
      ctx.globalAlpha = opacity;

      // Bóng mây nhẹ
      const grad = ctx.createRadialGradient(cx, cy, 0, cx, cy, 120 * scale);
      grad.addColorStop(0, 'rgba(255, 255, 255, 0.95)');
      grad.addColorStop(0.5, 'rgba(255, 255, 255, 0.6)');
      grad.addColorStop(1, 'rgba(255, 255, 255, 0)');

      ctx.fillStyle = grad;
      ctx.beginPath();
      // Vẽ các cụm tròn tạo thành mây puffy
      const blobs = [
        [0, 0, 60], [50, -10, 45], [-50, -5, 50],
        [30, 15, 40], [-35, 12, 42], [15, -25, 35], [-20, -20, 32]
      ];
      blobs.forEach(([dx, dy, r]) => {
        ctx.arc(cx + dx * scale, cy + dy * scale, r * scale, 0, Math.PI * 2);
      });
      ctx.fill();

      // Highlight trắng ở đỉnh mây
      const hl = ctx.createRadialGradient(cx - 20 * scale, cy - 25 * scale, 0, cx - 20 * scale, cy - 25 * scale, 40 * scale);
      hl.addColorStop(0, 'rgba(255, 255, 255, 0.9)');
      hl.addColorStop(1, 'rgba(255, 255, 255, 0)');
      ctx.fillStyle = hl;
      ctx.beginPath();
      ctx.arc(cx - 20 * scale, cy - 25 * scale, 40 * scale, 0, Math.PI * 2);
      ctx.fill();

      ctx.restore();
    }

    // Danh sách mây
    const clouds = [
      { x: 0.15, y: 0.12, scale: 0.7, speed: 0.08, opacity: 0.6 },
      { x: 0.55, y: 0.08, scale: 0.5, speed: 0.05, opacity: 0.5 },
      { x: 0.85, y: 0.18, scale: 0.8, speed: 0.06, opacity: 0.55 },
      { x: 0.30, y: 0.28, scale: 0.4, speed: 0.10, opacity: 0.4 },
      { x: 0.70, y: 0.35, scale: 0.6, speed: 0.07, opacity: 0.35 },
      { x: 0.10, y: 0.55, scale: 0.5, speed: 0.09, opacity: 0.3 },
      { x: 0.90, y: 0.60, scale: 0.45, speed: 0.11, opacity: 0.28 },
    ];

    let time = 0;
    function draw() {
      ctx.clearRect(0, 0, width, height);
      time += 0.3;

      clouds.forEach((c, i) => {
        // Di chuyển mây sang phải
        let x = (c.x * width + time * c.speed) % (width + 400);
        if (x < -200) x = width + 200;
        const cy = c.y * height;
        const bobY = Math.sin(time * 0.01 + i) * 8;
        drawCloud(x - 200, cy + bobY, c.scale, c.opacity);
      });

      requestAnimationFrame(draw);
    }
    draw();
  })();

  // ============== TIME ==============
  function updateTime() {
    const t = document.getElementById('cloudTime');
    if (t) {
      const now = new Date();
      t.textContent = now.toLocaleString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
    }
    const d = document.getElementById('todayDate');
    if (d) {
      d.textContent = new Date().toLocaleDateString('vi-VN', { weekday: 'long', day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'Asia/Ho_Chi_Minh' });
    }
  }
  updateTime();
  setInterval(updateTime, 1000);

  // ============== COUNTDOWN ==============
  function updateCountdowns() {
    document.querySelectorAll('.countdown').forEach(el => {
      const expiry = new Date(el.getAttribute('data-expiry')).getTime();
      const diff = expiry - Date.now();
      if (diff <= 0) {
        el.textContent = '✕ Hết hạn';
        el.className = 'countdown danger';
      } else {
        const d = Math.floor(diff / 86400000);
        const h = Math.floor((diff % 86400000) / 3600000);
        const m = Math.floor((diff % 3600000) / 60000);
        if (d > 0) el.textContent = `${d}n ${h}g`;
        else if (h > 0) el.textContent = `${h}g ${m}p`;
        else el.textContent = `${m} phút`;
        el.className = d <= 3 ? 'countdown warning' : 'countdown safe';
      }
    });
  }
  updateCountdowns();
  setInterval(updateCountdowns, 30000);

  // ============== TOAST ==============
  const urlParams = new URLSearchParams(window.location.search);
  const Toast = Swal.mixin({
    toast: true,
    position: 'top-end',
    showConfirmButton: false,
    timer: 3000,
    timerProgressBar: true,
    background: '#ffffff',
    color: '#0c4a6e',
    iconColor: '#0ea5e9'
  });

  const messages = {
    created: { icon: 'success', title: 'Đã tạo Key mới!' },
    toggled: { icon: 'success', title: 'Đã đổi trạng thái' },
    kicked: { icon: 'warning', title: 'Đã khóa tất cả thiết bị' },
    deleted_all_devices: { icon: 'error', title: 'Đã xóa tất cả thiết bị' },
    device_toggled: { icon: 'success', title: 'Đã đổi trạng thái thiết bị' },
    device_deleted: { icon: 'error', title: 'Đã xóa thiết bị' },
    extended: { icon: 'success', title: 'Đã gia hạn Key' },
    deleted: { icon: 'error', title: 'Đã xóa Key' }
  };
  for (const [key, val] of Object.entries(messages)) {
    if (urlParams.get(key) === '1') Toast.fire(val);
  }
</script>
</body>
</html>
