<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
  particlesJS.load('particles-js', '/css/particles.json', function(){});
  if (typeof window.pJSDom === 'undefined' || window.pJSDom.length === 0) {
    particlesJS('particles-js', {
      particles: { number: { value: 50, density: { enable: true, value_area: 1000 } }, color: { value: '#00f2fe' }, shape: { type: 'circle' }, opacity: { value: 0.4, random: true }, size: { value: 3, random: true }, line_linked: { enable: true, distance: 120, color: '#00f2fe', opacity: 0.2 }, move: { enable: true, speed: 1.5, direction: 'none', random: true } },
      interactivity: { events: { onhover: { enable: true, mode: 'repulse' } } }
    });
  }

  // Dark mode (mặc định dark)
  const html = document.documentElement;
  html.setAttribute('data-bs-theme', 'dark'); // mặc định tối
  const toggleBtn = document.getElementById('darkModeToggle');
  const icon = toggleBtn.querySelector('i');
  function updateIcon() {
    if (html.getAttribute('data-bs-theme') === 'dark') {
      icon.classList.replace('fa-sun', 'fa-moon');
    } else {
      icon.classList.replace('fa-moon', 'fa-sun');
    }
  }
  updateIcon();
  toggleBtn.addEventListener('click', () => {
    const current = html.getAttribute('data-bs-theme');
    html.setAttribute('data-bs-theme', current === 'dark' ? 'light' : 'dark');
    localStorage.setItem('darkMode', current === 'dark' ? 'false' : 'true');
    updateIcon();
  });

  // Countdown
  function updateCountdowns() {
    document.querySelectorAll('.countdown').forEach(el => {
      const expiry = new Date(el.getAttribute('data-expiry')).getTime();
      const diff = expiry - Date.now();
      if (diff <= 0) { el.textContent = 'EXPIRED'; el.className = 'countdown danger'; }
      else {
        const d = Math.floor(diff/86400000), h = Math.floor((diff%86400000)/3600000), m = Math.floor((diff%3600000)/60000);
        el.textContent = d>0 ? d+'d '+h+'h' : h+'h '+m+'m';
        el.className = d<=3 ? 'countdown warning' : 'countdown safe';
      }
    });
  }
  setInterval(updateCountdowns, 60000);
  updateCountdowns();
</script>
</body>
</html>
