<!DOCTYPE html>
<html lang="vi" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'DPIConfig Admin' %></title>
  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Font Awesome 6 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Google Fonts (Orbitron cho Cyberpunk) -->
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Share+Tech+Mono&display=swap" rel="stylesheet">
  <!-- tsParticles (Network mode) -->
  <script src="https://cdn.jsdelivr.net/npm/tsparticles@2.12.0/tsparticles.bundle.min.js"></script>
  <!-- SweetAlert2 -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <!-- Anime.js -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js"></script>
  
  <style>
    :root {
      --sidebar-width: 260px;
      --neon-cyan: #00f2fe;
      --neon-pink: #f093fb;
      --neon-yellow: #f9d423;
      --bg-dark: #0a0a0f;
      --glass-bg: rgba(15, 15, 25, 0.8);
      --glass-border: rgba(0, 242, 254, 0.2);
      --font-main: 'Share Tech Mono', monospace;
      --font-display: 'Orbitron', sans-serif;
    }

    * {
      cursor: none !important; /* Tắt con trỏ mặc định để dùng custom */
    }

    body {
      font-family: var(--font-main);
      background: var(--bg-dark);
      color: #e0e0e0;
      overflow-x: hidden;
      margin: 0;
      background-image: 
        linear-gradient(rgba(0, 242, 254, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 242, 254, 0.03) 1px, transparent 1px);
      background-size: 40px 40px;
      background-position: center center;
      animation: gridMove 20s linear infinite;
    }

    @keyframes gridMove {
      0% { background-position: 0 0; }
      100% { background-position: 40px 40px; }
    }

    /* Custom Cursor */
    .cursor {
      width: 20px;
      height: 20px;
      border: 2px solid var(--neon-cyan);
      border-radius: 50%;
      position: fixed;
      top: -10px;
      left: -10px;
      pointer-events: none;
      z-index: 9999;
      transition: transform 0.1s ease, border-color 0.2s ease;
      mix-blend-mode: difference;
    }
    .cursor-dot {
      width: 6px;
      height: 6px;
      background: var(--neon-pink);
      border-radius: 50%;
      position: fixed;
      top: -3px;
      left: -3px;
      pointer-events: none;
      z-index: 10000;
      transition: transform 0.05s linear;
      box-shadow: 0 0 15px var(--neon-pink);
    }
    .cursor-trail {
      position: fixed;
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: var(--neon-cyan);
      pointer-events: none;
      z-index: 9998;
      opacity: 0;
      animation: trailFade 0.5s linear forwards;
    }
    @keyframes trailFade {
      0% { transform: scale(1); opacity: 0.8; }
      100% { transform: scale(0); opacity: 0; }
    }

    /* Sidebar */
    .sidebar {
      background: rgba(5, 5, 15, 0.9);
      backdrop-filter: blur(20px);
      border-right: 1px solid var(--glass-border);
      min-height: 100vh; width: var(--sidebar-width);
      position: fixed; left: 0; top: 0; z-index: 1000;
      box-shadow: 5px 0 25px rgba(0,242,254,0.1);
      font-family: var(--font-display);
    }
    .sidebar .nav-link {
      color: #9ca3af; transition: all 0.3s; letter-spacing: 1px;
      text-transform: uppercase; font-size: 0.85rem; margin: 5px 15px;
      border-left: 3px solid transparent;
    }
    .sidebar .nav-link:hover, .sidebar .nav-link.active {
      color: var(--neon-cyan); background: rgba(0,242,254,0.1);
      border-left: 3px solid var(--neon-cyan);
      text-shadow: 0 0 10px var(--neon-cyan);
      transform: translateX(5px);
    }
    .main-content {
      margin-left: var(--sidebar-width); padding: 30px;
      position: relative; z-index: 1;
    }

    /* Glitch Text */
    .glitch {
      font-family: var(--font-display);
      color: #fff;
      position: relative;
      text-shadow: 0 0 10px var(--neon-cyan);
      letter-spacing: 3px;
    }
    .glitch::before, .glitch::after {
      content: attr(data-text);
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
    }
    .glitch::before {
      left: 2px;
      text-shadow: -2px 0 var(--neon-pink);
      animation: glitch-anim-1 2s infinite linear alternate-reverse;
      clip: rect(44px, 450px, 56px, 0);
    }
    .glitch::after {
      left: -2px;
      text-shadow: -2px 0 var(--neon-cyan);
      animation: glitch-anim-2 3s infinite linear alternate-reverse;
      clip: rect(12px, 450px, 24px, 0);
    }
    @keyframes glitch-anim-1 {
      0% { clip: rect(2px, 9999px, 45px, 0); }
      20% { clip: rect(24px, 9999px, 67px, 0); }
      40% { clip: rect(18px, 9999px, 89px, 0); }
      60% { clip: rect(45px, 9999px, 23px, 0); }
      80% { clip: rect(12px, 9999px, 56px, 0); }
      100% { clip: rect(34px, 9999px, 78px, 0); }
    }
    @keyframes glitch-anim-2 {
      0% { clip: rect(65px, 9999px, 23px, 0); }
      20% { clip: rect(12px, 9999px, 45px, 0); }
      40% { clip: rect(34px, 9999px, 67px, 0); }
      60% { clip: rect(56px, 9999px, 89px, 0); }
      80% { clip: rect(78px, 9999px, 12px, 0); }
      100% { clip: rect(89px, 9999px, 34px, 0); }
    }

    /* Card Stats */
    .cyber-card {
      background: var(--glass-bg);
      backdrop-filter: blur(15px);
      border: 1px solid var(--glass-border);
      border-radius: 15px;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
      color: #fff;
    }
    .cyber-card::before {
      content: '';
      position: absolute;
      top: 0; left: -100%;
      width: 100%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(0,242,254,0.1), transparent);
      transition: left 0.5s ease;
    }
    .cyber-card:hover::before {
      left: 100%;
    }
    .cyber-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 0 30px rgba(0,242,254,0.3);
      border-color: var(--neon-cyan);
    }

    /* Table */
    .table-cyber {
      background: rgba(10, 10, 20, 0.6);
      backdrop-filter: blur(10px);
      color: #fff;
      border-radius: 10px;
      overflow: hidden;
    }
    .table-cyber thead th {
      background: rgba(0,242,254,0.1);
      border-bottom: 2px solid var(--neon-cyan);
      text-transform: uppercase;
      letter-spacing: 1px;
      font-weight: 400;
    }
    .table-cyber tbody tr:hover {
      background: rgba(240,147,251,0.1);
      box-shadow: inset 0 0 15px rgba(0,242,254,0.1);
    }

    /* Neon Toggle */
    .neon-toggle {
      display: inline-block; width: 50px; height: 26px; position: relative;
    }
    .neon-toggle input { opacity: 0; width: 0; height: 0; }
    .neon-slider {
      position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0;
      background: #333; transition: 0.4s; border-radius: 34px;
      box-shadow: 0 0 5px rgba(255,255,255,0.1);
    }
    .neon-slider:before {
      position: absolute; content: ""; height: 20px; width: 20px; left: 3px; bottom: 3px;
      background: #fff; transition: 0.4s; border-radius: 50%;
    }
    input:checked + .neon-slider {
      background: var(--neon-cyan);
      box-shadow: 0 0 15px var(--neon-cyan);
    }
    input:checked + .neon-slider:before {
      transform: translateX(24px);
    }

    /* Page Transition */
    .page-transition {
      position: fixed; top: 0; left: 0; width: 100%; height: 100%;
      background: var(--bg-dark); z-index: 9999; transform: scaleY(0);
      transform-origin: bottom; transition: transform 0.5s ease-in-out;
      display: flex; align-items: center; justify-content: center;
      pointer-events: none;
    }
    .page-transition.active {
      transform: scaleY(1); transform-origin: top;
    }
    .transition-text {
      font-family: var(--font-display);
      font-size: 3rem; color: var(--neon-cyan);
      text-shadow: 0 0 20px var(--neon-cyan);
      animation: pulse 0.8s infinite alternate;
    }
    @keyframes pulse {
      0% { opacity: 0.5; }
      100% { opacity: 1; }
    }

    /* Shortcut hint */
    .shortcut-hint {
      position: fixed; bottom: 20px; right: 20px;
      background: var(--glass-bg); padding: 8px 15px; border-radius: 8px;
      border: 1px solid var(--glass-border); font-size: 0.8rem;
      z-index: 1000; backdrop-filter: blur(10px);
    }
  </style>
</head>
<body>
  <!-- Custom Cursor Elements -->
  <div class="cursor"></div>
  <div class="cursor-dot"></div>
  
  <!-- Page Transition -->
  <div class="page-transition" id="pageTransition">
    <span class="transition-text">LOADING...</span>
  </div>

  <!-- tsParticles Container -->
  <div id="tsparticles" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -2;"></div>
  
  <div class="shortcut-hint">
    <kbd>Ctrl</kbd> + <kbd>N</kbd> Tạo Key | <kbd>Ctrl</kbd> + <kbd>K</kbd> Focus Search
  </div>
