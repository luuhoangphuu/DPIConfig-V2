<!DOCTYPE html>
<html lang="vi" data-bs-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'DPIConfig Admin' %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://cdn.jsdelivr.net/npm/particles.js@2.0.0/particles.min.js"></script>
  <style>
    * { font-family: 'Inter', sans-serif; }
    :root {
      --sidebar-width: 280px;
      --primary: #4F46E5;
      --primary-hover: #4338CA;
      --bg-main: #F9FAFB;
      --bg-white: #FFFFFF;
      --border-color: #E5E7EB;
      --text-primary: #111827;
      --text-muted: #6B7280;
      --success: #10B981;
      --danger: #EF4444;
      --warning: #F59E0B;
      --card-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -1px rgba(0,0,0,0.03);
      --card-hover-shadow: 0 20px 25px -5px rgba(0,0,0,0.08), 0 8px 10px -5px rgba(0,0,0,0.03);
    }
    [data-bs-theme="dark"] {
      --bg-main: #0F0F1A;
      --bg-white: #1A1A2E;
      --border-color: #2A2A3E;
      --text-primary: #EAEAEA;
      --text-muted: #999;
      --card-shadow: 0 4px 6px rgba(0,0,0,0.2);
      --card-hover-shadow: 0 20px 25px rgba(0,0,0,0.4);
    }
    body {
      background: var(--bg-main);
      color: var(--text-primary);
      overflow-x: hidden;
      transition: background 0.3s, color 0.3s;
    }
    #particles-js {
      position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -2;
      opacity: 0.4;
    }
    .bg-animated {
      position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1;
      background: radial-gradient(circle at 20% 30%, rgba(79,70,229,0.06) 0%, transparent 50%),
                  radial-gradient(circle at 80% 70%, rgba(162,155,254,0.04) 0%, transparent 50%);
      pointer-events: none;
    }
    /* Sidebar */
    .sidebar {
      background: var(--bg-white);
      border-right: 1px solid var(--border-color);
      width: var(--sidebar-width); min-height: 100vh; position: fixed; left: 0; top: 0; z-index: 1000;
      display: flex; flex-direction: column;
      box-shadow: var(--card-shadow);
      transition: all 0.3s ease;
    }
    .sidebar-header {
      padding: 24px 20px;
      border-bottom: 1px solid var(--border-color);
    }
    .sidebar .nav-link {
      color: var(--text-muted); font-weight: 500; padding: 12px 20px; margin: 4px 12px;
      border-radius: 10px; transition: all 0.2s; display: flex; align-items: center;
    }
    .sidebar .nav-link i { width: 20px; margin-right: 12px; font-size: 1.1rem; }
    .sidebar .nav-link:hover { background: rgba(79,70,229,0.08); color: var(--primary); }
    .sidebar .nav-link.active { background: rgba(79,70,229,0.12); color: var(--primary); font-weight: 600; }
    .main-content { margin-left: var(--sidebar-width); padding: 32px; }
    /* Cards */
    .stat-card {
      background: var(--bg-white); border: 1px solid var(--border-color); border-radius: 20px;
      padding: 24px; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: var(--card-shadow); position: relative; overflow: hidden;
    }
    .stat-card:hover { transform: translateY(-4px); box-shadow: var(--card-hover-shadow); }
    .stat-card .icon { font-size: 2rem; opacity: 0.7; }
    .stat-card .label { color: var(--text-muted); font-size: 0.9rem; font-weight: 500; }
    .stat-card .value { font-size: 2.2rem; font-weight: 700; margin-top: 4px; }
    /* Table */
    .table-custom {
      border-collapse: separate; border-spacing: 0 8px; width: 100%;
    }
    .table-custom thead th {
      background: transparent; color: var(--text-muted); font-weight: 600; border: none; padding: 12px 16px;
      font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;
    }
    .table-custom tbody tr {
      background: var(--bg-white); border-radius: 12px; box-shadow: var(--card-shadow);
      transition: all 0.2s;
    }
    .table-custom tbody tr:hover { box-shadow: var(--card-hover-shadow); }
    .table-custom td { padding: 14px 16px; border: none; vertical-align: middle; }
    /* Toggle switch */
    .toggle-switch { position: relative; display: inline-block; width: 44px; height: 24px; }
    .toggle-switch input { opacity: 0; width: 0; height: 0; }
    .slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #D1D5DB; transition: 0.3s; border-radius: 34px; }
    .slider:before { position: absolute; content: ""; height: 18px; width: 18px; left: 3px; bottom: 3px; background-color: white; transition: 0.3s; border-radius: 50%; }
    input:checked + .slider { background-color: var(--primary); }
    input:checked + .slider:before { transform: translateX(20px); }
    /* Ripple & skeleton đã có, giữ nguyên */
    .ripple { position: relative; overflow: hidden; }
    .ripple::after { /* ... */ }
    /* Dark mode toggle */
    .dark-mode-toggle { cursor: pointer; background: transparent; border: 1px solid var(--border-color); border-radius: 8px; padding: 6px 10px; color: var(--text-muted); transition: 0.3s; }
    .dark-mode-toggle:hover { background: rgba(79,70,229,0.1); }
    @media (max-width: 768px) {
      .sidebar { width: 70px; }
      .sidebar span, .sidebar-header h5, .sidebar-header small { display: none; }
      .main-content { margin-left: 70px; }
    }
  </style>
</head>
<body>
  <div id="particles-js"></div>
  <div class="bg-animated"></div>
