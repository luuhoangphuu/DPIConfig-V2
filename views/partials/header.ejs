        padding: 10px 12px;
        font-size: 0.82rem;
      }
      
      /* Buttons */
      .vg-btn, .btn-gold {
        padding: 10px 18px;
        font-size: 1rem;
      }
      .vg-btn-icon {
        width: 36px;
        height: 36px;
        font-size: 0.85rem;
      }
      
      /* Modal toàn màn hình trên mobile */
      .modal-dialog {
        margin: 0;
        max-width: 100%;
        min-height: 100vh;
        display: flex;
        align-items: flex-end;
      }
      .modal-content {
        border-radius: 20px 20px 0 0 !important;
        max-height: 90vh;
        overflow-y: auto;
      }
      
      /* Search */
      .vg-search, .search { padding: 12px 16px 12px 44px; font-size: 0.9rem; }
      
      /* Footer */
      .vg-footer { padding: 12px; }
      
      /* Row columns full-width */
      .row > [class*="col-"] {
        width: 100%;
        margin-bottom: 12px;
      }
    }
    @media (max-width: 480px) {
      .vg-page-title { font-size: 1.6rem; padding-left: 58px; }
      .vg-page-sub { font-size: 0.9rem; padding-left: 58px; }
      .vg-stat-value, .card .value { font-size: 2rem; }
      .vg-card { padding: 14px; }
      .vg-btn, .btn-gold { padding: 9px 16px; font-size: 0.95rem; }
    }
    
    /* Ẩn nút menu mobile trên desktop */
    .mobile-menu-btn { display: none; }
    .mobile-overlay { display: none; }

  </style>

