<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'DPIConfig HoangPhu' %></title>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    :root {
      --sidebar-width: 270px;
      --gold: #ffd700;
      --gold-2: #fbbf24;
      --gold-3: #f59e0b;
      --cyan: #4fc3f7;
      --cyan-2: #29b6f6;
      --navy: #0a1e3f;
      --navy-2: #0f2847;
      --navy-3: #1a4275;
      --cream: #fff8e1;
      --text: #f5f5f5;
      --text-muted: #b8c5d9;
      --ink: #050d1f;
      --glass: rgba(10, 30, 63, 0.72);
      --glass-light: rgba(15, 40, 71, 0.55);
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }

    body {
      font-family: 'Inter', sans-serif;
      background: #050d1f;
      color: var(--text);
      overflow-x: hidden;
      min-height: 100vh;
      position: relative;
    }

    /* ============================================
       NỀN ẢNH THẬT STARRY NIGHT
       ============================================ */
    .starry-bg {
      position: fixed;
      inset: 0;
      z-index: -3;
      background-image: url('/images/starry-night.jpg');
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
      background-repeat: no-repeat;
    }

    /* Overlay tối để chữ đọc được */
    .starry-overlay {
      position: fixed;
      inset: 0;
      z-index: -2;
      background:
        linear-gradient(180deg,
          rgba(5, 13, 31, 0.55) 0%,
          rgba(5, 13, 31, 0.7) 40%,
          rgba(5, 13, 31, 0.85) 100%);
      pointer-events: none;
    }

    /* Lớp texture vải canvas */
    .canvas-texture {
      position: fixed;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      opacity: 0.25;
      mix-blend-mode: overlay;
      background-image:
        repeating-linear-gradient(0deg, rgba(255,255,255,0.03) 0 1px, transparent 1px 3px),
        repeating-linear-gradient(90deg, rgba(0,0,0,0.04) 0 1px, transparent 1px 3px);
    }

    /* ============================================
       SIDEBAR - KÍNH MỜ TRÊN TRANH
       ============================================ */
    .vg-sidebar {
      position: fixed;
      left: 0; top: 0;
      width: var(--sidebar-width);
      min-height: 100vh;
      background:
        linear-gradient(180deg,
          rgba(5, 13, 31, 0.92) 0%,
          rgba(10, 30, 63, 0.88) 50%,
          rgba(15, 40, 71, 0.85) 100%);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-right: 1px solid rgba(255, 215, 0, 0.25);
      z-index: 100;
      display: flex; flex-direction: column;
      box-shadow:
        4px 0 40px rgba(0, 0, 0, 0.6),
        inset -1px 0 0 rgba(255, 215, 0, 0.15);
    }
    .vg-sidebar::before {
      content: '';
      position: absolute;
      top: 0; right: -1px;
      width: 1px; height: 100%;
      background: linear-gradient(180deg,
        transparent 0%,
        var(--gold) 25%,
        var(--cyan) 50%,
        var(--gold) 75%,
        transparent 100%);
      opacity: 0.6;
      animation: brushFlow 5s ease-in-out infinite;
    }
    @keyframes brushFlow {
      0%, 100% { opacity: 0.35; }
      50% { opacity: 0.8; }
    }

    /* Logo */
    .vg-logo {
      padding: 32px 20px 24px;
      text-align: center;
      border-bottom: 1px solid rgba(255, 215, 0, 0.15);
      position: relative;
    }
    .vg-logo::after {
      content: '';
      position: absolute;
      bottom: -1px; left: 15%; right: 15%;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--gold), var(--cyan), var(--gold), transparent);
    }
    .vg-star-logo {
      width: 76px; height: 76px;
      margin: 0 auto 14px;
      position: relative;
      animation: logoFloat 6s ease-in-out infinite;
    }
    @keyframes logoFloat {
      0%, 100% { transform: translateY(0) rotate(0deg); }
      50% { transform: translateY(-5px) rotate(4deg); }
    }
    .vg-star-logo svg {
      width: 100%; height: 100%;
      filter: drop-shadow(0 0 25px rgba(255, 215, 0, 0.8));
    }
    .vg-star-logo .star-core {
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      width: 14px; height: 14px;
      background: radial-gradient(circle, #fff 0%, #ffd700 60%, transparent 100%);
      border-radius: 50%;
      animation: starPulse 2.5s ease-in-out infinite;
      box-shadow: 0 0 20px #ffd700, 0 0 40px #ffd700;
    }
    @keyframes starPulse {
      0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
      50% { transform: translate(-50%, -50%) scale(1.5); opacity: 0.7; }
    }
    .vg-logo h5 {
      font-family: 'Caveat', cursive;
      font-weight: 700;
      font-size: 1.9rem;
      color: var(--gold);
      margin: 0;
      letter-spacing: 0.5px;
      text-shadow:
        0 0 30px rgba(255, 215, 0, 0.6),
        0 0 60px rgba(255, 215, 0, 0.3);
    }
    .vg-logo small {
      display: block;
      margin-top: 4px;
      color: var(--text-muted);
      font-size: 0.7rem;
      letter-spacing: 4px;
      text-transform: uppercase;
      font-weight: 600;
    }

    /* Nav */
    .vg-nav {
      padding: 20px 0;
      flex: 1;
      list-style: none;
      margin: 0;
    }
    .vg-nav li { margin: 6px 0; }
    .vg-nav .nav-link {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 13px 22px;
      margin: 0 12px;
      color: var(--text-muted);
      text-decoration: none;
      border-radius: 14px;
      font-family: 'Caveat', cursive;
      font-size: 1.35rem;
      font-weight: 600;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      border: 1.5px solid transparent;
      letter-spacing: 0.5px;
    }
    .vg-nav .nav-link i {
      width: 24px;
      font-size: 1.05rem;
      transition: transform 0.3s;
      text-align: center;
    }
    .vg-nav .nav-link:hover {
      background: rgba(79, 195, 247, 0.1);
      color: var(--cyan);
      border-color: rgba(79, 195, 247, 0.35);
      transform: translateX(4px);
    }
    .vg-nav .nav-link:hover i {
      transform: rotate(-10deg) scale(1.15);
    }
    .vg-nav .nav-link.active {
      background: linear-gradient(135deg,
        rgba(255, 215, 0, 0.2) 0%,
        rgba(79, 195, 247, 0.15) 100%);
      color: var(--gold);
      border-color: rgba(255, 215, 0, 0.5);
      box-shadow:
        0 0 30px rgba(255, 215, 0, 0.3),
        inset 0 0 25px rgba(255, 215, 0, 0.1);
    }
    .vg-nav .nav-link.active::before {
      content: '';
      position: absolute;
      left: 0; top: 20%; bottom: 20%;
      width: 4px;
      background: linear-gradient(180deg, var(--gold), var(--cyan));
      border-radius: 4px;
      box-shadow: 0 0 15px var(--gold);
    }
    .vg-nav .nav-link.active i {
      color: var(--gold);
      filter: drop-shadow(0 0 10px rgba(255, 215, 0, 0.8));
    }

    /* Footer */
    .vg-footer {
      padding: 18px;
      border-top: 1px solid rgba(255, 215, 0, 0.12);
      text-align: center;
    }
    .vg-time-badge {
      display: inline-block;
      padding: 7px 16px;
      background: rgba(5, 13, 31, 0.6);
      border: 1.5px solid rgba(79, 195, 247, 0.4);
      border-radius: 20px;
      color: var(--cyan);
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 2px;
      margin-bottom: 12px;
      font-family: 'Courier New', monospace;
      box-shadow: 0 0 15px rgba(79, 195, 247, 0.3);
    }
    .vg-user {
      font-family: 'Caveat', cursive;
      font-size: 1.05rem;
      color: var(--text-muted);
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .vg-user i { color: var(--gold-2); }
    .vg-btn-logout {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      padding: 10px 16px;
      background: rgba(255, 215, 0, 0.08);
      border: 1.5px solid rgba(255, 215, 0, 0.4);
      color: var(--gold);
      border-radius: 12px;
      font-family: 'Caveat', cursive;
      font-weight: 700;
      font-size: 1.2rem;
      text-decoration: none;
      transition: all 0.3s;
      letter-spacing: 0.5px;
    }
    .vg-btn-logout:hover {
      background: rgba(255, 215, 0, 0.2);
      border-color: var(--gold);
      color: var(--gold);
      box-shadow: 0 0 25px rgba(255, 215, 0, 0.5);
      transform: translateY(-2px);
    }
    .vg-copyright {
      color: var(--text-muted);
      font-family: 'Caveat', cursive;
      font-size: 0.95rem;
      margin-top: 14px;
      opacity: 0.6;
    }

    /* ============================================
       MAIN
       ============================================ */
    .vg-main {
      margin-left: var(--sidebar-width);
      padding: 40px 44px 60px;
      min-height: 100vh;
      position: relative;
    }
    .vg-page-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 20px;
      margin-bottom: 36px;
    }
    .vg-page-title {
      font-family: 'Caveat', cursive;
      font-weight: 700;
      font-size: 3.8rem;
      line-height: 1;
      color: var(--gold);
      margin: 0 0 8px;
      text-shadow:
        0 0 40px rgba(255, 215, 0, 0.6),
        0 0 80px rgba(255, 215, 0, 0.3),
        2px 2px 8px rgba(0, 0, 0, 0.8);
      letter-spacing: 2px;
      transform: rotate(-1deg);
      display: inline-block;
    }
    .vg-page-sub {
      font-family: 'Caveat', cursive;
      font-size: 1.4rem;
      color: var(--cyan);
      margin: 0;
      opacity: 0.95;
      font-weight: 500;
      letter-spacing: 0.5px;
      text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.8);
    }

    /* ============================================
       CARD - KÍNH MỜ TRÊN TRANH
       ============================================ */
    .vg-card {
      position: relative;
      background: var(--glass);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 215, 0, 0.25);
      border-radius: 20px;
      padding: 24px;
      box-shadow:
        0 8px 32px rgba(0, 0, 0, 0.5),
        inset 0 1px 0 rgba(255, 215, 0, 0.15);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      overflow: hidden;
    }
    .vg-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 2px;
      background: linear-gradient(90deg,
        transparent 0%, var(--gold) 30%, var(--cyan) 50%, var(--gold) 70%, transparent 100%);
      opacity: 0.7;
    }
    .vg-card:hover {
      transform: translateY(-4px);
      border-color: rgba(255, 215, 0, 0.5);
      box-shadow:
        0 16px 48px rgba(0, 0, 0, 0.6),
        0 0 60px rgba(255, 215, 0, 0.25),
        inset 0 1px 0 rgba(255, 215, 0, 0.3);
    }

    /* Stat card */
    .vg-stat { padding: 26px; position: relative; overflow: hidden; }
    .vg-stat-icon {
      width: 62px; height: 62px;
      border-radius: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.55rem;
      margin-bottom: 18px;
      position: relative;
      box-shadow:
        0 8px 20px rgba(0, 0, 0, 0.4),
        inset 0 1px 0 rgba(255, 255, 255, 0.25);
    }
    .vg-stat-icon::after {
      content: '';
      position: absolute;
      inset: -4px;
      border-radius: 22px;
      background: inherit;
      opacity: 0.35;
      filter: blur(12px);
      z-index: -1;
    }
    .vg-stat-icon.icon-total { background: linear-gradient(135deg, var(--cyan), var(--cyan-2)); color: var(--ink); }
    .vg-stat-icon.icon-active { background: linear-gradient(135deg, #66bb6a, #43a047); color: #fff; }
    .vg-stat-icon.icon-expired { background: linear-gradient(135deg, #ef5350, #c62828); color: #fff; }
    .vg-stat-icon.icon-devices { background: linear-gradient(135deg, var(--gold), var(--gold-3)); color: var(--ink); }
    .vg-stat-label {
      color: var(--text-muted);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 2px;
      font-weight: 700;
      margin-bottom: 10px;
    }
    .vg-stat-value {
      font-family: 'Caveat', cursive;
      font-size: 3.4rem;
      font-weight: 700;
      line-height: 1;
      letter-spacing: -0.5px;
    }
    .vg-stat.stat-total .vg-stat-value { color: var(--cyan); text-shadow: 0 0 25px rgba(79, 195, 247, 0.6); }
    .vg-stat.stat-active .vg-stat-value { color: #81c784; text-shadow: 0 0 25px rgba(129, 199, 132, 0.6); }
    .vg-stat.stat-expired .vg-stat-value { color: #ef5350; text-shadow: 0 0 25px rgba(239, 83, 80, 0.6); }
    .vg-stat.stat-devices .vg-stat-value { color: var(--gold); text-shadow: 0 0 25px rgba(255, 215, 0, 0.6); }

    /* Section title */
    .vg-section-title {
      font-family: 'Caveat', cursive;
      font-size: 2.4rem;
      font-weight: 700;
      color: var(--gold);
      margin: 0;
      display: flex;
      align-items: center;
      gap: 14px;
      text-shadow:
        0 0 30px rgba(255, 215, 0, 0.5),
        2px 2px 6px rgba(0, 0, 0, 0.8);
      transform: rotate(-0.5deg);
      letter-spacing: 1px;
    }
    .vg-section-title i {
      font-size: 1.6rem;
      color: var(--cyan);
      filter: drop-shadow(0 0 10px rgba(79, 195, 247, 0.8));
    }

    /* ============================================
       TABLE
       ============================================ */
    .vg-table-wrap {
      overflow: hidden;
      border-radius: 20px;
    }
    .vg-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      margin: 0;
    }
    .vg-table thead th {
      text-align: left;
      padding: 16px 20px;
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 2.5px;
      color: var(--gold);
      font-weight: 700;
      background: linear-gradient(180deg, rgba(255, 215, 0, 0.12), transparent);
      border-bottom: 1.5px solid rgba(255, 215, 0, 0.35);
    }
    .vg-table tbody tr {
      transition: all 0.3s;
      border-bottom: 1px solid rgba(255, 215, 0, 0.08);
    }
    .vg-table tbody tr:hover {
      background: rgba(79, 195, 247, 0.08);
      box-shadow: inset 4px 0 0 var(--gold);
    }
    .vg-table tbody td {
      padding: 15px 20px;
      color: var(--text);
      font-size: 0.9rem;
      vertical-align: middle;
    }
    .vg-table code {
      background: rgba(5, 13, 31, 0.85);
      color: var(--cyan);
      padding: 4px 10px;
      border-radius: 6px;
      font-family: 'Courier New', monospace;
      font-size: 0.82rem;
      font-weight: 700;
      border: 1px solid rgba(79, 195, 247, 0.3);
    }

    /* Badges */
    .vg-badge-vip {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 5px 12px;
      background: linear-gradient(135deg, var(--gold), var(--gold-3));
      color: var(--ink);
      border-radius: 16px;
      font-weight: 800;
      font-size: 0.72rem;
      letter-spacing: 0.5px;
      box-shadow: 0 4px 14px rgba(255, 215, 0, 0.4);
    }
    .vg-badge-normal {
      display: inline-flex;
      align-items: center;
      padding: 5px 12px;
      background: rgba(184, 197, 217, 0.15);
      color: var(--text-muted);
      border-radius: 16px;
      font-weight: 700;
      font-size: 0.72rem;
      letter-spacing: 0.5px;
      border: 1px solid rgba(184, 197, 217, 0.3);
    }
    .vg-badge-action {
      display: inline-block;
      padding: 4px 12px;
      background: rgba(79, 195, 247, 0.15);
      color: var(--cyan);
      border-radius: 6px;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.5px;
      border: 1px solid rgba(79, 195, 247, 0.3);
    }

    /* Toggle */
    .vg-toggle { position: relative; display: inline-block; width: 46px; height: 26px; }
    .vg-toggle input { opacity: 0; width: 0; height: 0; }
    .vg-slider {
      position: absolute;
      cursor: pointer;
      inset: 0;
      background: rgba(184, 197, 217, 0.3);
      transition: 0.4s;
      border-radius: 26px;
      border: 1.5px solid rgba(184, 197, 217, 0.3);
    }
    .vg-slider::before {
      content: "";
      position: absolute;
      height: 18px; width: 18px;
      left: 3px; bottom: 3px;
      background: #fff;
      transition: 0.4s;
      border-radius: 50%;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
    }
    .vg-toggle input:checked + .vg-slider {
      background: linear-gradient(135deg, var(--gold), var(--gold-3));
      border-color: transparent;
      box-shadow: 0 0 20px rgba(255, 215, 0, 0.6);
    }
    .vg-toggle input:checked + .vg-slider::before {
      transform: translateX(20px);
    }

    /* Buttons */
    .vg-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 12px 26px;
      background: linear-gradient(135deg, var(--gold) 0%, var(--gold-3) 100%);
      color: var(--ink);
      border: none;
      border-radius: 14px;
      font-family: 'Caveat', cursive;
      font-weight: 700;
      font-size: 1.2rem;
      letter-spacing: 0.8px;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow:
        0 8px 24px rgba(255, 215, 0, 0.4),
        inset 0 1px 0 rgba(255, 255, 255, 0.4);
      position: relative;
      overflow: hidden;
    }
    .vg-btn::before {
      content: '';
      position: absolute;
      top: 0; left: -100%;
      width: 100%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.5), transparent);
      transition: left 0.6s;
    }
    .vg-btn:hover::before { left: 100%; }
    .vg-btn:hover {
      transform: translateY(-3px);
      box-shadow:
        0 14px 36px rgba(255, 215, 0, 0.6),
        inset 0 1px 0 rgba(255, 255, 255, 0.5);
      color: var(--ink);
    }
    .vg-btn-ghost {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 20px;
      background: rgba(5, 13, 31, 0.7);
      color: var(--cyan);
      border: 1.5px solid rgba(79, 195, 247, 0.4);
      border-radius: 12px;
      font-family: 'Caveat', cursive;
      font-weight: 700;
      font-size: 1.15rem;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.3s;
      backdrop-filter: blur(10px);
      letter-spacing: 0.5px;
    }
    .vg-btn-ghost:hover {
      background: rgba(79, 195, 247, 0.15);
      border-color: var(--cyan);
      color: var(--cyan);
      box-shadow: 0 0 25px rgba(79, 195, 247, 0.4);
      transform: translateY(-2px);
    }
    .vg-btn-icon {
      width: 40px; height: 40px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: rgba(5, 13, 31, 0.6);
      border: 1px solid rgba(79, 195, 247, 0.3);
      color: var(--cyan);
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.3s;
      font-size: 0.92rem;
      padding: 0;
    }
    .vg-btn-icon:hover {
      background: linear-gradient(135deg, var(--cyan), var(--cyan-2));
      color: var(--ink);
      border-color: transparent;
      transform: translateY(-2px) scale(1.08);
      box-shadow: 0 8px 20px rgba(79, 195, 247, 0.5);
    }
    .vg-btn-icon.warn { color: var(--gold-2); border-color: rgba(255, 215, 0, 0.35); }
    .vg-btn-icon.warn:hover {
      background: linear-gradient(135deg, var(--gold), var(--gold-3));
      box-shadow: 0 8px 20px rgba(255, 215, 0, 0.5);
    }
    .vg-btn-icon.danger { color: #ef5350; border-color: rgba(239, 83, 80, 0.3); }
    .vg-btn-icon.danger:hover {
      background: linear-gradient(135deg, #ef5350, #c62828);
      color: #fff;
      box-shadow: 0 8px 20px rgba(239, 83, 80, 0.5);
    }

    /* Search */
    .vg-search-wrap { position: relative; }
    .vg-search-wrap > i {
      position: absolute;
      left: 20px; top: 50%;
      transform: translateY(-50%);
      color: var(--cyan);
      pointer-events: none;
      font-size: 1rem;
      z-index: 2;
    }
    .vg-search {
      width: 100%;
      padding: 15px 22px 15px 50px;
      background: rgba(5, 13, 31, 0.7);
      border: 1.5px solid rgba(79, 195, 247, 0.3);
      border-radius: 14px;
      color: var(--text);
      font-size: 0.95rem;
      font-weight: 500;
      transition: all 0.3s;
      backdrop-filter: blur(10px);
    }
    .vg-search::placeholder { color: var(--text-muted); opacity: 0.7; }
    .vg-search:focus {
      outline: none;
      border-color: var(--gold);
      background: rgba(5, 13, 31, 0.9);
      box-shadow:
        0 0 0 4px rgba(255, 215, 0, 0.1),
        0 0 30px rgba(255, 215, 0, 0.25);
    }

    /* Modal */
    .vg-modal {
      background: linear-gradient(180deg,
        rgba(10, 30, 63, 0.98) 0%,
        rgba(5, 13, 31, 0.98) 100%);
      backdrop-filter: blur(24px);
      border: 1.5px solid rgba(255, 215, 0, 0.3);
      border-radius: 20px;
      color: var(--text);
      box-shadow:
        0 24px 80px rgba(0, 0, 0, 0.7),
        0 0 60px rgba(255, 215, 0, 0.15),
        inset 0 1px 0 rgba(255, 215, 0, 0.2);
    }
    .vg-modal .modal-header {
      border-bottom: 1px solid rgba(255, 215, 0, 0.2);
      padding: 22px 26px;
      position: relative;
    }
    .vg-modal .modal-header::after {
      content: '';
      position: absolute;
      bottom: -1px; left: 15%; right: 15%;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--gold), var(--cyan), var(--gold), transparent);
    }
    .vg-modal .modal-title {
      font-family: 'Caveat', cursive;
      font-weight: 700;
      font-size: 1.9rem;
      color: var(--gold);
      display: flex;
      align-items: center;
      gap: 10px;
      text-shadow: 0 0 25px rgba(255, 215, 0, 0.5);
    }
    .vg-modal .modal-title i { color: var(--cyan); }
    .vg-modal .btn-close {
      filter: invert(1) brightness(2);
      opacity: 0.7;
    }
    .vg-modal .btn-close:hover { opacity: 1; }
    .vg-modal .modal-body { padding: 26px; }
    .vg-modal .modal-footer {
      border-top: 1px solid rgba(255, 215, 0, 0.15);
      padding: 20px 26px;
      gap: 12px;
    }
    .vg-modal .form-label {
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--gold);
      letter-spacing: 1.5px;
      text-transform: uppercase;
      margin-bottom: 8px;
      display: block;
    }
    .vg-modal .form-control,
    .vg-modal .form-select {
      width: 100%;
      padding: 13px 18px;
      background: rgba(5, 13, 31, 0.8);
      border: 1.5px solid rgba(79, 195, 247, 0.3);
      border-radius: 10px;
      color: var(--text);
      font-size: 0.95rem;
      font-weight: 500;
      transition: all 0.3s;
    }
    .vg-modal .form-control:focus,
    .vg-modal .form-select:focus {
      outline: none;
      border-color: var(--gold);
      background: rgba(5, 13, 31, 0.95);
      box-shadow:
        0 0 0 4px rgba(255, 215, 0, 0.1),
        0 0 30px rgba(255, 215, 0, 0.25);
      color: var(--text);
    }
    .vg-modal .form-select option {
      background: #0a1e3f;
      color: var(--text);
    }

    /* Pagination */
    .vg-pagination {
      display: flex;
      gap: 8px;
      list-style: none;
      padding: 0;
      justify-content: center;
      margin: 30px 0 0;
    }
    .vg-pagination a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 42px;
      height: 42px;
      padding: 0 14px;
      background: rgba(5, 13, 31, 0.7);
      border: 1.5px solid rgba(79, 195, 247, 0.3);
      border-radius: 10px;
      color: var(--cyan);
      font-weight: 700;
      font-size: 0.9rem;
      text-decoration: none;
      transition: all 0.25s;
      backdrop-filter: blur(10px);
    }
    .vg-pagination a:hover {
      background: rgba(79, 195, 247, 0.15);
      border-color: var(--cyan);
      transform: translateY(-2px);
    }
    .vg-pagination .active a {
      background: linear-gradient(135deg, var(--gold), var(--gold-3));
      color: var(--ink);
      border-color: transparent;
      box-shadow: 0 8px 20px rgba(255, 215, 0, 0.5);
    }

    /* Countdown */
    .countdown {
      font-family: 'Caveat', cursive;
      font-weight: 700;
      font-size: 1.15rem;
      letter-spacing: 0.3px;
    }
    .countdown.safe { color: #81c784; }
    .countdown.warning { color: var(--gold); }
    .countdown.danger { color: #ef5350; }

    /* Empty state */
    .vg-empty {
      text-align: center;
      padding: 70px 20px;
      color: var(--text-muted);
    }
    .vg-empty i {
      font-size: 3.5rem;
      color: var(--cyan);
      opacity: 0.6;
      margin-bottom: 18px;
      display: block;
      filter: drop-shadow(0 0 20px rgba(79, 195, 247, 0.7));
      animation: logoFloat 4s ease-in-out infinite;
    }
    .vg-empty p {
      font-family: 'Caveat', cursive;
      font-size: 1.5rem;
      margin: 0;
      opacity: 0.9;
    }

    /* Scrollbar */
    ::-webkit-scrollbar { width: 12px; }
    ::-webkit-scrollbar-track {
      background: rgba(5, 13, 31, 0.8);
      border-left: 1px solid rgba(255, 215, 0, 0.15);
    }
    ::-webkit-scrollbar-thumb {
      background: linear-gradient(180deg, var(--gold), var(--cyan), var(--gold));
      border-radius: 6px;
      border: 2px solid rgba(5, 13, 31, 0.8);
    }
    ::-webkit-scrollbar-thumb:hover {
      background: linear-gradient(180deg, var(--cyan), var(--gold), var(--cyan));
    }

    /* Animations */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(24px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .anim { animation: fadeUp 0.7s cubic-bezier(0.4, 0, 0.2, 1) both; }
    .d1 { animation-delay: 0.06s; }
    .d2 { animation-delay: 0.12s; }
    .d3 { animation-delay: 0.18s; }
    .d4 { animation-delay: 0.24s; }

    /* Responsive */
    @media (max-width: 768px) {
      .vg-sidebar { width: 76px; }
      .vg-sidebar span,
      .vg-logo h5,
      .vg-logo small,
      .vg-user span,
      .vg-copyright { display: none; }
      .vg-main { margin-left: 76px; padding: 22px; }
      .vg-page-title { font-size: 2.4rem; }
      .vg-stat-value { font-size: 2.4rem; }
    }
  </style>
</head>
