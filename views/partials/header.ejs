      /* Sidebar ẩn hoàn toàn */
      .vg-sidebar {
        transform: translateX(-100%);
        transition: transform 0.3s ease;
        width: 280px;
      }
      .vg-sidebar.open {
        transform: translateX(0);
      }
      
      
      /* Nút menu mobile */
      .mobile-menu-btn {
        display: flex !important;
        position: fixed;
        top: 16px;
        left: 16px;
        z-index: 1001;
