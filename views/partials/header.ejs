<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'DPIConfig HoangPhu' %></title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    * { font-family: 'Plus Jakarta Sans', sans-serif; }
    :root {
      --sidebar-width: 260px;
      /* Sky palette */
      --sky-1: #e0f2fe;   /* sky-100 */
      --sky-2: #bae6fd;   /* sky-200 */
      --sky-3: #7dd3fc;   /* sky-300 */
      --sky-4: #38bdf8;   /* sky-400 */
      --sky-5: #0ea5e9;   /* sky-500 */
      --sky-6: #0284c7;   /* sky-600 */
      --sky-7: #0369a1;   /* sky-700 */
      --blue-1: #dbeafe;
      --blue-5: #3b82f6;
      --blue-6: #2563eb;
      --blue-7: #1d4ed8;
      --cloud: #ffffff;
      --text: #0c4a6e;      /* sky-900 */
      --text-muted: #64748b; /* slate-500 */
      --border: #e0f2fe;
      --danger: #ef4444;
      --success: #10b981;
      --warning: #f59e0b;
      --shadow-sm: 0 2px 8px rgba(14, 165, 233, 0.08);
      --shadow-md: 0 8px 24px rgba(14, 165, 233, 0.12);
      --shadow-lg: 0 20px 48px rgba(14, 165, 233, 0.18);
      --radius: 16px;
    }
    body {
      background: linear-gradient(180deg, #e0f2fe 0%, #f0f9ff 40%, #ffffff 100%);
      color: var(--text);
      overflow-x: hidden;
      min-height: 100vh;
      letter-spacing: 0.1px;
    }
    /* ======= BẦU TRỜI & MÂY ĐỘNG ======= */
    #skyCanvas {
      position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1;
      pointer-events: none;
    }
    /* ======= SIDEBAR ======= */
    .cloud-sidebar {
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-right: 1px solid rgba(186, 230, 253, 0.6);
      width: var(--sidebar-width);
      min-height: 100vh;
      position: fixed;
      left: 0; top: 0;
      z-index: 100;
      display: flex;
      flex-direction: column;
      box-shadow: 4px 0 24px rgba(14, 165, 233, 0.08);
    }
    .cloud-logo {
      padding: 28px 20px 24px;
      text-align: center;
      border-bottom: 1px solid rgba(186, 230, 253, 0.5);
    }
    .cloud-logo .logo-icon {
      width: 60px; height: 60px; margin: 0 auto 12px;
      border-radius: 20px;
      background: linear-gradient(135deg, var(--sky-4), var(--blue-6));
      display: flex; align-items: center; justify-content: center;
      color: #fff; font-size: 1.6rem;
      box-shadow: 0 8px 24px rgba(59, 130, 246, 0.4);
      position: relative;
    }
    .cloud-logo .logo-icon::after {
      content: ''; position: absolute; inset: -6px;
      border-radius: 26px;
      background: linear-gradient(135deg, var(--sky-3), var(--sky-5));
      opacity: 0.3; filter: blur(12px); z-index: -1;
    }
    .cloud-logo h5 {
      font-weight: 800; font-size: 1.25rem;
      background: linear-gradient(135deg, var(--blue-7), var(--sky-6));
      -webkit-background-clip: text; background-clip: text;
      -webkit-text-fill-color: transparent;
      margin: 0; letter-spacing: -0.3px;
    }
    .cloud-logo small {
      color: var(--text-muted); font-size: 0.75rem;
      letter-spacing: 2px; text-transform: uppercase; font-weight: 600;
    }
    .cloud-nav { padding: 16px 0; flex: 1; }
    .cloud-nav .nav-link {
      color: var(--text-muted);
      font-weight: 600; font-size: 0.9rem;
      padding: 12px 22px; margin: 4px 12px;
      border-radius: 12px;
      transition: all 0.25s ease;
      display: flex; align-items: center;
      position: relative;
    }
    .cloud-nav .nav-link i {
      width: 24px; font-size: 1rem; margin-right: 10px;
      transition: all 0.25s;
    }
    .cloud-nav .nav-link:hover {
      background: rgba(125, 211, 252, 0.18);
      color: var(--sky-7);
    }
    .cloud-nav .nav-link:hover i { transform: translateX(3px); }
    .cloud-nav .nav-link.active {
      background: linear-gradient(135deg, var(--sky-5), var(--blue-6));
      color: #fff;
      box-shadow: 0 6px 20px rgba(59, 130, 246, 0.4);
    }
    .cloud-nav .nav-link.active i { color: #fff; }
    .cloud-footer {
      padding: 16px;
      border-top: 1px solid rgba(186, 230, 253, 0.5);
      text-align: center;
    }
    .cloud-time {
      font-size: 0.75rem; color: var(--sky-7);
      font-weight: 700; letter-spacing: 1px;
      margin-bottom: 8px;
      background: rgba(186, 230, 253, 0.4);
      padding: 6px 12px; border-radius: 8px;
      display: inline-block;
    }
    .cloud-user {
      font-size: 0.78rem; color: var(--text-muted);
      margin-bottom: 10px;
      display: flex; align-items: center; justify-content: center; gap: 6px;
    }
    .cloud-user i { color: var(--sky-5); }
    /* ======= MAIN ======= */
    .cloud-main { margin-left: var(--sidebar-width); padding: 32px 36px; min-height: 100vh; }
    .page-head {
      display: flex; justify-content: space-between; align-items: flex-start;
      gap: 20px; margin-bottom: 8px; flex-wrap: wrap;
    }
    .page-title {
      font-weight: 800; font-size: 1.9rem;
      color: var(--text); margin: 0;
      letter-spacing: -0.5px;
      display: flex; align-items: center; gap: 12px;
    }
    .page-title .title-icon {
      width: 44px; height: 44px; border-radius: 12px;
      background: linear-gradient(135deg, var(--sky-4), var(--blue-6));
      display: flex; align-items: center; justify-content: center;
      color: #fff; font-size: 1.2rem;
      box-shadow: 0 6px 18px rgba(59, 130, 246, 0.35);
    }
    .page-subtitle {
      color: var(--text-muted); font-size: 0.95rem;
      margin-top: 6px; margin-left: 56px;
    }
    /* ======= CARD ======= */
    .cloud-card {
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(186, 230, 253, 0.6);
      border-radius: var(--radius);
      box-shadow: var(--shadow-sm);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .cloud-card:hover { box-shadow: var(--shadow-md); }
    /* ======= STATS ======= */
    .stat-card {
      padding: 24px;
      position: relative;
      overflow: hidden;
    }
    .stat-card::before {
      content: ''; position: absolute; top: 0; right: 0;
      width: 120px; height: 120px;
      background: radial-gradient(circle at top right, rgba(125,211,252,0.25), transparent 70%);
      border-radius: 50%; transform: translate(30%, -30%);
    }
    .stat-head {
      display: flex; justify-content: space-between; align-items: flex-start;
      margin-bottom: 16px;
    }
    .stat-icon {
      width: 52px; height: 52px; border-radius: 14px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.3rem; color: #fff;
      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);
    }
    .stat-icon.bg-total { background: linear-gradient(135deg, #38bdf8, #2563eb); box-shadow: 0 6px 16px rgba(37,99,235,0.4); }
    .stat-icon.bg-active { background: linear-gradient(135deg, #34d399, #059669); box-shadow: 0 6px 16px rgba(5,150,105,0.4); }
    .stat-icon.bg-expired { background: linear-gradient(135deg, #fb7185, #dc2626); box-shadow: 0 6px 16px rgba(220,38,38,0.4); }
    .stat-icon.bg-devices { background: linear-gradient(135deg, #fbbf24, #f59e0b); box-shadow: 0 6px 16px rgba(245,158,11,0.4); }
    .stat-label {
      color: var(--text-muted); font-size: 0.78rem;
      text-transform: uppercase; letter-spacing: 1px; font-weight: 700;
      margin-bottom: 6px;
    }
    .stat-value {
      font-size: 2.2rem; font-weight: 800;
      color: var(--text); line-height: 1;
      letter-spacing: -1px;
    }
    /* ======= TABLE ======= */
    .cloud-table { width: 100%; border-collapse: separate; border-spacing: 0; }
    .cloud-table thead th {
      text-align: left; padding: 14px 16px;
      font-size: 0.72rem; text-transform: uppercase; letter-spacing: 1.2px;
      color: var(--sky-7); font-weight: 700;
      border-bottom: 2px solid var(--sky-2);
      background: rgba(224, 242, 254, 0.5);
    }
    .cloud-table thead th:first-child { border-radius: 12px 0 0 0; }
    .cloud-table thead th:last-child { border-radius: 0 12px 0 0; }
    .cloud-table tbody td {
      padding: 16px;
      border-bottom: 1px solid rgba(224, 242, 254, 0.8);
      font-size: 0.9rem;
      color: var(--text);
      vertical-align: middle;
    }
    .cloud-table tbody tr {
      transition: all 0.2s;
    }
    .cloud-table tbody tr:hover {
      background: rgba(224, 242, 254, 0.4);
    }
    .cloud-table tbody tr:hover td { color: var(--sky-7); }
    .cloud-table code {
      background: linear-gradient(135deg, #eff6ff, #dbeafe);
      color: var(--blue-7);
      padding: 5px 12px; border-radius: 8px;
      font-family: 'SF Mono', Monaco, monospace;
      font-size: 0.82rem; font-weight: 600;
      border: 1px solid #bfdbfe;
    }
    /* ======= BADGES ======= */
    .badge-tier {
      display: inline-flex; align-items: center; gap: 4px;
      padding: 5px 12px; border-radius: 20px;
      font-size: 0.72rem; font-weight: 700;
      letter-spacing: 0.5px;
    }
    .badge-vip {
      background: linear-gradient(135deg, #fef3c7, #fde68a);
      color: #92400e;
      box-shadow: 0 2px 8px rgba(251, 191, 36, 0.3);
    }
    .badge-normal {
      background: linear-gradient(135deg, #f1f5f9, #e2e8f0);
      color: #475569;
    }
    .badge-action {
      display: inline-block; padding: 4px 10px; border-radius: 6px;
      background: var(--sky-1); color: var(--sky-7);
      font-size: 0.72rem; font-weight: 700;
      letter-spacing: 0.3px;
    }
    /* ======= TOGGLE ======= */
    .cloud-toggle { position: relative; display: inline-block; width: 46px; height: 26px; }
    .cloud-toggle input { opacity: 0; width: 0; height: 0; }
    .cloud-slider {
      position: absolute; cursor: pointer; inset: 0;
      background: #cbd5e1;
      transition: 0.3s; border-radius: 26px;
    }
    .cloud-slider:before {
      content: ""; position: absolute;
      height: 20px; width: 20px; left: 3px; bottom: 3px;
      background: #fff; transition: 0.3s; border-radius: 50%;
      box-shadow: 0 2px 6px rgba(0,0,0,0.15);
    }
    input:checked + .cloud-slider {
      background: linear-gradient(135deg, var(--sky-4), var(--blue-6));
      box-shadow: 0 0 0 4px rgba(56, 189, 248, 0.15);
    }
    input:checked + .cloud-slider:before { transform: translateX(20px); }
    /* ======= BUTTONS ======= */
    .btn-cloud {
      background: linear-gradient(135deg, var(--sky-4), var(--blue-6));
      color: #fff; border: none;
      padding: 11px 24px; border-radius: 12px;
      font-weight: 700; font-size: 0.88rem;
      letter-spacing: 0.3px;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 6px 18px rgba(59, 130, 246, 0.35);
      display: inline-flex; align-items: center; gap: 8px;
    }
    .btn-cloud:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 28px rgba(59, 130, 246, 0.5);
      color: #fff;
    }
    .btn-cloud:active { transform: translateY(0); }
    .btn-ghost {
      background: rgba(255, 255, 255, 0.7);
      color: var(--sky-7);
      border: 1px solid var(--sky-2);
      padding: 9px 18px; border-radius: 10px;
      font-weight: 600; font-size: 0.85rem;
      transition: all 0.2s;
      display: inline-flex; align-items: center; gap: 6px;
    }
    .btn-ghost:hover {
      background: var(--sky-1);
      border-color: var(--sky-4);
      color: var(--blue-7);
    }
    .btn-icon {
      width: 36px; height: 36px; padding: 0;
      display: inline-flex; align-items: center; justify-content: center;
      border-radius: 10px;
      background: rgba(255, 255, 255, 0.8);
      border: 1px solid var(--sky-2);
      color: var(--sky-7);
      transition: all 0.25s;
      cursor: pointer;
    }
    .btn-icon:hover {
      background: linear-gradient(135deg, var(--sky-4), var(--blue-6));
      color: #fff; border-color: transparent;
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(59, 130, 246, 0.35);
    }
    .btn-icon.danger:hover {
      background: linear-gradient(135deg, #f87171, #dc2626);
      box-shadow: 0 6px 16px rgba(220, 38, 38, 0.35);
    }
    .btn-icon.warning:hover {
      background: linear-gradient(135deg, #fbbf24, #f59e0b);
      box-shadow: 0 6px 16px rgba(245, 158, 11, 0.35);
    }
    /* ======= SEARCH ======= */
    .cloud-search {
      background: rgba(255, 255, 255, 0.85);
      border: 1.5px solid var(--sky-2);
      border-radius: 14px;
      padding: 14px 20px 14px 48px;
      color: var(--text);
      width: 100%; font-size: 0.92rem;
      transition: all 0.25s;
      font-weight: 500;
    }
    .cloud-search::placeholder { color: #94a3b8; font-weight: 500; }
    .cloud-search:focus {
      outline: none;
      border-color: var(--sky-4);
      box-shadow: 0 0 0 4px rgba(56, 189, 248, 0.15);
      background: #fff;
    }
    .search-wrap { position: relative; }
    .search-wrap .search-icon {
      position: absolute; left: 18px; top: 50%; transform: translateY(-50%);
      color: var(--sky-5); font-size: 1rem;
    }
    /* ======= MODAL ======= */
    .modal-content.cloud-modal {
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(186, 230, 253, 0.8);
      border-radius: 20px;
      box-shadow: 0 24px 60px rgba(14, 165, 233, 0.25);
    }
    .cloud-modal .modal-header {
      border-bottom: 1px solid var(--sky-2);
      padding: 20px 24px;
    }
    .cloud-modal .modal-title {
      font-weight: 800; font-size: 1.15rem;
      color: var(--text);
      display: flex; align-items: center; gap: 10px;
    }
    .cloud-modal .modal-title i { color: var(--sky-5); }
    .cloud-modal .modal-body { padding: 24px; }
    .cloud-modal .modal-footer {
      border-top: 1px solid var(--sky-2);
      padding: 16px 24px;
    }
    .cloud-modal .form-label {
      font-weight: 700; font-size: 0.8rem;
      color: var(--sky-7); letter-spacing: 0.5px;
      text-transform: uppercase; margin-bottom: 6px;
    }
    .cloud-modal .form-control,
    .cloud-modal .form-select {
      background: rgba(240, 249, 255, 0.6);
      border: 1.5px solid var(--sky-2);
      color: var(--text);
      border-radius: 10px;
      padding: 11px 14px;
      font-size: 0.92rem;
      font-weight: 500;
    }
    .cloud-modal .form-control:focus,
    .cloud-modal .form-select:focus {
      background: #fff;
      border-color: var(--sky-4);
      box-shadow: 0 0 0 4px rgba(56, 189, 248, 0.15);
      color: var(--text);
    }
    /* ======= PAGINATION ======= */
    .cloud-pagination { gap: 6px; }
    .cloud-pagination .page-link {
      background: rgba(255, 255, 255, 0.8);
      border: 1px solid var(--sky-2);
      color: var(--sky-7);
      border-radius: 10px;
      padding: 8px 14px;
      font-weight: 600;
      transition: all 0.2s;
    }
    .cloud-pagination .page-link:hover {
      background: var(--sky-1);
      border-color: var(--sky-4);
      color: var(--blue-7);
    }
    .cloud-pagination .active .page-link {
      background: linear-gradient(135deg, var(--sky-4), var(--blue-6));
      color: #fff; border-color: transparent;
      box-shadow: 0 6px 16px rgba(59, 130, 246, 0.35);
    }
    /* ======= COUNTDOWN ======= */
    .countdown { font-weight: 700; font-size: 0.88rem; letter-spacing: 0.2px; }
    .countdown.safe { color: #059669; }
    .countdown.warning { color: #d97706; }
    .countdown.danger { color: #dc2626; }
    /* ======= SCROLLBAR ======= */
    ::-webkit-scrollbar { width: 10px; height: 10px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb {
      background: linear-gradient(180deg, var(--sky-3), var(--sky-5));
      border-radius: 10px; border: 2px solid transparent; background-clip: padding-box;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: linear-gradient(180deg, var(--sky-4), var(--sky-6));
      background-clip: padding-box;
    }
    /* ======= ANIMATIONS ======= */
    @keyframes floatIn {
      from { opacity: 0; transform: translateY(16px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .anim-in { animation: floatIn 0.5s cubic-bezier(0.4, 0, 0.2, 1) both; }
    .anim-1 { animation-delay: 0.05s; }
    .anim-2 { animation-delay: 0.1s; }
    .anim-3 { animation-delay: 0.15s; }
    .anim-4 { animation-delay: 0.2s; }
    /* Responsive */
    @media (max-width: 768px) {
      .cloud-sidebar { width: 68px; }
      .cloud-sidebar span, .cloud-logo h5, .cloud-logo small { display: none; }
      .cloud-main { margin-left: 68px; padding: 20px; }
      .page-title { font-size: 1.4rem; }
      .page-subtitle { margin-left: 0; }
    }
  </style>
</head>
<body>
  <canvas id="skyCanvas"></canvas>
