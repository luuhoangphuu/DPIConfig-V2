      }
      .mobile-overlay.active { display: block; }
      
      /* Container */
      .vg-page-title {
        font-size: 2rem;
        padding-left: 60px;
      }
      .vg-page-sub {
        font-size: 1rem;
        padding-left: 60px;
      }
      .vg-page-head {
        flex-direction: column;
        gap: 12px;
      }
      .vg-page-head .vg-btn { width: 100%; justify-content: center; }
      
      /* Stats grid 1 cột trên mobile */
      .stat-grid, .grid {
        grid-template-columns: 1fr !important;
      }
      .vg-stat-value, .card .value { font-size: 2.4rem; }
      
      /* Cards */
      .vg-card { padding: 16px; border-radius: 16px; }
      .vg-stat { padding: 18px; }
      
      /* Table scroll ngang */
      .vg-table-wrap, .data-table {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
      }
      .vg-table, .data-table table {
