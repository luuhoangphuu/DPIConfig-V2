<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'DPIConfig Admin' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
  <style>
    :root { --sidebar-width: 260px; --primary: #667eea; --sidebar-bg: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
    body { font-family: 'Segoe UI', sans-serif; background: #f4f6f9; }
    .sidebar { background: var(--sidebar-bg); min-height: 100vh; width: var(--sidebar-width); position: fixed; left: 0; top: 0; box-shadow: 4px 0 20px rgba(0,0,0,0.15); z-index: 1000; }
    .sidebar .nav-link { color: rgba(255,255,255,0.85); padding: 12px 20px; margin: 4px 15px; border-radius: 10px; transition: all 0.3s; font-weight: 500; }
    .sidebar .nav-link:hover, .sidebar .nav-link.active { background: rgba(255,255,255,0.2); color: white; transform: translateX(5px); }
    .main-content { margin-left: var(--sidebar-width); padding: 30px; }
    .card-stats { border: none; border-radius: 20px; color: white; transition: transform 0.3s, box-shadow 0.3s; overflow: hidden; }
    .card-stats:hover { transform: translateY(-5px); box-shadow: 0 15px 30px rgba(0,0,0,0.2); }
    .card-stats .icon-bg { position: absolute; right: -20px; bottom: -20px; font-size: 6rem; opacity: 0.2; }
    .table-keys th { background: var(--primary); color: white; }
    .table-keys tbody tr:hover { background: rgba(102,126,234,0.05); }
    .btn-action:hover { transform: scale(1.08); }
    .modal-header { background: var(--sidebar-bg); color: white; border-radius: 15px 15px 0 0; }
    .modal-content { border-radius: 15px; border: none; }
  </style>
</head>
<body>
