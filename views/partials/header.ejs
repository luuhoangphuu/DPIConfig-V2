<!DOCTYPE html>
<html lang="vi" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'DPIConfig Admin' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://cdn.jsdelivr.net/npm/particles.js@2.0.0/particles.min.js"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap');
    * { font-family: 'Share Tech Mono', monospace; }
    :root {
      --hacker-green: #0f0;
      --hacker-dark-green: #0a0;
      --hacker-bg: #0a0a0a;
      --hacker-panel: rgba(0, 15, 0, 0.85);
      --hacker-border: rgba(0, 255, 0, 0.2);
      --hacker-text: #b3ffb3;
      --sidebar-width: 260px;
    }
    body {
      background: var(--hacker-bg);
      color: var(--hacker-text);
      overflow-x: hidden;
    }
    #particles-js {
      position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -2;
    }
    .matrix-overlay {
      position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1;
      background: repeating-linear-gradient(0deg, rgba(0,255,0,0.03) 0px, rgba(0,255,0,0.03) 1px, transparent 1px, transparent 2px);
      pointer-events: none;
    }
    .sidebar {
      background: rgba(0,0,0,0.9); border-right: 1px solid var(--hacker-border);
      width: var(--sidebar-width); min-height: 100vh; position: fixed; left: 0; top: 0; z-index: 1000;
      backdrop-filter: blur(5px);
    }
    .sidebar .nav-link {
      color: #0a0; font-size: 1rem; padding: 10px 20px; margin: 4px 12px; border-radius: 0;
      transition: all 0.2s; border-left: 2px solid transparent;
    }
    .sidebar .nav-link i { width: 20px; margin-right: 10px; }
    .sidebar .nav-link:hover, .sidebar .nav-link.active {
      background: rgba(0,255,0,0.05); color: #0f0; border-left-color: #0f0;
    }
    .main-content { margin-left: var(--sidebar-width); padding: 30px; }
    .stat-card {
      background: var(--hacker-panel); border: 1px solid var(--hacker-border);
      border-radius: 2px; padding: 20px; transition: all 0.3s;
      box-shadow: 0 0 8px rgba(0,255,0,0.1);
    }
    .stat-card:hover { box-shadow: 0 0 20px rgba(0,255,0,0.3); }
    .stat-icon { font-size: 2rem; color: #0f0; }
    .table-custom { border-collapse: separate; border-spacing: 0 4px; }
    .table-custom thead th {
      background: transparent; color: #0f0; font-weight: 400; border: none; padding: 8px 16px;
      text-transform: uppercase; letter-spacing: 1px;
    }
    .table-custom tbody tr {
      background: rgba(0,15,0,0.6); transition: 0.2s; border-left: 2px solid transparent;
    }
    .table-custom tbody tr:hover {
      background: rgba(0,255,0,0.05); border-left-color: #0f0; box-shadow: 0 0 10px rgba(0,255,0,0.2);
    }
    .table-custom td { padding: 12px 16px; border: none; vertical-align: middle; }
    .toggle-switch { position: relative; display: inline-block; width: 44px; height: 22px; }
    .toggle-switch input { opacity: 0; width: 0; height: 0; }
    .slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #222; transition: 0.3s; border-radius: 0; }
    .slider:before { position: absolute; content: ""; height: 16px; width: 16px; left: 3px; bottom: 3px; background-color: #0a0a0a; transition: 0.3s; border: 1px solid #0f0; }
    input:checked + .slider { background-color: #0f0; }
    input:checked + .slider:before { transform: translateX(22px); }
    .countdown.safe { color: #0f0; }
    .countdown.warning { color: #ff0; }
    .countdown.danger { color: #f00; }
    .modal-content {
      background: #050505; border: 1px solid var(--hacker-border); border-radius: 2px;
      box-shadow: 0 0 30px rgba(0,255,0,0.3);
    }
    .modal-header, .modal-footer { border-color: var(--hacker-border); }
    .form-control, .form-select {
      background: #0a0a0a; border: 1px solid var(--hacker-border); color: #0f0; border-radius: 0;
    }
    .form-control:focus, .form-select:focus {
      border-color: #0f0; box-shadow: 0 0 10px rgba(0,255,0,0.3); background: #0a0a0a; color: #0f0;
    }
    .btn-hacker {
      background: transparent; border: 1px solid #0f0; color: #0f0; border-radius: 0;
      text-transform: uppercase; letter-spacing: 1px; transition: all 0.2s;
    }
    .btn-hacker:hover { background: #0f0; color: #000; box-shadow: 0 0 15px #0f0; }
    .btn-hacker-danger { border-color: #f00; color: #f00; }
    .btn-hacker-danger:hover { background: #f00; color: #000; box-shadow: 0 0 15px #f00; }
    .badge-hacker { border-radius: 0; background: transparent; border: 1px solid #0f0; color: #0f0; }
    .pagination .page-link {
      background: transparent; border: 1px solid var(--hacker-border); color: #0a0; border-radius: 0;
    }
    .pagination .page-item.active .page-link { background: #0f0; border-color: #0f0; color: #000; }
    .cursor-blink { animation: blink 1s infinite; }
    @keyframes blink { 0%,100% { opacity: 1; } 50% { opacity: 0; } }
    .typing-text { border-right: 2px solid #0f0; white-space: nowrap; overflow: hidden; }
  </style>
</head>
<body>
  <div id="particles-js"></div>
  <div class="matrix-overlay"></div>
