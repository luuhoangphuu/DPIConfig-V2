<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'DPIConfig HoangPhu' %></title>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    :root {
      --sidebar-width: 260px;
      /* Starry Night palette */
      --prussian: #0a1e3f;
      --navy-1: #0f2847;
      --navy-2: #14305c;
      --navy-3: #1a4275;
      --cyan-1: #4fc3f7;
      --cyan-2: #29b6f6;
      --cyan-3: #81d4fa;
      --chrome-1: #ffd700;
      --chrome-2: #fbc02d;
      --chrome-3: #f5d020;
      --amber: #ffb300;
      --orange: #ff8f00;
      --cream: #fff8e1;
      --text: #e8f0ff;
      --text-muted: #8ba3c7;
      --border-paint: rgba(255, 215, 0, 0.35);
    }
    * { box-sizing: border-box; }
    body {
      font-family: 'Inter', sans-serif;
      background: #0a1e3f;
      color: var(--text);
      overflow-x: hidden;
      margin: 0;
      min-height: 100vh;
    }
    /* Canvas Starry Night */
    #starryCanvas {
      position: fixed; top: 0; left: 0;
      width: 100%; height: 100%;
      z-index: -2;
      display: block;
    }
    /* SVG filters (wobbly painterly edges) */
    .svg-filters { position: absolute; width: 0; height: 0; }
    .paint-edge { filter: url(#paint-edge); }
    .paint-rough { filter: url(#paint-rough); }

    /* ============ SIDEBAR ============ */
    .vg-sidebar {
      position: fixed;
      left: 0; top: 0;
      width: var(--sidebar-width);
      min-height: 100vh;
      background: linear-gradient(180deg,
        rgba(10, 30, 63, 0.92) 0%,
        rgba(15, 40, 71, 0.88) 50%,
        rgba(26, 66, 117, 0.85) 100%);
      backdrop-filter: blur(20px);
      border-right: 2px solid var(--border-paint);
      z-index: 100;
      display: flex;
      flex-direction: column;
      box-shadow:
        4px 0 30px rgba(0, 0, 0, 0.4),
        inset -1px 0 0 rgba(255, 215, 0, 0.1);
    }
    .vg-sidebar::before {
      content: '';
      position: absolute; top: 0; right: -2px;
      width: 2px; height: 100%;
      background: linear-gradient(180deg,
        transparent 0%,
        var(--chrome-1) 20%,
        var(--cyan-1) 50%,
        var(--chrome-1) 80%,
        transparent 100%);
      opacity: 0.4;
      animation: paintGlow 4s ease-in-out infinite;
    }
    @keyframes paintGlow {
      0%, 100% { opacity: 0.3; }
      50% { opacity: 0.7; }
    }
    .vg-logo {
      padding: 30px 22px 22px;
      text-align: center;
      border-bottom: 1px solid rgba(255, 215, 0, 0.15);
      position: relative;
    }
    .vg-logo::after {
      content: '';
      position: absolute;
      bottom: -1px; left: 15%; right: 15%;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--chrome-1), transparent);
    }
    .vg-star-logo {
      width: 68px; height: 68px;
      margin: 0 auto 14px;
      position: relative;
    }
    .vg-star-logo svg {
      width: 100%; height: 100%;
      filter: drop-shadow(0 0 20px rgba(255, 215, 0, 0.6));
    }
    .vg-star-logo .star-core {
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      width: 12px; height: 12px;
      background: radial-gradient(circle, #fff 0%, #ffd700 60%, transparent 100%);
      border-radius: 50%;
      animation: starPulse 2.5s ease-in-out infinite;
    }
    @keyframes starPulse {
      0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
      50% { transform: translate(-50%, -50%) scale(1.4); opacity: 0.7; }
    }
    .vg-logo h5 {
      font-family: 'Caveat', cursive;
      font-weight: 700;
      font-size: 1.75rem;
      color: var(--chrome-1);
      margin: 0;
      letter-spacing: 0.5px;
      text-shadow:
        0 0 20px rgba(255, 215, 0, 0.5),
        2px 2px 0 rgba(10, 30, 63, 0.8);
    }
    .vg-logo small {
      display: block;
      margin-top: 4px;
      color: var(--text-muted);
      font-size: 0.68rem;
      letter-spacing: 3px;
      text-transform: uppercase;
      font-weight: 600;
    }

    /* ============ NAV ============ */
    .vg-nav {
      padding: 18px 0;
      flex: 1;
      list-style: none;
      margin: 0;
    }
    .vg-nav li { margin: 4px 0; }
    .vg-nav .nav-link {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 22px;
      margin: 0 12px;
      color: var(--text-muted);
      text-decoration: none;
      border-radius: 12px;
      font-weight: 600;
      font-size: 0.92rem;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }
    .vg-nav .nav-link i {
      width: 22px;
      font-size: 1rem;
      transition: transform 0.3s;
      text-align: center;
    }
    .vg-nav .nav-link:hover {
      background: rgba(79, 195, 247, 0.1);
      color: var(--cyan-1);
      transform: translateX(4px);
    }
    .vg-nav .nav-link:hover i {
      transform: rotate(-8deg) scale(1.15);
    }
    .vg-nav .nav-link.active {
      background: linear-gradient(135deg,
        rgba(255, 215, 0, 0.15) 0%,
        rgba(79, 195, 247, 0.15) 100%);
      color: var(--chrome-1);
      box-shadow:
        0 0 24px rgba(255, 215, 0, 0.2),
        inset 0 0 0 1px rgba(255, 215, 0, 0.3);
    }
    .vg-nav .nav-link.active::before {
      content: '';
      position: absolute;
      left: 0; top: 20%; bottom: 20%;
      width: 3px;
      background: linear-gradient(180deg, var(--chrome-1), var(--cyan-1));
      border-radius: 3px;
      box-shadow: 0 0 12px var(--chrome-1);
    }
    .vg-nav .nav-link.active i {
      color: var(--chrome-1);
      filter: drop-shadow(0 0 8px rgba(255, 215, 0, 0.7));
    }

    /* ============ FOOTER ============ */
    .vg-footer {
      padding: 18px;
      border-top: 1px solid rgba(255, 215, 0, 0.12);
      text-align: center;
    }
    .vg-time-badge {
      display: inline-block;
      padding: 6px 14px;
      background: rgba(15, 40, 71, 0.6);
      border: 1px solid rgba(79, 195, 247, 0.3);
      border-radius: 20px;
      color: var(--cyan-2);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 1.5px;
      margin-bottom: 12px;
      font-family: 'Courier New', monospace;
    }
    .vg-user {
      font-size: 0.78rem;
      color: var(--text-muted);
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }
    .vg-user i { color: var(--chrome-2); }
    .vg-btn-logout {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      padding: 10px 16px;
      background: rgba(255, 215, 0, 0.08);
      border: 1px solid rgba(255, 215, 0, 0.35);
      color: var(--chrome-1);
      border-radius: 10px;
      font-weight: 600;
      font-size: 0.85rem;
      text-decoration: none;
      transition: all 0.3s;
    }
    .vg-btn-logout:hover {
      background: rgba(255, 215, 0, 0.18);
      border-color: var(--chrome-1);
      color: var(--chrome-1);
      box-shadow: 0 0 20px rgba(255, 215, 0, 0.35);
      transform: translateY(-1px);
    }
    .vg-copyright {
      color: var(--text-muted);
      font-size: 0.65rem;
      letter-spacing: 0.5px;
      margin-top: 12px;
      opacity: 0.6;
    }

    /* ============ MAIN ============ */
    .vg-main {
      margin-left: var(--sidebar-width);
      padding: 34px 38px;
      min-height: 100vh;
      position: relative;
    }
    .vg-page-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 20px;
      margin-bottom: 30px;
    }
    .vg-page-title {
      font-family: 'Caveat', cursive;
      font-weight: 700;
      font-size: 3rem;
      line-height: 1.1;
      color: var(--chrome-1);
      margin: 0 0 6px;
      text-shadow:
        0 0 30px rgba(255, 215, 0, 0.4),
        3px 3px 0 rgba(10, 30, 63, 0.9),
        -1px -1px 0 rgba(79, 195, 247, 0.3);
      letter-spacing: 1px;
      position: relative;
    }
    .vg-page-sub {
      font-family: 'Caveat', cursive;
      font-size: 1.25rem;
      color: var(--cyan-3);
      margin: 0;
      opacity: 0.85;
      font-weight: 500;
      letter-spacing: 0.3px;
    }

    /* ============ CARDS ============ */
    .vg-card {
      position: relative;
      background:
        linear-gradient(135deg,
          rgba(15, 40, 71, 0.85) 0%,
          rgba(26, 66, 117, 0.75) 100%);
      border: 1.5px solid var(--border-paint);
      border-radius: 16px;
      padding: 22px;
      backdrop-filter: blur(14px);
      box-shadow:
        0 8px 32px rgba(0, 0, 0, 0.35),
        inset 0 1px 0 rgba(255, 215, 0, 0.1);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      overflow: hidden;
    }
    .vg-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 2px;
      background: linear-gradient(90deg,
        transparent, var(--chrome-1), var(--cyan-1), transparent);
      opacity: 0.6;
    }
    .vg-card:hover {
      transform: translateY(-4px);
      box-shadow:
        0 16px 48px rgba(0, 0, 0, 0.5),
        0 0 40px rgba(255, 215, 0, 0.15),
        inset 0 1px 0 rgba(255, 215, 0, 0.2);
      border-color: rgba(255, 215, 0, 0.5);
    }

    /* Stat cards */
    .vg-stat { padding: 24px; position: relative; overflow: hidden; }
    .vg-stat::after {
      content: '';
      position: absolute;
      top: -40%; right: -20%;
      width: 180px; height: 180px;
      border-radius: 50%;
      background: radial-gradient(circle, currentColor 0%, transparent 70%);
      opacity: 0.08;
      pointer-events: none;
    }
    .vg-stat-icon {
      width: 54px; height: 54px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
      margin-bottom: 16px;
      position: relative;
      box-shadow:
        0 8px 20px rgba(0, 0, 0, 0.4),
        inset 0 1px 0 rgba(255, 255, 255, 0.2);
    }
    .vg-stat-icon::after {
      content: '';
      position: absolute;
      inset: -3px;
      border-radius: 17px;
      background: inherit;
      opacity: 0.4;
      filter: blur(10px);
      z-index: -1;
    }
    .vg-stat-icon.icon-total { background: linear-gradient(135deg, var(--cyan-1), var(--cyan-2)); color: #0a1e3f; }
    .vg-stat-icon.icon-active { background: linear-gradient(135deg, #66bb6a, #43a047); color: #0a1e3f; }
    .vg-stat-icon.icon-expired { background: linear-gradient(135deg, #ef5350, #c62828); color: #fff; }
    .vg-stat-icon.icon-devices { background: linear-gradient(135deg, var(--chrome-1), var(--orange)); color: #0a1e3f; }
    .vg-stat-label {
      color: var(--text-muted);
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 1.8px;
      font-weight: 700;
      margin-bottom: 8px;
    }
    .vg-stat-value {
      font-family: 'Caveat', cursive;
      font-size: 3rem;
      font-weight: 700;
      line-height: 1;
      letter-spacing: -1px;
    }
    .vg-stat.stat-total .vg-stat-value { color: var(--cyan-1); }
    .vg-stat.stat-active .vg-stat-value { color: #81c784; }
    .vg-stat.stat-expired .vg-stat-value { color: #ef5350; }
    .vg-stat.stat-devices .vg-stat-value { color: var(--chrome-1); }

    /* ============ SECTION TITLE ============ */
    .vg-section-title {
      font-family: 'Caveat', cursive;
      font-size: 1.9rem;
      font-weight: 700;
      color: var(--chrome-1);
      margin: 0;
      display: flex;
      align-items: center;
      gap: 12px;
      text-shadow: 0 0 20px rgba(255, 215, 0, 0.35);
    }
    .vg-section-title i {
      font-size: 1.4rem;
      color: var(--cyan-1);
      filter: drop-shadow(0 0 8px rgba(79, 195, 247, 0.6));
    }

    /* ============ TABLE ============ */
    .vg-table-wrap { overflow: hidden; border-radius: 16px; }
    .vg-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      margin: 0;
    }
    .vg-table thead th {
      text-align: left;
      padding: 14px 18px;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: var(--chrome-1);
      font-weight: 700;
      background: linear-gradient(180deg, rgba(255, 215, 0, 0.08), transparent);
      border-bottom: 2px solid rgba(255, 215, 0, 0.25);
    }
    .vg-table tbody tr {
      transition: all 0.3s;
      border-bottom: 1px solid rgba(79, 195, 247, 0.08);
    }
    .vg-table tbody tr:hover {
      background: rgba(79, 195, 247, 0.06);
      box-shadow: inset 3px 0 0 var(--chrome-1);
    }
    .vg-table tbody td {
      padding: 15px 18px;
      color: var(--text);
      font-size: 0.88rem;
      vertical-align: middle;
    }
    .vg-table code {
      background: rgba(10, 30, 63, 0.7);
      color: var(--cyan-1);
      padding: 4px 10px;
      border-radius: 6px;
      font-family: 'Courier New', monospace;
      font-size: 0.82rem;
      font-weight: 700;
      border: 1px solid rgba(79, 195, 247, 0.2);
    }

    /* ============ BADGES ============ */
    .vg-badge-vip {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 4px 12px;
      background: linear-gradient(135deg, var(--chrome-1), var(--orange));
      color: #0a1e3f;
      border-radius: 20px;
      font-weight: 800;
      font-size: 0.72rem;
      letter-spacing: 0.5px;
      box-shadow: 0 4px 12px rgba(255, 215, 0, 0.4);
    }
    .vg-badge-normal {
      display: inline-flex;
      align-items: center;
      padding: 4px 12px;
      background: rgba(139, 163, 199, 0.15);
      color: var(--text-muted);
      border-radius: 20px;
      font-weight: 700;
      font-size: 0.72rem;
      letter-spacing: 0.5px;
      border: 1px solid rgba(139, 163, 199, 0.3);
    }
    .vg-badge-action {
      display: inline-block;
      padding: 4px 12px;
      background: rgba(79, 195, 247, 0.12);
      color: var(--cyan-1);
      border-radius: 6px;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.5px;
      border: 1px solid rgba(79, 195, 247, 0.25);
    }

    /* ============ TOGGLE ============ */
    .vg-toggle { position: relative; display: inline-block; width: 44px; height: 24px; }
    .vg-toggle input { opacity: 0; width: 0; height: 0; }
    .vg-slider {
      position: absolute;
      cursor: pointer;
      inset: 0;
      background: rgba(139, 163, 199, 0.3);
      transition: 0.4s;
      border-radius: 24px;
      border: 1px solid rgba(139, 163, 199, 0.2);
    }
    .vg-slider::before {
      content: "";
      position: absolute;
      height: 18px; width: 18px;
      left: 3px; bottom: 2px;
      background: #fff;
      transition: 0.4s;
      border-radius: 50%;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
    }
    .vg-toggle input:checked + .vg-slider {
      background: linear-gradient(135deg, var(--chrome-1), var(--orange));
      border-color: transparent;
      box-shadow: 0 0 16px rgba(255, 215, 0, 0.5);
    }
    .vg-toggle input:checked + .vg-slider::before {
      transform: translateX(20px);
    }

    /* ============ BUTTONS ============ */
    .vg-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 11px 24px;
      background: linear-gradient(135deg, var(--chrome-1) 0%, var(--amber) 100%);
      color: #0a1e3f;
      border: none;
      border-radius: 12px;
      font-family: 'Inter', sans-serif;
      font-weight: 700;
      font-size: 0.88rem;
      letter-spacing: 0.3px;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow:
        0 8px 24px rgba(255, 215, 0, 0.35),
        inset 0 1px 0 rgba(255, 255, 255, 0.3);
      position: relative;
      overflow: hidden;
    }
    .vg-btn::before {
      content: '';
      position: absolute;
      top: 0; left: -100%;
      width: 100%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
      transition: left 0.6s;
    }
    .vg-btn:hover::before { left: 100%; }
    .vg-btn:hover {
      transform: translateY(-2px);
      box-shadow:
        0 14px 32px rgba(255, 215, 0, 0.55),
        inset 0 1px 0 rgba(255, 255, 255, 0.4);
      color: #0a1e3f;
    }
    .vg-btn-ghost {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 9px 18px;
      background: rgba(79, 195, 247, 0.08);
      color: var(--cyan-1);
      border: 1.5px solid rgba(79, 195, 247, 0.35);
      border-radius: 10px;
      font-weight: 600;
      font-size: 0.85rem;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.3s;
    }
    .vg-btn-ghost:hover {
      background: rgba(79, 195, 247, 0.18);
      border-color: var(--cyan-1);
      color: var(--cyan-1);
      box-shadow: 0 0 20px rgba(79, 195, 247, 0.3);
      transform: translateY(-1px);
    }
    .vg-btn-icon {
      width: 38px; height: 38px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: rgba(15, 40, 71, 0.7);
      border: 1px solid rgba(79, 195, 247, 0.25);
      color: var(--cyan-1);
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.3s;
      font-size: 0.9rem;
      padding: 0;
    }
    .vg-btn-icon:hover {
      background: linear-gradient(135deg, var(--cyan-1), var(--cyan-2));
      color: #0a1e3f;
      border-color: transparent;
      transform: translateY(-2px) scale(1.05);
      box-shadow: 0 8px 20px rgba(79, 195, 247, 0.5);
    }
    .vg-btn-icon.warn { color: var(--chrome-2); border-color: rgba(255, 215, 0, 0.3); }
    .vg-btn-icon.warn:hover {
      background: linear-gradient(135deg, var(--chrome-1), var(--orange));
      box-shadow: 0 8px 20px rgba(255, 215, 0, 0.5);
    }
    .vg-btn-icon.danger { color: #ef5350; border-color: rgba(239, 83, 80, 0.3); }
    .vg-btn-icon.danger:hover {
      background: linear-gradient(135deg, #ef5350, #c62828);
      color: #fff;
      box-shadow: 0 8px 20px rgba(239, 83, 80, 0.5);
    }

    /* ============ SEARCH ============ */
    .vg-search-wrap { position: relative; }
    .vg-search-wrap i {
      position: absolute;
      left: 18px; top: 50%;
      transform: translateY(-50%);
      color: var(--cyan-2);
      pointer-events: none;
      font-size: 0.95rem;
    }
    .vg-search {
      width: 100%;
      padding: 14px 20px 14px 46px;
      background: rgba(15, 40, 71, 0.7);
      border: 1.5px solid rgba(79, 195, 247, 0.25);
      border-radius: 12px;
      color: var(--text);
      font-size: 0.92rem;
      font-weight: 500;
      transition: all 0.3s;
      backdrop-filter: blur(10px);
    }
    .vg-search::placeholder { color: var(--text-muted); opacity: 0.7; }
    .vg-search:focus {
      outline: none;
      border-color: var(--chrome-1);
      background: rgba(15, 40, 71, 0.9);
      box-shadow:
        0 0 0 4px rgba(255, 215, 0, 0.1),
        0 0 24px rgba(255, 215, 0, 0.2);
    }

    /* ============ MODAL ============ */
    .vg-modal {
      background:
        linear-gradient(180deg,
          rgba(15, 40, 71, 0.98) 0%,
          rgba(10, 30, 63, 0.98) 100%);
      border: 1.5px solid var(--border-paint);
      border-radius: 20px;
      color: var(--text);
      box-shadow:
        0 24px 80px rgba(0, 0, 0, 0.6),
        inset 0 1px 0 rgba(255, 215, 0, 0.15);
    }
    .vg-modal .modal-header {
      border-bottom: 1px solid rgba(255, 215, 0, 0.2);
      padding: 20px 24px;
    }
    .vg-modal .modal-title {
      font-family: 'Caveat', cursive;
      font-weight: 700;
      font-size: 1.6rem;
      color: var(--chrome-1);
      display: flex;
      align-items: center;
      gap: 10px;
      text-shadow: 0 0 20px rgba(255, 215, 0, 0.35);
    }
    .vg-modal .modal-title i { color: var(--cyan-1); }
    .vg-modal .btn-close {
      filter: invert(1) brightness(2);
      opacity: 0.6;
    }
    .vg-modal .btn-close:hover { opacity: 1; }
    .vg-modal .modal-body { padding: 24px; }
    .vg-modal .modal-footer {
      border-top: 1px solid rgba(255, 215, 0, 0.15);
      padding: 18px 24px;
      gap: 10px;
    }
    .vg-modal .form-label {
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--cyan-1);
      letter-spacing: 1.2px;
      text-transform: uppercase;
      margin-bottom: 8px;
      display: block;
    }
    .vg-modal .form-control,
    .vg-modal .form-select {
      width: 100%;
      padding: 12px 16px;
      background: rgba(10, 30, 63, 0.7);
      border: 1.5px solid rgba(79, 195, 247, 0.25);
      border-radius: 10px;
      color: var(--text);
      font-size: 0.92rem;
      font-weight: 500;
      transition: all 0.3s;
    }
    .vg-modal .form-control:focus,
    .vg-modal .form-select:focus {
      outline: none;
      border-color: var(--chrome-1);
      background: rgba(10, 30, 63, 0.95);
      box-shadow: 0 0 0 4px rgba(255, 215, 0, 0.1);
      color: var(--text);
    }
    .vg-modal .form-select option {
      background: #0a1e3f;
      color: var(--text);
    }

    /* ============ PAGINATION ============ */
    .vg-pagination {
      display: flex;
      gap: 6px;
      list-style: none;
      padding: 0;
      justify-content: center;
      margin: 24px 0 0;
    }
    .vg-pagination a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 40px;
      height: 40px;
      padding: 0 12px;
      background: rgba(15, 40, 71, 0.7);
      border: 1.5px solid rgba(79, 195, 247, 0.25);
      border-radius: 10px;
      color: var(--cyan-1);
      font-weight: 700;
      font-size: 0.9rem;
      text-decoration: none;
      transition: all 0.25s;
    }
    .vg-pagination a:hover {
      background: rgba(79, 195, 247, 0.15);
      border-color: var(--cyan-1);
      transform: translateY(-2px);
    }
    .vg-pagination .active a {
      background: linear-gradient(135deg, var(--chrome-1), var(--amber));
      color: #0a1e3f;
      border-color: transparent;
      box-shadow: 0 8px 20px rgba(255, 215, 0, 0.4);
    }

    /* ============ COUNTDOWN ============ */
    .countdown { font-weight: 700; font-size: 0.86rem; font-family: 'Inter', sans-serif; }
    .countdown.safe { color: #81c784; }
    .countdown.warning { color: var(--chrome-1); }
    .countdown.danger { color: #ef5350; }

    /* ============ EMPTY STATE ============ */
    .vg-empty {
      text-align: center;
      padding: 60px 20px;
      color: var(--text-muted);
    }
    .vg-empty i {
      font-size: 3rem;
      color: var(--cyan-2);
      opacity: 0.4;
      margin-bottom: 16px;
      display: block;
      filter: drop-shadow(0 0 12px rgba(79, 195, 247, 0.5));
    }
    .vg-empty p {
      font-family: 'Caveat', cursive;
      font-size: 1.3rem;
      margin: 0;
      opacity: 0.8;
    }

    /* ============ SCROLLBAR ============ */
    ::-webkit-scrollbar { width: 10px; }
    ::-webkit-scrollbar-track { background: rgba(10, 30, 63, 0.5); }
    ::-webkit-scrollbar-thumb {
      background: linear-gradient(180deg, var(--cyan-1), var(--chrome-1));
      border-radius: 10px;
      border: 2px solid rgba(10, 30, 63, 0.5);
    }
    ::-webkit-scrollbar-thumb:hover {
      background: linear-gradient(180deg, var(--chrome-1), var(--cyan-1));
    }

    /* ============ ANIMATIONS ============ */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .anim { animation: fadeUp 0.6s cubic-bezier(0.4, 0, 0.2, 1) both; }
    .d1 { animation-delay: 0.06s; }
    .d2 { animation-delay: 0.12s; }
    .d3 { animation-delay: 0.18s; }
    .d4 { animation-delay: 0.24s; }

    /* ============ RESPONSIVE ============ */
    @media (max-width: 768px) {
      .vg-sidebar { width: 70px; }
      .vg-sidebar span,
      .vg-logo h5,
      .vg-logo small,
      .vg-user span,
      .vg-copyright { display: none; }
      .vg-main { margin-left: 70px; padding: 20px; }
      .vg-page-title { font-size: 2rem; }
      .vg-stat-value { font-size: 2.2rem; }
    }
  </style>
</head>
<body>
  <!-- SVG Filters for painterly effect -->
  <svg class="svg-filters">
    <defs>
      <filter id="paint-edge">
        <feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="3" seed="2"/>
        <feDisplacementMap in="SourceGraphic" scale="3"/>
      </filter>
      <filter id="paint-rough">
        <feTurbulence type="fractalNoise" baseFrequency="0.02" numOctaves="4" seed="5"/>
        <feDisplacementMap in="SourceGraphic" scale="5"/>
      </filter>
    </defs>
  </svg>
  <canvas id="starryCanvas"></canvas>
