<!DOCTYPE html>
<html lang="vi" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'DPIConfig Admin' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://cdn.jsdelivr.net/npm/particles.js@2.0.0/particles.min.js"></script>
  <style>
    :root {
      --glass-bg: rgba(20, 25, 40, 0.7);
      --glass-border: rgba(255,255,255,0.1);
      --neon-primary: #00f2fe;
      --neon-secondary: #4facfe;
      --neon-accent: #f093fb;
      --sidebar-width: 260px;
      --text-color: #fff;
      --card-bg: rgba(255,255,255,0.05);
    }
    body {
      font-family: 'Segoe UI', sans-serif;
      background: #0b0c10;
      color: var(--text-color);
      overflow-x: hidden;
      margin: 0;
    }
    #particles-js {
      position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -2;
    }
    .bg-animated {
      position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1;
      background: radial-gradient(circle at 30% 30%, rgba(0,242,254,0.15), transparent 50%),
                  radial-gradient(circle at 70% 70%, rgba(240,147,251,0.15), transparent 50%);
      animation: pulseGlow 8s ease-in-out infinite alternate;
    }
    @keyframes pulseGlow {
      0% { opacity: 0.5; }
      100% { opacity: 1; }
    }
    /* Sidebar glass */
    .sidebar {
      background: var(--glass-bg);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-right: 1px solid var(--glass-border);
      min-height: 100vh; width: var(--sidebar-width);
      position: fixed; left: 0; top: 0; z-index: 1000;
      box-shadow: 0 0 30px rgba(0,242,254,0.2);
    }
    .sidebar .nav-link {
      color: rgba(255,255,255,0.7); transition: all 0.3s;
      border-radius: 12px; margin: 4px 15px; padding: 12px 20px;
    }
    .sidebar .nav-link:hover, .sidebar .nav-link.active {
      background: rgba(255,255,255,0.1); color: white;
      box-shadow: 0 0 15px rgba(0,242,254,0.3);
      transform: translateX(5px);
    }
    .main-content { margin-left: var(--sidebar-width); padding: 30px; }
    /* Card stats neon */
    .card-stats {
      background: var(--card-bg); backdrop-filter: blur(15px);
      border: 1px solid var(--glass-border); border-radius: 20px;
      transition: all 0.3s ease; color: white; overflow: hidden;
    }
    .card-stats:hover {
      transform: translateY(-5px); box-shadow: 0 0 25px var(--neon-primary);
    }
    .card-stats .icon-bg { position: absolute; right: -10px; bottom: -10px; font-size: 5rem; opacity: 0.1; }
    /* Table */
    .table-keys { background: transparent; color: white; }
    .table-keys th { background: rgba(0,242,254,0.2); border-bottom: 2px solid var(--neon-primary); }
    .table-keys tbody tr:hover { background: rgba(255,255,255,0.05); }
    .badge-tier { border-radius: 20px; padding: 6px 12px; }
    /* Toggle switch neon */
    .toggle-switch { display: inline-block; width: 48px; height: 24px; position: relative; }
    .toggle-switch input { opacity: 0; width: 0; height: 0; }
    .slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #555; transition: 0.4s; border-radius: 34px; }
    .slider:before { position: absolute; content: ""; height: 18px; width: 18px; left: 3px; bottom: 3px; background-color: white; transition: 0.4s; border-radius: 50%; }
    input:checked + .slider { background-color: #00f2fe; box-shadow: 0 0 10px #00f2fe; }
    input:checked + .slider:before { transform: translateX(24px); }
    /* Countdown */
    .countdown { font-weight: 600; }
    .countdown.warning { color: #f39c12; }
    .countdown.danger { color: #e74c3c; }
    .countdown.safe { color: #2ecc71; }
    /* Modal glass */
    .modal-content { background: rgba(20,25,40,0.9); backdrop-filter: blur(20px); border: 1px solid var(--glass-border); color: white; }
    .modal-header { border-bottom: 1px solid var(--glass-border); }
    .modal-footer { border-top: 1px solid var(--glass-border); }
    .form-control, .form-select { background: rgba(255,255,255,0.1); border: 1px solid var(--glass-border); color: white; }
    .form-control:focus, .form-select:focus { background: rgba(255,255,255,0.2); color: white; box-shadow: 0 0 10px var(--neon-primary); }
    .btn-primary { background: linear-gradient(135deg, #00f2fe, #4facfe); border: none; }
    .btn-primary:hover { box-shadow: 0 0 15px #00f2fe; }
  </style>
</head>
<body>
  <div id="particles-js"></div>
  <div class="bg-animated"></div>
