<%
  const isSuper = user && (user.role === 'super' || user.is_super === true);
   const isSeller = user && (user.type === 'seller' || !user.role);
   const basePath = isSeller ? '/seller' : '/yncuti';
  const currentPath = typeof currentPage !== 'undefined' ? currentPage : '';
  const initial = user && user.email ? user.email.charAt(0).toUpperCase() : '?';
  const activeCount = (typeof activeKeys !== 'undefined') ? activeKeys : null;
  const isManageActive = ['admins', 'sellers', 'versions', 'announcements'].includes(currentPath);
%>
<nav class="vg-sidebar">
  <div class="vg-logo">
    <div class="vg-star-logo">
      <svg viewBox="0 0 100 100" fill="none">
        <circle cx="50" cy="50" r="9" fill="#ffd700" stroke="#050d1f" stroke-width="1.5"/>
        <g stroke="#4fc3f7" stroke-width="2.5" stroke-linecap="round" fill="none" opacity="0.9">
          <path d="M 50 22 Q 68 40 50 56 Q 32 72 50 88"/>
          <path d="M 88 50 Q 68 32 50 50 Q 32 68 12 50"/>
        </g>
      </svg>
      <div class="star-core"></div>
    </div>
    <h5>DPIConfig</h5>
    <small>HoangPhu</small>
  </div>

  <ul class="vg-nav">
    <li class="sn-section-label">Chính</li>
    <li>
      <a href="${basePath}/dashboard" class="nav-link <%= currentPath == 'dashboard' ? 'active' : '' %>">
        <i class="fas fa-chart-pie"></i> <span>Bảng điều khiển</span>
      </a>
    </li>
    <li>
      <a href="${basePath}/keys" class="nav-link <%= currentPath == 'keys' ? 'active' : '' %>">
        <i class="fas fa-key"></i> <span>Quản lý Key</span>
        <% if (activeCount !== null && activeCount > 0) { %>
          <span class="sn-badge"><%= activeCount %></span>
        <% } %>
      </a>
    </li>

    <% if (isSuper) { %>
      <!-- MENU DROPDOWN (HOVER) -->
      <li class="sn-dropdown-wrapper">
        <div class="nav-link sn-dropdown-toggle <%= isManageActive ? 'active' : '' %>">
          <i class="fas fa-ellipsis-h"></i> 
          <span>Quản lý khác</span>
          <i class="fas fa-chevron-right sn-chevron"></i>
        </div>
        <ul class="sn-dropdown-menu">
          <li>
            <a href="${basePath}/admins" class="nav-link <%= currentPath == 'admins' ? 'active' : '' %>">
              <i class="fas fa-user-shield"></i> Quản trị viên
            </a>
          </li>
          <li>
            <a href="${basePath}/sellers" class="nav-link <%= currentPath == 'sellers' ? 'active' : '' %>">
              <i class="fas fa-store"></i> Người bán
            </a>
          </li>
          <li>
            <a href="${basePath}/versions" class="nav-link <%= currentPath == 'versions' ? 'active' : '' %>">
              <i class="fas fa-cloud-download-alt"></i> Phiên bản App
            </a>
          </li>
          <li>
            <a href="${basePath}/announcements" class="nav-link <%= currentPath == 'announcements' ? 'active' : '' %>">
              <i class="fas fa-bullhorn"></i> Thông báo
            </a>
          </li>
        </ul>
      </li>
    <% } %>

    <li class="sn-section-label">Tài khoản</li>
    <li>
      <a href="${basePath}/profile" class="nav-link <%= currentPath == 'profile' ? 'active' : '' %>">
        <i class="fas fa-user-cog"></i> <span>Tài khoản</span>
      </a>
    </li>
  </ul>

  <div class="vg-footer">
    <div class="vg-time-badge" id="vgTime">--:--:--</div>
    <div class="sn-user-box">
      <div class="sn-avatar <%= isSuper ? 'super' : '' %>"><%= initial %></div>
      <div class="sn-user-info">
        <div class="sn-user-name"><%= user.name || user.email.split('@')[0] %></div>
        <div class="sn-user-role">
          <% if (isSuper) { %><i class="fas fa-crown"></i> Super Admin<% } else { %>Admin<% } %>
        </div>
      </div>
    </div>
    <a href="${basePath}/logout" class="vg-btn-logout">
      <i class="fas fa-sign-out-alt"></i> <span>Đăng xuất</span>
    </a>
    <div class="vg-copyright">© 2025 HoangPhu · Duy</div>
  </div>
</nav>
