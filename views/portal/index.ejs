<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tra cứu Key - DPIConfig HoangPhu</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    * { font-family: 'Inter', sans-serif; }
    body { background: #F9FAFB; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
    .container { max-width: 500px; }
    .card { border: none; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
    .btn-primary { background: #4F46E5; border: none; border-radius: 8px; }
    .btn-primary:hover { background: #4338CA; }
    .result-item { margin-bottom: 8px; }
    .badge-active { background: #10B981; }
    .badge-expired { background: #EF4444; }
    .badge-vip { background: #F59E0B; color: #000; }
    .badge-normal { background: #6B7280; }
  </style>
</head>
<body>
  <div class="container animate__animated animate__fadeInUp">
    <div class="text-center mb-4">
      <i class="fas fa-shield-alt text-primary fa-3x"></i>
      <h4 class="fw-bold mt-2">DPIConfig HoangPhu</h4>
      <p class="text-muted">Tra cứu thông tin key của bạn</p>
    </div>
    <div class="card p-4">
      <form method="POST" action="/portal/lookup">
        <div class="input-group mb-3">
          <span class="input-group-text bg-white"><i class="fas fa-mobile-alt text-muted"></i></span>
          <input type="text" name="hwid" class="form-control" placeholder="Nhập mã thiết bị (HWID)" required>
          <button type="submit" class="btn btn-primary">Tra cứu</button>
        </div>
      </form>

      <% if (error) { %>
        <div class="alert alert-danger mt-3"><%= error %></div>
      <% } %>

      <% if (result) { %>
        <div class="mt-3 p-3 bg-light rounded">
          <div class="result-item"><strong>Key:</strong> <code><%= result.key %></code></div>
          <div class="result-item"><strong>Hạng:</strong> 
            <span class="badge <%= result.tier === 'VIP' ? 'badge-vip' : 'badge-normal' %>"><%= result.tier %></span>
          </div>
          <div class="result-item"><strong>Ngày hết hạn:</strong> <%= new Date(result.expires_at).toLocaleDateString('vi-VN') %></div>
          <div class="result-item"><strong>Còn lại:</strong> 
            <span class="<%= result.remaining_days > 0 ? 'text-success' : 'text-danger' %> fw-bold">
              <%= result.remaining_days > 0 ? result.remaining_days + ' ngày' : 'Hết hạn' %>
            </span>
          </div>
          <div class="result-item"><strong>Số thiết bị:</strong> <%= result.active_devices %> / <%= result.max_devices %> (đang active)</div>
          <div class="result-item"><strong>Trạng thái key:</strong> 
            <span class="badge <%= result.is_active ? 'badge-active' : 'badge-expired' %>">
              <%= result.is_active ? 'Hoạt động' : 'Đã khóa' %>
            </span>
          </div>
        </div>
      <% } %>
    </div>
    <div class="text-center text-muted mt-3 small">
      © 2025 <strong>HoangPhu - Duy</strong>. Mọi quyền được bảo lưu.
    </div>
  </div>
</body>
</html>
