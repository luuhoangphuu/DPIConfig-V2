<%- include('../partials/header', { title: 'Tài liệu API', pageName: 'API Docs', user }) %>
<div class="d-flex">
  <%- include('../partials/sidebar', { user, currentPage: 'api', activeKeys }) %>
  <div class="vg-main flex-grow-1">
    <div class="sn-hero anim d1">
      <div>
        <h1 class="sn-hero-greet">💻 Tài liệu Tích hợp API</h1>
        <p class="sn-hero-sub">Hướng dẫn code cho Seller/Đối tác</p>
      </div>
    </div>
    
    <div class="vg-card anim d2" style="padding: 30px; line-height: 1.8;">
      <h3 style="color:#ffd700; font-family:'Caveat'; font-size: 2rem;">1. API Tạo Key Tự Động</h3>
      <p style="color:#b8c5d9">Gửi request POST để nhận Key. Dùng Token của Seller để tự động trừ Quota.</p>
      
      <pre style="background:#050d1f; padding:20px; border-radius:12px; border:1px solid #4fc3f7; overflow-x:auto;">
<code style="color:#81c784;">POST</code> <span style="color:#fff">https://dpi-config.vercel.app/api/gen-key</span>

<span style="color:#4fc3f7">Headers:</span>
{
  "Content-Type": "application/json"
}

<span style="color:#4fc3f7">Body:</span>
{
  "token": "sk_abc123...",  <span style="color:#6b7a94">// Token lấy từ trang Người Bán</span>
  "tier": "Normal",         <span style="color:#6b7a94">// Hoặc "VIP"</span>
  "prefix": "HoangPhu"      <span style="color:#6b7a94">// Tiền tố key (không bắt buộc)</span>
}

<span style="color:#4fc3f7">Response Thành công:</span>
{
  "success": true,
  "key": "HoangPhu-A1B2-C3D4-E5F6",
  "expires_at": "2026-10-18T...",
  "duration_hours": 8
}
</code></pre>
    </div>
  </div>
</div>
