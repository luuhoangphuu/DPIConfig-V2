<%- include('../partials/header', { title: 'Quản lý Key' }) %>
<div class="d-flex">
  <%- include('../partials/sidebar', { user, currentPage: 'keys' }) %>
  <div class="main-content flex-grow-1">
    <div class="d-flex justify-content-between align-items-center mb-4 animate__animated animate__fadeInDown">
      <h4 class="fw-bold mb-0">Danh sách Key</h4>
      <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createKeyModal"><i class="fas fa-plus me-1"></i> Tạo Key Mới</button>
    </div>
    <div class="mb-3 animate__animated animate__fadeInUp"><input type="text" name="search" class="search-input" placeholder="Tìm key..." value="<%= search %>"></div>
    <div class="table-responsive animate__animated animate__fadeInUp">
      <table class="table-custom w-100">
        <thead><tr><th>Key</th><th>Hạng</th><th>TB</th><th>Hết hạn</th><th>Còn</th><th></th><th></th></tr></thead>
        <tbody>
          <% keys.forEach(k => { const devs = k.devices || []; const active = devs.filter(d => d.is_active).length; %>
            <tr>
              <td><code style="font-size:0.9rem;"><%= k.key %></code></td>
              <td><span class="badge-tier <%= k.tier==='VIP' ? 'badge-vip' : 'badge-normal' %>"><%= k.tier %></span></td>
              <td><%= active %>/<%= k.max_devices %></td>
              <td><%= new Date(k.expires_at).toLocaleString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh' }) %></td>
              <td><span class="countdown" data-expiry="<%= k.expires_at.toISOString() %>">--</span></td>
              <td>
                <form method="POST" action="/admin/keys/toggle/<%= k.id %>"><label class="toggle-switch"><input type="checkbox" <%= k.is_active?'checked':'' %> onchange="this.form.submit()"><span class="slider"></span></label></form>
              </td>
              <td>
                <div class="d-flex gap-1">
                  <button class="btn btn-outline btn-sm view-devices-btn" data-key-id="<%= k.id %>" title="Thiết bị"><i class="fas fa-list"></i></button>
                  <!-- Sửa data-bs-target để trỏ đúng modal extend -->
                  <button class="btn btn-outline btn-sm" data-bs-toggle="modal" data-bs-target="#extendModal<%= k.id %>" title="Gia hạn"><i class="fas fa-calendar-plus"></i></button>
                  <form method="POST" action="/admin/keys/kick-all/<%= k.id %>" onsubmit="return confirm('Bạn có chắc muốn KHÓA TẤT CẢ thiết bị của key này?')"><button class="btn btn-outline btn-sm text-warning" title="Khóa tất cả"><i class="fas fa-ban"></i></button></form>
                  <form method="POST" action="/admin/keys/delete-all-devices/<%= k.id %>" onsubmit="return confirm('XÁC NHẬN: Xóa vĩnh viễn tất cả thiết bị của key này?')"><button class="btn btn-outline btn-sm text-danger" title="Xóa tất cả"><i class="fas fa-trash-alt"></i></button></form>
                  <form method="POST" action="/admin/keys/delete/<%= k.id %>" onsubmit="return confirm('XÁC NHẬN: Xóa key này và tất cả thiết bị? Hành động này không thể hoàn tác.')"><button class="btn btn-outline btn-sm text-danger" title="Xóa key"><i class="fas fa-times"></i></button></form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <nav class="mt-3"><ul class="pagination"><% for(let i=1; i<=totalPages; i++) { %><li class="page-item <%= i===currentPage?'active':'' %>"><a class="page-link" href="?page=<%= i %>&search=<%= search %>"><%= i %></a></li><% } %></ul></nav>
  </div>
</div>

<!-- Modal devices -->
<div class="modal fade" id="devicesModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Thiết bị của key</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
      </div>
      <div class="modal-body" id="devicesModalBody">
        <p class="text-center text-muted">Đang tải...</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal tạo key -->
<div class="modal fade" id="createKeyModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Tạo Key Mới</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
      </div>
      <form method="POST" action="/admin/keys/create">
        <div class="modal-body">
          <div class="mb-3"><label class="form-label">Tiền tố</label><input name="prefix" class="form-control" value="HoangPhu"></div>
          <div class="mb-3"><label class="form-label">Hạng</label><select name="tier" class="form-select" id="tierSelect"><option value="VIP">VIP</option><option value="Normal">Normal</option></select></div>
          <div class="mb-3"><label class="form-label">Số TB tối đa</label><input name="max_devices" type="number" class="form-control" value="1" id="maxDevicesInput"></div>
          <div class="mb-3"><label class="form-label">Thời hạn</label><select name="duration" class="form-select"><option value="1">1 ngày</option><option value="7">7 ngày</option><option value="15">15 ngày</option><option value="30">30 ngày</option><option value="90">90 ngày</option><option value="365">1 năm</option><option value="forever">Vĩnh viễn</option></select></div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
          <button type="submit" class="btn btn-primary">Tạo Key</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Render modal gia hạn cho từng key (đặt ngoài vòng lặp để tránh lỗi) -->
<% keys.forEach(k => { %>
<div class="modal fade" id="extendModal<%= k.id %>" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-sm modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h6 class="modal-title">Gia hạn key <%= k.key %></h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
      </div>
      <form method="POST" action="/admin/keys/extend/<%= k.id %>">
        <div class="modal-body">
          <label class="form-label">Ngày hết hạn mới</label>
          <input type="date" name="new_expiry" class="form-control" required>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
          <button type="submit" class="btn btn-primary">Gia hạn</button>
        </div>
      </form>
    </div>
  </div>
</div>
<% }) %>

<%- include('../partials/scripts') %>
<script>
  document.getElementById('tierSelect').addEventListener('change', function(){ document.getElementById('maxDevicesInput').value = this.value==='VIP'?1:9; });

  // Xử lý modal devices
  document.querySelectorAll('.view-devices-btn').forEach(btn => {
    btn.addEventListener('click', async function(){
      const keyId = this.dataset.keyId;
      const body = document.getElementById('devicesModalBody');
      body.innerHTML = '<p class="text-center text-muted">Đang tải...</p>';
      const modal = new bootstrap.Modal(document.getElementById('devicesModal'));
      modal.show();
      try {
        const res = await fetch(`/admin/keys/devices/${keyId}`);
        const data = await res.json();
        if(data.success && data.devices.length){
          let html = '<table class="table-custom w-100"><thead><tr><th>HWID</th><th>Tên</th><th>Trạng thái</th><th></th></tr></thead><tbody>';
          data.devices.forEach(d => {
            html += `<tr><td><code>${d.hwid}</code></td><td>${d.device_name||''}</td><td><span class="badge ${d.is_active?'bg-success':'bg-danger'}">${d.is_active?'Active':'Bị khóa'}</span></td>
            <td>
              <form method="POST" action="/admin/keys/toggle-device/${d.id}" class="d-inline" onsubmit="return confirm('Xác nhận thay đổi trạng thái thiết bị?')"><button class="btn btn-outline btn-sm">${d.is_active?'Khóa':'Mở'}</button></form>
              <form method="POST" action="/admin/keys/unbind-device/${d.id}" class="d-inline" onsubmit="return confirm('Xóa vĩnh viễn thiết bị này?')"><button class="btn btn-outline btn-sm text-danger">Xóa</button></form>
            </td></tr>`;
          });
          body.innerHTML = html + '</tbody></table>';
        } else body.innerHTML = '<p class="text-muted">Chưa có thiết bị.</p>';
      } catch(e){ body.innerHTML = '<p class="text-danger">Lỗi tải.</p>'; }
    });
  });
</script>
