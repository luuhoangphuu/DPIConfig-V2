<%- include('../partials/header', { title: 'Quản lý Key' }) %>
<div class="d-flex">
  <%- include('../partials/sidebar', { user, currentPage: 'keys' }) %>
  <div class="main-content flex-grow-1">
    <div class="d-flex justify-content-between align-items-center mb-4 animate__animated animate__fadeInDown">
      <h4 class="fw-bold mb-0" style="font-family:'Orbitron'; color: var(--neon-blue);">
        <i class="fas fa-database me-2"></i>KEY DATABASE
      </h4>
      <button class="btn btn-neon px-4" data-bs-toggle="modal" data-bs-target="#createKeyModal">
        <i class="fas fa-plus me-2"></i> GENERATE KEY
      </button>
    </div>
    <form class="mb-4 animate__animated animate__fadeInUp">
      <div class="input-group">
        <span class="input-group-text bg-transparent border-0 text-muted"><i class="fas fa-search"></i></span>
        <input type="text" name="search" class="form-control bg-transparent border-0 shadow-none text-white" placeholder="Search keys..." value="<%= search %>">
        <button class="btn btn-outline-light" type="submit">Search</button>
      </div>
    </form>
    <div class="glass-card p-0 animate__animated animate__fadeInUp">
      <div class="table-responsive">
        <table class="table-glass w-100">
          <thead><tr><th>KEY</th><th>TIER</th><th>MAX</th><th>USED</th><th>EXPIRY</th><th>REMAIN</th><th>STATUS</th><th>CTRL</th></tr></thead>
          <tbody>
            <% keys.forEach(k => {
                 const devs = k.devices || [];
                 const active = devs.filter(d => d.is_active).length;
            %>
              <tr>
                <td><code class="text-neon"><%= k.key %></code></td>
                <td><span class="badge bg-<%= k.tier==='VIP'?'warning':'secondary' %>"><%= k.tier %></span></td>
                <td><%= k.max_devices %></td>
                <td><%= active %>/<%= k.max_devices %></td>
                <td><%= new Date(k.expires_at).toLocaleDateString('vi-VN') %></td>
                <td><span class="countdown" data-expiry="<%= k.expires_at.toISOString() %>">--</span></td>
                <td>
                  <form method="POST" action="/admin/keys/toggle/<%= k.id %>">
                    <label class="toggle-switch">
                      <input type="checkbox" <%= k.is_active?'checked':'' %> onchange="this.form.submit()">
                      <span class="slider"></span>
                    </label>
                  </form>
                </td>
                <td>
                  <div class="d-flex gap-1">
                    <button class="btn btn-sm btn-outline-info view-devices-btn" data-key-id="<%= k.id %>" title="Devices"><i class="fas fa-list"></i></button>
                    <button class="btn btn-sm btn-outline-info" data-bs-toggle="modal" data-bs-target="#extend<%= k.id %>" title="Extend"><i class="fas fa-calendar-plus"></i></button>
                    <form method="POST" action="/admin/keys/kick-all/<%= k.id %>"><button class="btn btn-sm btn-outline-warning" title="Kick All"><i class="fas fa-ban"></i></button></form>
                    <form method="POST" action="/admin/keys/delete-all-devices/<%= k.id %>"><button class="btn btn-sm btn-outline-danger" title="Delete All"><i class="fas fa-trash-alt"></i></button></form>
                    <form method="POST" action="/admin/keys/delete/<%= k.id %>"><button class="btn btn-sm btn-outline-danger" title="Delete Key"><i class="fas fa-times"></i></button></form>
                  </div>
                  <div class="modal fade" id="extend<%= k.id %>"><div class="modal-dialog modal-sm"><form method="POST" action="/admin/keys/extend/<%= k.id %>" class="modal-content bg-dark text-white"><div class="modal-header"><h6>Extend Key</h6></div><div class="modal-body"><input type="date" name="new_expiry" class="form-control" required></div><div class="modal-footer"><button class="btn btn-neon">Apply</button></div></form></div></div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <nav class="mt-4"><ul class="pagination justify-content-center"><% for(let i=1; i<=totalPages; i++) { %><li class="page-item <%= i===currentPage?'active':'' %>"><a class="page-link bg-transparent border-0 text-white" href="?page=<%= i %>&search=<%= search %>"><%= i %></a></li><% } %></ul></nav>
  </div>
</div>
<!-- Modals giữ nguyên cấu trúc, thêm class dark -->
<%- include('../partials/scripts') %>
<script>
  document.querySelectorAll('.view-devices-btn').forEach(btn => {
    btn.addEventListener('click', async function(){
      const keyId = this.dataset.keyId;
      const body = document.getElementById('devicesModalBody');
      body.innerHTML = '<p class="text-center">Loading...</p>';
      new bootstrap.Modal(document.getElementById('devicesModal')).show();
      try {
        const res = await fetch(`/admin/keys/devices/${keyId}`);
        const data = await res.json();
        if(data.success && data.devices.length){
          let html = '<table class="table table-sm table-dark"><thead><tr><th>HWID</th><th>Name</th><th>Status</th><th>Added</th><th></th></tr></thead><tbody>';
          data.devices.forEach(d => {
            html += `<tr><td><code>${d.hwid}</code></td><td>${d.device_name||'N/A'}</td><td><span class="badge bg-${d.is_active?'success':'danger'}">${d.is_active?'Active':'Kicked'}</span></td><td>${new Date(d.createdAt).toLocaleString()}</td>
            <td><form method="POST" action="/admin/keys/toggle-device/${d.id}" class="d-inline"><button class="btn btn-sm btn-outline-${d.is_active?'warning':'success'}">${d.is_active?'Kick':'Unkick'}</button></form>
            <form method="POST" action="/admin/keys/unbind-device/${d.id}" class="d-inline"><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr>`;
          });
          body.innerHTML = html + '</tbody></table>';
        } else body.innerHTML = '<p class="text-center">No devices.</p>';
      } catch(e){ body.innerHTML = '<p class="text-danger">Error loading.</p>'; }
    });
  });
</script>
