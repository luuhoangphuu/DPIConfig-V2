<%- include('../partials/header', { title: 'Quản lý Key' }) %>
<div class="d-flex">
  <%- include('../partials/sidebar', { user, currentPage: 'keys' }) %>
  <div class="main-content flex-grow-1">
    <div class="d-flex justify-content-between align-items-center mb-4 animate__animated animate__fadeInDown">
      <h4 class="fw-bold mb-0" style="color:#0f0;"><i class="fas fa-key me-2"></i>key_database</h4>
      <button class="btn-hacker px-3 py-2" data-bs-toggle="modal" data-bs-target="#createKeyModal">
        <i class="fas fa-plus-circle me-1"></i> GENERATE_KEY
      </button>
    </div>

    <form class="mb-4"><div class="input-group">
      <span class="input-group-text bg-transparent border-0 text-success"><i class="fas fa-search"></i></span>
      <input type="text" name="search" class="form-control bg-transparent border-0 shadow-none text-success" placeholder="Search key, HWID..." value="<%= search %>">
      <button class="btn-hacker" type="submit">SEARCH</button>
    </div></form>

    <div class="table-responsive">
      <table class="table-custom w-100">
        <thead><tr><th>KEY</th><th>DEVICE</th><th>TIER</th><th>EXPIRY</th><th>REMAINING</th><th>STATUS</th><th>CTRL</th></tr></thead>
        <tbody>
          <% keys.forEach(k => { %>
            <tr>
              <td><code style="color:#0f0; background:#000; padding:2px 6px;"><%= k.key %></code></td>
              <td>
                <% if (k.hwid) { %>
                  <span class="badge-hacker" data-bs-toggle="tooltip" title="<%= k.hwid %>"><i class="fas fa-link"></i> BOUND</span>
                <% } else { %>
                  <span class="badge-hacker" style="border-color:#555; color:#555;"><i class="fas fa-unlink"></i> FREE</span>
                <% } %>
              </td>
              <td><span class="badge-hacker"><%= k.tier %></span></td>
              <td class="small"><%= new Date(k.expires_at).toLocaleDateString('vi-VN') %></td>
              <td><span class="countdown" data-expiry="<%= k.expires_at.toISOString() %>">--</span></td>
              <td>
                <form method="POST" action="/admin/keys/toggle/<%= k.id %>" class="d-flex align-items-center">
                  <label class="toggle-switch">
                    <input type="checkbox" <%= k.is_active ? 'checked' : '' %> onchange="this.form.submit()">
                    <span class="slider"></span>
                  </label>
                </form>
              </td>
              <td>
                <div class="d-flex gap-1">
                  <% if (k.hwid) { %><form method="POST" action="/admin/keys/unbind/<%= k.id %>"><button class="btn-hacker btn-sm" title="Unbind"><i class="fas fa-unlink"></i></button></form><% } %>
                  <button class="btn-hacker btn-sm" data-bs-toggle="modal" data-bs-target="#extend<%= k.id %>" title="Extend"><i class="fas fa-calendar-plus"></i></button>
                  <form method="POST" action="/admin/keys/delete/<%= k.id %>" onsubmit="return confirm('DELETE KEY?')"><button class="btn-hacker btn-hacker-danger btn-sm" title="Delete"><i class="fas fa-trash"></i></button></form>
                </div>
                <!-- Modal gia hạn -->
                <div class="modal fade" id="extend<%= k.id %>"><div class="modal-dialog modal-sm"><form method="POST" action="/admin/keys/extend/<%= k.id %>" class="modal-content"><div class="modal-header"><h6 class="modal-title text-success">EXTEND_KEY</h6><button class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="date" name="new_expiry" class="form-control" required></div><div class="modal-footer"><button class="btn-hacker btn-sm">APPLY</button></div></form></div></div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <nav class="mt-4"><ul class="pagination justify-content-center">
      <% for(let i=1; i<=totalPages; i++) { %><li class="page-item <%= i===currentPage ? 'active' : '' %>"><a class="page-link" href="?page=<%= i %>&search=<%= search %>"><%= i %></a></li><% } %>
    </ul></nav>
  </div>
</div>

<!-- Modal Tạo Key -->
<div class="modal fade" id="createKeyModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
  <div class="modal-header"><h5 class="modal-title text-success"><i class="fas fa-terminal"></i> NEW_KEY_GENERATION</h5><button class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
  <form method="POST" action="/admin/keys/create">
    <div class="modal-body">
      <div class="mb-3"><label class="form-label text-success">PREFIX</label><input name="prefix" class="form-control" value="DPIC"></div>
      <div class="mb-3"><label class="form-label text-success">TIER</label><select name="tier" class="form-select"><option value="VIP">VIP</option><option value="Normal">NORMAL</option></select></div>
      <div class="mb-3"><label class="form-label text-success">DURATION</label><select name="duration" class="form-select"><option value="1">1 day</option><option value="7">7 days</option><option value="15">15 days</option><option value="30">30 days</option><option value="90">90 days</option><option value="365">1 year</option><option value="forever">FOREVER</option></select></div>
      <div class="mb-3"><label class="form-label text-success">TARGET_HWID <span class="text-muted">(optional)</span></label><input name="hwid" class="form-control" placeholder="Leave blank for manual activation"></div>
    </div>
    <div class="modal-footer"><button type="submit" class="btn-hacker">EXECUTE</button></div>
  </form>
</div></div></div>
<%- include('../partials/scripts') %>
