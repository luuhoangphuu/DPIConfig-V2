<%- include('../partials/header', { title: 'Quản lý Key' }) %>
<div class="d-flex">
  <%- include('../partials/sidebar', { user, currentPage: 'keys' }) %>
  <div class="cloud-main flex-grow-1">

    <div class="page-head anim-in">
      <div>
        <h1 class="page-title">
          <div class="title-icon"><i class="fas fa-key"></i></div>
          Quản lý Key
        </h1>
        <p class="page-subtitle">Danh sách tất cả key bản quyền trong hệ thống</p>
      </div>
      <button class="btn-cloud anim-in anim-2" data-bs-toggle="modal" data-bs-target="#createKeyModal">
        <i class="fas fa-plus"></i> Tạo Key mới
      </button>
    </div>

    <div class="search-wrap mb-4 anim-in anim-3">
      <i class="fas fa-search search-icon"></i>
      <form method="GET">
        <input type="text" name="search" class="cloud-search" placeholder="Tìm kiếm key..." value="<%= search %>">
      </form>
    </div>

    <div class="cloud-card anim-in" style="overflow: hidden;">
      <div class="table-responsive">
        <table class="cloud-table">
          <thead>
            <tr>
              <th>Key</th>
              <th>Hạng</th>
              <th>Thiết bị</th>
              <th>Hết hạn</th>
              <th>Còn lại</th>
              <th>Bật/Tắt</th>
              <th style="text-align:right;">Thao tác</th>
            </tr>
          </thead>
          <tbody>
            <% keys.forEach(k => {
                 const devs = k.devices || [];
                 const active = devs.filter(d => d.is_active).length;
            %>
              <tr>
                <td><code><%= k.key %></code></td>
                <td>
                  <span class="badge-tier <%= k.tier === 'VIP' ? 'badge-vip' : 'badge-normal' %>">
                    <%= k.tier === 'VIP' ? '★ VIP' : 'Thường' %>
                  </span>
                </td>
                <td>
                  <span style="font-weight: 700; color: var(--blue-7);"><%= active %></span>
                  <span style="color: var(--text-muted);">/ <%= k.max_devices %></span>
                </td>
                <td style="color: var(--text-muted); font-size: 0.82rem; font-weight: 600;">
                  <%= new Date(k.expires_at).toLocaleString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh' }) %>
                </td>
                <td><span class="countdown" data-expiry="<%= k.expires_at.toISOString() %>">--</span></td>
                <td>
                  <form method="POST" action="/admin/keys/toggle/<%= k.id %>" style="margin:0;">
                    <label class="cloud-toggle">
                      <input type="checkbox" <%= k.is_active ? 'checked' : '' %> onchange="this.form.submit()">
                      <span class="cloud-slider"></span>
                    </label>
                  </form>
                </td>
                <td style="text-align:right;">
                  <div class="d-flex gap-1 justify-content-end">
                    <button class="btn-icon view-devices-btn" data-key-id="<%= k.id %>" title="Xem thiết bị">
                      <i class="fas fa-mobile-alt"></i>
                    </button>
                    <button class="btn-icon" data-bs-toggle="modal" data-bs-target="#extend<%= k.id %>" title="Gia hạn">
                      <i class="fas fa-calendar-plus"></i>
                    </button>
                    <form method="POST" action="/admin/keys/kick-all/<%= k.id %>" onsubmit="return confirm('Khóa tất cả thiết bị của key này?')" style="display:inline;margin:0;">
                      <button class="btn-icon warning" title="Khóa tất cả thiết bị"><i class="fas fa-ban"></i></button>
                    </form>
                    <form method="POST" action="/admin/keys/delete-all-devices/<%= k.id %>" onsubmit="return confirm('Xóa vĩnh viễn tất cả thiết bị của key này?')" style="display:inline;margin:0;">
                      <button class="btn-icon danger" title="Xóa tất cả thiết bị"><i class="fas fa-broom"></i></button>
                    </form>
                    <form method="POST" action="/admin/keys/delete/<%= k.id %>" onsubmit="return confirm('Xóa key này vĩnh viễn?')" style="display:inline;margin:0;">
                      <button class="btn-icon danger" title="Xóa key"><i class="fas fa-trash-alt"></i></button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
            <% if (keys.length === 0) { %>
              <tr>
                <td colspan="7" class="text-center py-5" style="color: var(--text-muted);">
                  <i class="fas fa-cloud fa-3x mb-3" style="color: var(--sky-3);"></i>
                  <p style="margin: 0; font-weight: 500;">Chưa có key nào. Hãy tạo key đầu tiên!</p>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <nav class="mt-4 anim-in">
      <ul class="pagination justify-content-center cloud-pagination">
        <% for(let i = 1; i <= totalPages; i++) { %>
          <li class="page-item <%= i === currentPage ? 'active' : '' %>">
            <a class="page-link" href="?page=<%= i %>&search=<%= search %>"><%= i %></a>
          </li>
        <% } %>
      </ul>
    </nav>

  </div>
</div>

<!-- MODAL DEVICES -->
<div class="modal fade" id="devicesModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content cloud-modal">
      <div class="modal-header">
        <h5 class="modal-title"><i class="fas fa-mobile-alt"></i> Thiết bị của Key</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="devicesModalBody" style="min-height: 100px;">
        <p class="text-center" style="color: var(--text-muted);">Đang tải...</p>
      </div>
    </div>
  </div>
</div>

<!-- MODAL CREATE -->
<div class="modal fade" id="createKeyModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content cloud-modal">
      <div class="modal-header">
        <h5 class="modal-title"><i class="fas fa-plus-circle"></i> Tạo Key mới</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form method="POST" action="/admin/keys/create">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Tiền tố</label>
            <input name="prefix" class="form-control" value="HoangPhu">
          </div>
          <div class="mb-3">
            <label class="form-label">Hạng</label>
            <select name="tier" class="form-select" id="tierSelect">
              <option value="VIP">★ VIP</option>
              <option value="Normal">Thường</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Số thiết bị tối đa</label>
            <input name="max_devices" type="number" class="form-control" value="1" id="maxDevicesInput" min="1" max="999">
          </div>
          <div class="mb-3">
            <label class="form-label">Thời hạn</label>
            <select name="duration" class="form-select">
              <option value="0.5">12 giờ</option>
              <option value="1" selected>1 ngày</option>
              <option value="7">7 ngày</option>
              <option value="15">15 ngày</option>
              <option value="30">30 ngày</option>
              <option value="90">90 ngày</option>
              <option value="365">1 năm</option>
              <option value="forever">♾️ Vĩnh viễn</option>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn-ghost" data-bs-dismiss="modal">Hủy</button>
          <button type="submit" class="btn-cloud"><i class="fas fa-check"></i> Tạo Key</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- MODALS EXTEND -->
<% keys.forEach(k => { %>
  <div class="modal fade" id="extend<%= k.id %>" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
      <div class="modal-content cloud-modal">
        <div class="modal-header">
          <h5 class="modal-title"><i class="fas fa-calendar-plus"></i> Gia hạn Key</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <form method="POST" action="/admin/keys/extend/<%= k.id %>">
          <div class="modal-body">
            <label class="form-label">Ngày hết hạn mới</label>
            <input type="datetime-local" name="new_expiry" class="form-control" required>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn-ghost" data-bs-dismiss="modal">Hủy</button>
            <button type="submit" class="btn-cloud">Cập nhật</button>
          </div>
        </form>
      </div>
    </div>
  </div>
<% }) %>

<%- include('../partials/scripts') %>
<script>
  document.getElementById('tierSelect').addEventListener('change', function() {
    document.getElementById('maxDevicesInput').value = this.value === 'VIP' ? 1 : 5;
  });

  document.querySelectorAll('.view-devices-btn').forEach(btn => {
    btn.addEventListener('click', async function() {
      const keyId = this.dataset.keyId;
      const body = document.getElementById('devicesModalBody');
      body.innerHTML = '<p class="text-center" style="color: var(--text-muted);">Đang tải...</p>';
      new bootstrap.Modal(document.getElementById('devicesModal')).show();
      try {
        const res = await fetch(`/admin/keys/devices/${keyId}`);
        const data = await res.json();
        if (data.success && data.devices.length) {
          let html = '<table class="cloud-table"><thead><tr><th>HWID</th><th>Tên thiết bị</th><th>Trạng thái</th><th>Ngày thêm</th><th style="text-align:right;">Thao tác</th></tr></thead><tbody>';
          data.devices.forEach(d => {
            html += `<tr>
              <td><code>${d.hwid.substring(0,20)}${d.hwid.length > 20 ? '...' : ''}</code></td>
              <td style="font-weight: 600;">${d.device_name || '<em style="color: var(--text-muted);">Chưa đặt</em>'}</td>
              <td>${d.is_active
                ? '<span style="color:#059669; font-weight:700;">● Hoạt động</span>'
                : '<span style="color:#dc2626; font-weight:700;">● Bị khóa</span>'}</td>
              <td style="color: var(--text-muted); font-size: 0.82rem;">${new Date(d.createdAt).toLocaleString('vi-VN')}</td>
              <td style="text-align:right;">
                <form method="POST" action="/admin/keys/toggle-device/${d.id}" style="display:inline;margin:0;">
                  <button class="btn-icon ${d.is_active ? 'warning' : ''}" title="${d.is_active ? 'Khóa' : 'Mở khóa'}">
                    <i class="fas fa-power-off"></i>
                  </button>
                </form>
                <form method="POST" action="/admin/keys/unbind-device/${d.id}" style="display:inline;margin:0;" onsubmit="return confirm('Xóa thiết bị này?')">
                  <button class="btn-icon danger" title="Xóa"><i class="fas fa-trash"></i></button>
                </form>
              </td>
            </tr>`;
          });
          body.innerHTML = html + '</tbody></table>';
        } else {
          body.innerHTML = '<p class="text-center" style="color: var(--text-muted); padding: 30px 0;"><i class="fas fa-cloud fa-2x mb-2" style="color: var(--sky-3);"></i><br>Chưa có thiết bị nào được kích hoạt.</p>';
        }
      } catch(e) {
        body.innerHTML = '<p class="text-center" style="color: #dc2626;">Lỗi tải dữ liệu.</p>';
      }
    });
  });
</script>
