<%- include('../partials/header', { title: 'Quản lý Key' }) %>
<div class="d-flex">
  <%- include('../partials/sidebar', { user, currentPage: 'keys' }) %>
  <div class="main-content flex-grow-1">
    <div class="d-flex justify-content-between mb-4 animate__animated animate__fadeInDown">
      <h2 class="fw-bold" style="color: #00f2fe;"><i class="fas fa-key me-2"></i>Danh sách Key</h2>
      <button class="btn btn-primary rounded-pill shadow" data-bs-toggle="modal" data-bs-target="#createKeyModal"><i class="fas fa-plus me-2"></i>Tạo Key Mới</button>
    </div>
    <div class="card bg-transparent border-0 shadow-sm"><div class="card-body p-0"><div class="table-responsive"><table class="table table-hover table-keys mb-0">
      <thead><tr><th>Key</th><th>HWID</th><th>Tier</th><th>Hết hạn</th><th>Còn lại</th><th>Trạng thái</th><th>Hành động</th></tr></thead>
      <tbody>
        <% keys.forEach(k => { %>
          <tr>
            <td><code class="bg-dark p-2 rounded"><%= k.key %></code></td>
            <td><%= k.hwid ? '<span class="badge bg-success"><i class="fas fa-link"></i> Đã gán</span>' : '<span class="badge bg-secondary"><i class="fas fa-unlink"></i> Chưa gán</span>' %></td>
            <td><span class="badge-tier badge bg-<%= k.tier === 'VIP' ? 'warning text-dark' : 'secondary' %>"><%= k.tier %></span></td>
            <td><%= new Date(k.expires_at).toLocaleDateString('vi-VN') %></td>
            <td><span class="countdown" data-expiry="<%= k.expires_at.toISOString() %>">--</span></td>
            <td><%= k.is_active ? '<span class="text-success">✅</span>' : '<span class="text-danger">❌</span>' %></td>
            <td>
              <div class="d-flex align-items-center gap-2">
                <form method="POST" action="/admin/keys/toggle/<%= k.id %>" class="d-flex align-items-center">
                  <label class="toggle-switch">
                    <input type="checkbox" <%= k.is_active ? 'checked' : '' %> onchange="this.form.submit()">
                    <span class="slider"></span>
                  </label>
                </form>
                <% if (k.hwid) { %><form method="POST" action="/admin/keys/unbind/<%= k.id %>"><button class="btn btn-sm btn-info"><i class="fas fa-unlink"></i></button></form><% } %>
                <button class="btn btn-sm btn-secondary" data-bs-toggle="modal" data-bs-target="#extend<%= k.id %>"><i class="fas fa-calendar-plus"></i></button>
                <form method="POST" action="/admin/keys/delete/<%= k.id %>" onsubmit="return confirm('Xoá?')"><button class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button></form>
              </div>
              <div class="modal fade" id="extend<%= k.id %>"><div class="modal-dialog modal-sm"><form method="POST" action="/admin/keys/extend/<%= k.id %>" class="modal-content"><div class="modal-header"><h5>Gia hạn</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="date" name="new_expiry" class="form-control" required></div><div class="modal-footer"><button class="btn btn-primary">OK</button></div></form></div></div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table></div></div></div>
    <nav class="mt-4"><ul class="pagination justify-content-center">
      <% for(let i=1; i<=totalPages; i++) { %><li class="page-item <%= i===currentPage ? 'active' : '' %>"><a class="page-link" href="?page=<%= i %>&search=<%= search %>"><%= i %></a></li><% } %>
    </ul></nav>
  </div>
</div>

<!-- Modal Tạo Key (có ô HWID) -->
<div class="modal fade" id="createKeyModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
  <div class="modal-header"><h5><i class="fas fa-plus-circle"></i> Tạo Key Mới</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
  <form method="POST" action="/admin/keys/create">
    <div class="modal-body">
      <div class="mb-3"><label>Tiền tố</label><input name="prefix" class="form-control" value="DPIC"></div>
      <div class="mb-3"><label>Hạng</label><select name="tier" class="form-select"><option value="VIP">🌟 VIP</option><option value="Normal">🔹 Thường</option></select></div>
      <div class="mb-3"><label>Thời hạn</label><select name="duration" class="form-select"><option value="1">1 ngày</option><option value="7">7 ngày</option><option value="15">15 ngày</option><option value="30">30 ngày</option><option value="90">90 ngày</option><option value="365">1 năm</option><option value="forever">♾️ Vĩnh viễn</option></select></div>
      <div class="mb-3"><label>Gán thiết bị (HWID)</label><input name="hwid" class="form-control" placeholder="Để trống nếu chưa"></div>
    </div>
    <div class="modal-footer"><button type="submit" class="btn btn-primary">Tạo Key</button></div>
  </form>
</div></div></div>
<%- include('../partials/scripts') %>
