<%- include('../partials/header', { title: 'Quản lý Key', pageName: 'Quản lý Key', user }) %>
<div class="d-flex">
  <%- include('../partials/sidebar', { user, currentPage: 'keys', activeKeys }) %>
  <div class="vg-main flex-grow-1">

    <!-- ===== HERO ===== -->
    <div class="sn-hero anim d1">
      <div>
        <h1 class="sn-hero-greet">🔑 Vườn sao</h1>
        <p class="sn-hero-sub">
          Mỗi Key là một ngôi sao · Tổng <b><%= keys.length %></b> key đang hiển thị
        </p>
      </div>
      <div class="sn-quick-actions">
        <button class="sn-quick-btn" data-bs-toggle="modal" data-bs-target="#createKeyModal">
          <i class="fas fa-plus-circle"></i> Tạo Key mới
        </button>
      </div>
    </div>

    <!-- ===== FILTER BAR ===== -->
    
<!-- PRO FILTER BAR & TABS -->
<div class="sn-pro-controls anim d2" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; flex-wrap:wrap; gap:15px;">
  
  <!-- Tabs Phân loại -->
  <div class="sn-segmented-control">
    <a href="?tier=" class="sn-seg-btn <%= !tier ? 'active' : '' %>">Tất cả</a>
    <a href="?tier=VIP" class="sn-seg-btn <%= tier === 'VIP' ? 'active' : '' %>">⭐ VIP</a>
    <a href="?tier=Normal" class="sn-seg-btn <%= tier === 'Normal' ? 'active' : '' %>">Thường</a>
  </div>

  <!-- Dropdown Sắp xếp -->
  <div class="sn-sort-dropdown">
    <label style="color:#b8c5d9; font-size:0.85rem; margin-right:8px;">Sắp xếp:</label>
    <select onchange="location = this.value;" class="sn-minimal-select">
      <option value="?sort=newest" <%= !sort || sort === 'newest' ? 'selected' : '' %>>Mới nhất</option>
      <option value="?sort=oldest" <%= sort === 'oldest' ? 'selected' : '' %>>Cũ nhất</option>
      <option value="?sort=expiring" <%= sort === 'expiring' ? 'selected' : '' %>>Sắp hết hạn</option>
    </select>
  </div>
</div>

<div class="sn-filter-bar anim d2">
      <form method="GET" class="sn-filter-form">
        <div class="sn-search-wrap">
          <i class="fas fa-search"></i>
          <input type="text" name="search" class="sn-search-input" 
                 placeholder="Tìm theo Key hoặc HWID..." value="<%= search %>">
        </div>
        <select name="tier" class="sn-filter-select">
          <option value="">Tất cả hạng</option>
          <option value="VIP" <%= tier === 'VIP' ? 'selected' : '' %>>★ VIP</option>
          <option value="Normal" <%= tier === 'Normal' ? 'selected' : '' %>>Thường</option>
        </select>
        <select name="status" class="sn-filter-select">
          <option value="">Tất cả trạng thái</option>
          <option value="active" <%= status === 'active' ? 'selected' : '' %>>✅ Hoạt động</option>
          <option value="disabled" <%= status === 'disabled' ? 'selected' : '' %>>⛔ Đã khóa</option>
          <option value="expired" <%= status === 'expired' ? 'selected' : '' %>>⏰ Hết hạn</option>
        </select>
        <button type="submit" class="sn-quick-btn cyan">
          <i class="fas fa-filter"></i> Lọc
        </button>
        <% if (search || tier || status) { %>
          <a href="/yncuti/keys" class="sn-quick-btn" style="border-color:rgba(239,83,80,0.4);color:#ef5350;">
            <i class="fas fa-times"></i> Xóa lọc
          </a>
        <% } %>
      </form>
    </div>

    <!-- ===== BULK ACTIONS (hiện khi có checkbox) ===== -->
    <div class="sn-bulk-bar" id="bulkBar" style="display:none;">
      <span class="sn-bulk-count"><b id="selectedCount">0</b> key được chọn</span>
      <div class="sn-quick-actions">
        <button class="sn-quick-btn" onclick="bulkCopy()">
          <i class="fas fa-copy"></i> Copy
        </button>
        <button class="sn-quick-btn" onclick="bulkExport()">
          <i class="fas fa-file-csv"></i> Export CSV
        </button>
        <button class="sn-quick-btn" style="border-color:rgba(239,83,80,0.4);color:#ef5350;" onclick="bulkDelete()">
          <i class="fas fa-trash"></i> Xóa
        </button>
      </div>
    </div>

    <!-- ===== TABLE ===== -->
    <div class="vg-card vg-table-wrap anim d3" style="padding: 0;">
      <table class="vg-table sn-key-table">
        <thead>
          <tr>
            <th style="width:40px;"><input type="checkbox" id="checkAll"></th>
            <th>Key</th>
            <th>Hạng</th>
            <th>Thiết bị</th>
            <th>Còn lại</th>
            <th>Bật/Tắt</th>
            <th style="text-align:right;">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          <% keys.forEach(k => {
               const devs = k.devices || [];
               const active = devs.filter(d => d.is_active).length;
               const isExpired = new Date(k.expires_at) < new Date();
          %>
            <tr class="sn-key-row" data-key-id="<%= k.id %>" data-key="<%= k.key %>">
              <td><input type="checkbox" class="rowCheck" value="<%= k.id %>" data-key="<%= k.key %>"></td>
              <td>
                <div class="sn-key-cell">
                  <code class="sn-key-code" title="<%= k.key %>"><%= k.key %></code>
                  <button class="sn-copy-btn" onclick="copyKey('<%= k.key %>', this)" title="Copy">
                    <i class="fas fa-copy"></i>
                  </button>
                </div>
              </td>
              <td>
                <span class="<%= k.tier === 'VIP' ? 'vg-badge-vip' : 'vg-badge-normal' %>">
                  <%= k.tier === 'VIP' ? '★ VIP' : 'Thường' %>
                </span>
              </td>
              <td>
                <span style="font-weight:800;color:#4fc3f7;font-family:'Caveat';font-size:1.2rem;"><%= active %></span>
                <span style="color:#b8c5d9;">/ <%= k.max_devices %></span>
              </td>
              <td><span class="countdown" data-expiry="<%= k.expires_at.toISOString() %>">--</span></td>
              <td>
                <form method="POST" action="/yncuti/keys/toggle/<%= k.id %>" style="margin:0;">
                  <label class="vg-toggle">
                    <input type="checkbox" <%= k.is_active && !isExpired ? 'checked' : '' %> onchange="this.form.submit()">
                    <span class="vg-slider"></span>
                  </label>
                </form>
              </td>
              <td style="text-align:right;">
                <div class="d-flex gap-1 justify-content-end">
                  <button class="vg-btn-icon view-devices-btn" data-key-id="<%= k.id %>" title="Xem thiết bị">
                    <i class="fas fa-mobile-alt"></i>
                  </button>
                  <button class="vg-btn-icon" data-bs-toggle="modal" data-bs-target="#extend<%= k.id %>" title="Gia hạn">
                    <i class="fas fa-calendar-plus"></i>
                  </button>
                  <form method="POST" action="/yncuti/keys/kick-all/<%= k.id %>" onsubmit="return confirm('Khóa tất cả thiết bị?')" style="display:inline;margin:0;">
                    <button class="vg-btn-icon warn" title="Khóa tất cả"><i class="fas fa-ban"></i></button>
                  </form>
                  <form method="POST" action="/yncuti/keys/delete/<%= k.id %>" onsubmit="return confirm('Xóa Key này?')" style="display:inline;margin:0;">
                    <button class="vg-btn-icon danger" title="Xóa"><i class="fas fa-trash-alt"></i></button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
          <% if (keys.length === 0) { %>
            <tr>
              <td colspan="8">
                <div class="vg-empty">
                  <i class="fas fa-star"></i>
                  <p>Chưa có Key nào. Hãy thắp sáng ngôi sao đầu tiên!</p>
                </div>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- ===== PAGINATION ===== -->
    <ul class="vg-pagination">
      <% for (let i = 1; i <= totalPages; i++) { %>
        <li class="<%= i === currentPage ? 'active' : '' %>">
          <a href="?page=<%= i %>&search=<%= search %>&tier=<%= tier || '' %>&status=<%= status || '' %>"><%= i %></a>
        </li>
      <% } %>
    </ul>

  </div>
</div>

<!-- ===== MODAL: DEVICES ===== -->
<div class="modal fade" id="devicesModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content vg-modal">
      <div class="modal-header">
        <h5 class="modal-title"><i class="fas fa-mobile-alt"></i> Thiết bị của Key</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="devicesModalBody" style="min-height:100px;">
        <p style="text-align:center;color:#b8c5d9;">Đang tải...</p>
      </div>
    </div>
  </div>
</div>

<!-- ===== MODAL: CREATE KEY ===== -->
<div class="modal fade" id="createKeyModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content vg-modal">
      <div class="modal-header">
        <h5 class="modal-title"><i class="fas fa-star"></i> Tạo Key mới</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form method="POST" action="/yncuti/keys/create">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Tiền tố</label>
            <input name="prefix" class="form-control" value="HoangPhu" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Hạng</label>
            <select name="tier" class="form-select" id="tierSelect" required>
              <option value="VIP">★ VIP</option>
              <option value="Normal" selected>Thường</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Số thiết bị tối đa</label>
            <input name="max_devices" type="number" class="form-control" value="1" id="maxDevicesInput" min="1" max="999" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Thời hạn (Ngày)</label>
            <select name="duration" class="form-select" required>
              <option value="0.5">12 giờ</option>
              <option value="1" selected>1 ngày</option>
              <option value="7">7 ngày</option>
              <option value="30">30 ngày</option>
              <option value="365">1 năm</option>
              <option value="forever">♾️ Vĩnh viễn</option>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="vg-btn-ghost" data-bs-dismiss="modal">Hủy</button>
          <button type="submit" class="vg-btn"><i class="fas fa-check"></i> Tạo Key</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- ===== MODAL: EXTEND ===== -->
<% keys.forEach(k => { %>
  <div class="modal fade" id="extend<%= k.id %>" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
      <div class="modal-content vg-modal">
        <div class="modal-header">
          <h5 class="modal-title"><i class="fas fa-calendar-plus"></i> Gia hạn</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <form method="POST" action="/yncuti/keys/extend/<%= k.id %>">
          <div class="modal-body">
            <label class="form-label">Ngày hết hạn mới</label>
            <input type="datetime-local" name="new_expiry" class="form-control" required>
          </div>
          <div class="modal-footer">
            <button type="button" class="vg-btn-ghost" data-bs-dismiss="modal">Hủy</button>
            <button type="submit" class="vg-btn">Cập nhật</button>
          </div>
        </form>
      </div>
    </div>
  </div>
<% }) %>

<%- include('../partials/scripts') %>

<script>
// ===== COPY KEY 1 CLICK =====
function copyKey(text, btn) {
  navigator.clipboard.writeText(text).then(() => {
    const icon = btn.querySelector('i');
    const old = icon.className;
    icon.className = 'fas fa-check';
    btn.classList.add('copied');
    setTimeout(() => {
      icon.className = old;
      btn.classList.remove('copied');
    }, 1500);
    Swal.fire({
      toast: true, position: 'top-end', icon: 'success',
      title: 'Đã copy: ' + text.substring(0, 20) + '...',
      showConfirmButton: false, timer: 1500,
      background: 'rgba(10,30,63,0.95)', color: '#ffd700'
    });
  });
}

// ===== CHECK ALL =====
const checkAll = document.getElementById('checkAll');
const rowChecks = document.querySelectorAll('.rowCheck');
const bulkBar = document.getElementById('bulkBar');
const selectedCount = document.getElementById('selectedCount');

function updateBulkBar() {
  const checked = document.querySelectorAll('.rowCheck:checked');
  selectedCount.textContent = checked.length;
  bulkBar.style.display = checked.length > 0 ? 'flex' : 'none';
}

if (checkAll) {
  checkAll.addEventListener('change', function() {
    rowChecks.forEach(cb => cb.checked = this.checked);
    updateBulkBar();
  });
}
rowChecks.forEach(cb => cb.addEventListener('change', updateBulkBar));

// ===== BULK ACTIONS =====
function getSelectedKeys() {
  return Array.from(document.querySelectorAll('.rowCheck:checked'))
    .map(cb => ({ id: cb.value, key: cb.dataset.key }));
}

function bulkCopy() {
  const keys = getSelectedKeys().map(x => x.key).join('\n');
  navigator.clipboard.writeText(keys);
  Swal.fire({ toast: true, position: 'top-end', icon: 'success',
    title: 'Đã copy ' + getSelectedKeys().length + ' key',
    showConfirmButton: false, timer: 2000,
    background: 'rgba(10,30,63,0.95)', color: '#ffd700' });
}

function bulkExport() {
  const keys = getSelectedKeys();
  const csv = 'Key\n' + keys.map(x => x.key).join('\n');
  const blob = new Blob([csv], { type: 'text/csv' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'keys-' + Date.now() + '.csv';
  a.click();
  URL.revokeObjectURL(url);
}

function bulkDelete() {
  const keys = getSelectedKeys();
  if (!confirm('Xóa ' + keys.length + ' key đã chọn? Không thể hoàn tác!')) return;
  // Tạo form ẩn và submit từng key
  keys.forEach(k => {
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '/yncuti/keys/delete/' + k.id;
    document.body.appendChild(form);
    form.submit();
  });
}

// ===== TIER SELECT AUTO =====
const tierSelect = document.getElementById('tierSelect');
if (tierSelect) {
  tierSelect.addEventListener('change', function() {
    document.getElementById('maxDevicesInput').value = this.value === 'VIP' ? 1 : 5;
  });
}

// ===== VIEW DEVICES =====
document.querySelectorAll('.view-devices-btn').forEach(btn => {
  btn.addEventListener('click', async function() {
    const keyId = this.dataset.keyId;
    const body = document.getElementById('devicesModalBody');
    body.innerHTML = `
          <div style="padding: 10px;">
            <div class="sn-skeleton sn-skeleton-row" style="width: 100%; height: 50px;"></div>
            <div class="sn-skeleton sn-skeleton-row" style="width: 100%; height: 50px;"></div>
            <div class="sn-skeleton sn-skeleton-row" style="width: 100%; height: 50px;"></div>
          </div>
        `;
    new bootstrap.Modal(document.getElementById('devicesModal')).show();
    try {
      const res = await fetch('/yncuti/keys/devices/' + keyId);
      const data = await res.json();
      if (data.success && data.devices.length) {
        let html = '<table class="vg-table"><thead><tr><th>HWID</th><th>Tên</th><th>Trạng thái</th><th>Ngày thêm</th><th style="text-align:right;">Thao tác</th></tr></thead><tbody>';
        data.devices.forEach(d => {
          html += '<tr><td><code>' + d.hwid.substring(0,18) + (d.hwid.length > 18 ? '...' : '') + '</code></td>';
          html += '<td style="font-weight:600;">' + (d.device_name || '<em style="color:#b8c5d9;">Chưa đặt</em>') + '</td>';
          html += '<td>' + (d.is_active ? '<span style="color:#81c784;font-weight:700;">● Hoạt động</span>' : '<span style="color:#ef5350;font-weight:700;">● Bị khóa</span>') + '</td>';
          html += '';
          html += '<td style="text-align:right;"><form method="POST" action="/yncuti/keys/toggle-device/' + d.id + '" style="display:inline;margin:0;"><button class="vg-btn-icon ' + (d.is_active ? 'warn' : '') + '"><i class="fas fa-power-off"></i></button></form> ';
          html += '<form method="POST" action="/yncuti/keys/unbind-device/' + d.id + '" style="display:inline;margin:0;" onsubmit="return confirm(\'Xóa thiết bị này?\')"><button class="vg-btn-icon danger"><i class="fas fa-trash"></i></button></form></td></tr>';
        });
        body.innerHTML = html + '</tbody></table>';
      } else {
        body.innerHTML = '<div class="vg-empty"><i class="fas fa-moon"></i><p>Chưa có thiết bị nào</p></div>';
      }
    } catch (e) {
      body.innerHTML = '<p style="text-align:center;color:#ef5350;">Lỗi tải dữ liệu</p>';
    }
  });
});
</script>
