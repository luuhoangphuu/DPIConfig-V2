<%- include('../partials/header', { title: 'Quản lý Key' }) %>
<div class="d-flex">
  <%- include('../partials/sidebar', { user, currentPage: 'keys' }) %>
  <div class="main-content flex-grow-1">
    <div class="d-flex justify-content-between align-items-center mb-4 animate__animated animate__fadeInDown">
      <h4 class="fw-bold mb-0">Danh sách Key</h4>
      <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createKeyModal">
        <i class="fas fa-plus me-1"></i> Tạo Key Mới
      </button>
    </div>
    <form class="mb-4"><div class="input-group">
      <span class="input-group-text bg-white border-0"><i class="fas fa-search text-muted"></i></span>
      <input type="text" name="search" class="form-control border-0 shadow-none" placeholder="Tìm key, HWID..." value="<%= search %>">
      <button class="btn btn-outline" type="submit">Tìm</button>
    </div></form>
    <div class="table-responsive">
      <table class="table-custom w-100">
        <thead><tr><th>Key</th><th>Thiết bị</th><th>Hạng</th><th>Hết hạn</th><th>Còn lại</th><th>Trạng thái</th><th></th></tr></thead>
        <tbody>
          <% keys.forEach(k => { %>
            <tr>
              <td><code style="background:#F3F4F6; padding:4px 8px; border-radius:4px;"><%= k.key %></code></td>
              <td>
                <% if (k.hwid) { %>
                  <span class="badge bg-success" data-bs-toggle="tooltip" title="<%= k.hwid %>"><i class="fas fa-link"></i> Đã gán</span>
                <% } else { %>
                  <span class="badge bg-secondary"><i class="fas fa-unlink"></i> Chưa gán</span>
                <% } %>
              </td>
              <td><span class="badge bg-<%= k.tier === 'VIP' ? 'warning text-dark' : 'light text-dark' %>"><%= k.tier %></span></td>
              <td class="small"><%= new Date(k.expires_at).toLocaleDateString('vi-VN') %></td>
              <td><span class="countdown" data-expiry="<%= k.expires_at.toISOString() %>">--</span></td>
              <td>
                <form method="POST" action="/admin/keys/toggle/<%= k.id %>" class="d-flex align-items-center">
                  <label class="toggle-switch">
                    <input type="checkbox" <%= k.is_active ? 'checked' : '' %> onchange="this.form.submit()">
                    <span class="slider"></span>
                  </label>
                </form>
              </td>
              <td>
                <div class="d-flex gap-1">
                  <% if (k.hwid) { %><form method="POST" action="/admin/keys/unbind/<%= k.id %>"><button class="btn btn-sm btn-outline" title="Gỡ"><i class="fas fa-unlink"></i></button></form><% } %>
                  <button class="btn btn-sm btn-outline" data-bs-toggle="modal" data-bs-target="#extend<%= k.id %>" title="Gia hạn"><i class="fas fa-calendar-plus"></i></button>
                  <form method="POST" action="/admin/keys/delete/<%= k.id %>" onsubmit="return confirm('Xoá key này?')"><button class="btn btn-sm btn-outline text-danger" title="Xoá"><i class="fas fa-trash"></i></button></form>
                </div>
                <div class="modal fade" id="extend<%= k.id %>"><div class="modal-dialog modal-sm"><form method="POST" action="/admin/keys/extend/<%= k.id %>" class="modal-content"><div class="modal-header"><h6 class="modal-title">Gia hạn key</h6><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="date" name="new_expiry" class="form-control" required></div><div class="modal-footer"><button class="btn btn-primary btn-sm">Cập nhật</button></div></form></div></div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <nav class="mt-4"><ul class="pagination justify-content-center">
      <% for(let i=1; i<=totalPages; i++) { %><li class="page-item <%= i===currentPage ? 'active' : '' %>"><a class="page-link" href="?page=<%= i %>&search=<%= search %>"><%= i %></a></li><% } %>
    </ul></nav>
  </div>
</div>
<!-- Modal Tạo Key: sửa tiền tố mặc định -->
<div class="modal fade" id="createKeyModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
  <div class="modal-header"><h5 class="modal-title">Tạo Key Mới</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
  <form method="POST" action="/admin/keys/create">
    <div class="modal-body">
      <div class="mb-3"><label class="form-label">Tiền tố</label><input name="prefix" class="form-control" value="HoangPhu"></div>
      <div class="mb-3"><label class="form-label">Hạng</label><select name="tier" class="form-select"><option value="VIP">🌟 VIP</option><option value="Normal">🔹 Thường</option></select></div>
      <div class="mb-3"><label class="form-label">Thời hạn</label><select name="duration" class="form-select"><option value="1">1 ngày</option><option value="7">7 ngày</option><option value="15">15 ngày</option><option value="30">30 ngày</option><option value="90">90 ngày</option><option value="365">1 năm</option><option value="forever">♾️ Vĩnh viễn</option></select></div>
      <div class="mb-3"><label class="form-label">Gán thiết bị (HWID) <span class="text-muted">- tùy chọn</span></label><input name="hwid" class="form-control" placeholder="Nhập HWID nếu muốn khóa cứng"></div>
    </div>
    <div class="modal-footer"><button type="submit" class="btn btn-primary">Tạo Key</button></div>
  </form>
</div></div></div>
<%- include('../partials/scripts') %>
