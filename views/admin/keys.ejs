<%- include('../partials/header', { title: 'Quản lý Key' }) %>
<div class="d-flex">
  <%- include('../partials/sidebar', { user, currentPage: 'keys' }) %>
  <div class="main-content flex-grow-1">
    <div class="d-flex justify-content-between align-items-center mb-4 animate__animated animate__fadeInDown">
      <h4 class="fw-bold mb-0">Danh sách Key</h4>
      <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createKeyModal"><i class="fas fa-plus me-1"></i> Tạo Key Mới</button>
    </div>
    <form class="mb-4"><div class="input-group"><span class="input-group-text bg-white border-0"><i class="fas fa-search text-muted"></i></span><input type="text" name="search" class="form-control border-0 shadow-none" placeholder="Tìm key..." value="<%= search %>"><button class="btn btn-outline" type="submit">Tìm</button></div></form>
    <div class="table-responsive">
      <table class="table-custom w-100">
        <thead><tr><th>Key</th><th>Hạng</th><th>Tối đa</th><th>Active</th><th>Hết hạn</th><th>Còn lại</th><th>Trạng thái</th><th></th></tr></thead>
        <tbody>
          <% keys.forEach(k => {
               const devs = k.devices || [];
               const active = devs.filter(d => d.is_active).length;
          %>
            <tr>
              <td><code><%= k.key %></code></td>
              <td><span class="badge bg-<%= k.tier==='VIP'?'warning text-dark':'light text-dark' %>"><%= k.tier %></span></td>
              <td><%= k.max_devices %></td>
              <td><%= active %>/<%= k.max_devices %></td>
              <td class="small"><%= new Date(k.expires_at).toLocaleDateString('vi-VN') %></td>
              <td><span class="countdown" data-expiry="<%= k.expires_at.toISOString() %>">--</span></td>
              <td>
                <form method="POST" action="/admin/keys/toggle/<%= k.id %>" class="d-flex align-items-center">
                  <label class="toggle-switch"><input type="checkbox" <%= k.is_active?'checked':'' %> onchange="this.form.submit()"><span class="slider"></span></label>
                </form>
              </td>
              <td>
                <div class="d-flex gap-1">
                  <button class="btn btn-sm btn-outline view-devices-btn" data-key-id="<%= k.id %>" title="Xem TB"><i class="fas fa-list"></i></button>
                  <button class="btn btn-sm btn-outline" data-bs-toggle="modal" data-bs-target="#extend<%= k.id %>" title="Gia hạn"><i class="fas fa-calendar-plus"></i></button>
                  <form method="POST" action="/admin/keys/kick-all/<%= k.id %>" onsubmit="return confirm('Khóa tất cả TB?')"><button class="btn btn-sm btn-outline text-warning" title="Khóa tất cả"><i class="fas fa-ban"></i></button></form>
                  <form method="POST" action="/admin/keys/delete-all-devices/<%= k.id %>" onsubmit="return confirm('XÓA tất cả TB?')"><button class="btn btn-sm btn-outline text-danger" title="Xóa tất cả"><i class="fas fa-trash-alt"></i></button></form>
                  <form method="POST" action="/admin/keys/delete/<%= k.id %>" onsubmit="return confirm('XÓA KEY này?')"><button class="btn btn-sm btn-outline text-danger" title="Xóa key"><i class="fas fa-times"></i></button></form>
                </div>
                <div class="modal fade" id="extend<%= k.id %>"><div class="modal-dialog modal-sm"><form method="POST" action="/admin/keys/extend/<%= k.id %>" class="modal-content"><div class="modal-header"><h6>Gia hạn</h6><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="date" name="new_expiry" class="form-control" required></div><div class="modal-footer"><button class="btn btn-primary btn-sm">OK</button></div></form></div></div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <nav class="mt-4"><ul class="pagination justify-content-center"><% for(let i=1; i<=totalPages; i++) { %><li class="page-item <%= i===currentPage?'active':'' %>"><a class="page-link" href="?page=<%= i %>&search=<%= search %>"><%= i %></a></li><% } %></ul></nav>
  </div>
</div>

<!-- Modal xem thiết bị -->
<div class="modal fade" id="devicesModal" tabindex="-1">
  <div class="modal-dialog modal-lg"><div class="modal-content">
    <div class="modal-header"><h5>Quản lý thiết bị</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body" id="devicesModalBody">Đang tải...</div>
    <div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button></div>
  </div></div>
</div>

<!-- Modal tạo key -->
<div class="modal fade" id="createKeyModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
  <div class="modal-header"><h5>Tạo Key Mới</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
  <form method="POST" action="/admin/keys/create"><div class="modal-body">
    <div class="mb-3"><label>Tiền tố</label><input name="prefix" class="form-control" value="HoangPhu"></div>
    <div class="mb-3"><label>Hạng</label><select name="tier" class="form-select" id="tierSelect"><option value="VIP">VIP</option><option value="Normal">Normal</option></select></div>
    <div class="mb-3"><label>Số TB tối đa</label><input name="max_devices" type="number" class="form-control" value="1" id="maxDevicesInput" min="1" max="999"></div>
    <div class="mb-3"><label>Thời hạn</label><select name="duration" class="form-select"><option value="1">1 ngày</option><option value="7">7 ngày</option><option value="15">15 ngày</option><option value="30">30 ngày</option><option value="90">90 ngày</option><option value="365">1 năm</option><option value="forever">Vĩnh viễn</option></select></div>
  </div><div class="modal-footer"><button type="submit" class="btn btn-primary">Tạo Key</button></div></form>
</div></div></div>
<%- include('../partials/scripts') %>
<script>
  document.getElementById('tierSelect').addEventListener('change', function(){ document.getElementById('maxDevicesInput').value = this.value==='VIP'?1:9; });
  document.querySelectorAll('.view-devices-btn').forEach(btn => {
    btn.addEventListener('click', async function(){
      const keyId = this.dataset.keyId;
      const body = document.getElementById('devicesModalBody');
      body.innerHTML = '<p class="text-center text-muted">Đang tải...</p>';
      new bootstrap.Modal(document.getElementById('devicesModal')).show();
      try {
        const res = await fetch(`/admin/keys/devices/${keyId}`);
        const data = await res.json();
        if(data.success && data.devices.length){
          let html = '<table class="table table-sm"><thead><tr><th>HWID</th><th>Tên</th><th>Trạng thái</th><th>Ngày thêm</th><th></th></tr></thead><tbody>';
          data.devices.forEach(d => {
            html += `<tr><td><code>${d.hwid}</code></td><td>${d.device_name||'Chưa đặt'}</td><td><span class="badge bg-${d.is_active?'success':'danger'}">${d.is_active?'Active':'Bị khóa'}</span></td><td>${new Date(d.createdAt).toLocaleString('vi-VN')}</td>
            <td><form method="POST" action="/admin/keys/toggle-device/${d.id}" class="d-inline"><button class="btn btn-sm btn-${d.is_active?'warning':'success'}">${d.is_active?'Khóa':'Mở'}</button></form>
            <form method="POST" action="/admin/keys/unbind-device/${d.id}" class="d-inline" onsubmit="return confirm('Xóa vĩnh viễn?')"><button class="btn btn-sm btn-danger">Xóa</button></form></td></tr>`;
          });
          body.innerHTML = html + '</tbody></table>';
        } else body.innerHTML = '<p class="text-center text-muted">Chưa có thiết bị.</p>';
      } catch(e){ body.innerHTML = '<p class="text-danger">Lỗi tải dữ liệu.</p>'; }
    });
  });
</script>
