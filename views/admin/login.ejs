<%- include('../partials/header', { title: 'Đăng nhập' }) %>
<div class="d-flex justify-content-center align-items-center" style="min-height: 100vh; padding: 20px;">
  <div class="cloud-card anim-in" style="max-width: 440px; width: 100%; padding: 44px 40px;">
    <div class="text-center mb-4">
      <div class="logo-icon mx-auto mb-3" style="width: 72px; height: 72px; border-radius: 22px; background: linear-gradient(135deg, #38bdf8, #2563eb); display: flex; align-items: center; justify-content: center; color: #fff; font-size: 1.9rem; box-shadow: 0 12px 32px rgba(59,130,246,0.4);">
        <i class="fas fa-cloud"></i>
      </div>
      <h1 style="font-weight: 800; font-size: 1.8rem; color: var(--text); margin: 0; letter-spacing: -0.5px;">
        DPIConfig HoangPhu
      </h1>
      <p style="color: var(--text-muted); margin-top: 8px; font-size: 0.9rem;">
        Hệ thống quản lý bản quyền
      </p>
    </div>

    <% if (error) { %>
      <div style="background: rgba(239,68,68,0.08); border: 1px solid rgba(239,68,68,0.25); color: #dc2626; padding: 12px 16px; border-radius: 10px; margin-bottom: 20px; font-size: 0.88rem; font-weight: 500;">
        <i class="fas fa-exclamation-circle me-2"></i><%= error %>
      </div>
    <% } %>

    <form method="POST" action="/admin/login">
      <div class="mb-3">
        <label class="form-label" style="font-weight: 700; font-size: 0.78rem; color: var(--sky-7); letter-spacing: 0.5px; text-transform: uppercase;">Email</label>
        <input type="email" name="email" class="form-control" placeholder="admin@dpiconfig.com" required autofocus
               style="background: rgba(240,249,255,0.6); border: 1.5px solid var(--sky-2); color: var(--text); border-radius: 10px; padding: 12px 16px; font-weight: 500;">
      </div>
      <div class="mb-4">
        <label class="form-label" style="font-weight: 700; font-size: 0.78rem; color: var(--sky-7); letter-spacing: 0.5px; text-transform: uppercase;">Mật khẩu</label>
        <input type="password" name="password" class="form-control" placeholder="••••••••" required
               style="background: rgba(240,249,255,0.6); border: 1.5px solid var(--sky-2); color: var(--text); border-radius: 10px; padding: 12px 16px; font-weight: 500;">
      </div>
      <button type="submit" class="btn-cloud w-100" style="justify-content: center; padding: 14px;">
        <i class="fas fa-sign-in-alt"></i> Đăng nhập
      </button>
    </form>

    <p class="text-center mt-4" style="color: var(--text-muted); font-size: 0.82rem;">
      © 2025 HoangPhu · Duy
    </p>
  </div>
</div>
<%- include('../partials/scripts') %>
