<%- include('../partials/header', { title: 'Nhật ký hệ thống', pageName: 'Logs', user }) %>
<div class="d-flex">
  <%- include('../partials/sidebar', { user, currentPage: 'logs', activeKeys }) %>
  <div class="vg-main flex-grow-1">
    <div class="sn-hero anim d1">
      <div>
        <h1 class="sn-hero-greet">📋 Nhật ký Hoạt động</h1>
        <p class="sn-hero-sub">Theo dõi mọi thao tác trên hệ thống</p>
      </div>
    </div>
    <div class="vg-card anim d2" style="padding: 0;">
      <table class="vg-table">
        <thead>
          <tr>
            <th>Thời gian</th>
            <th>Hành động</th>
            <th>Chi tiết</th>
            <th>IP</th>
          </tr>
        </thead>
        <tbody>
          <% logs.forEach(l => { %>
            <tr>
              <td style="color:#4fc3f7"><%= new Date(l.createdAt).toLocaleString('vi-VN') %></td>
              <td><span class="sn-badge"><%= l.action %></span></td>
              <td style="color:#b8c5d9"><%= l.details %></td>
              <td><code><%= l.ip_address %></code></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/scripts') %>
