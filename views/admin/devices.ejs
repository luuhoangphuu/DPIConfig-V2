<%- include('../partials/header', { title: 'Quản lý Thiết bị', pageName: 'Thiết bị', user }) %>
<div class="d-flex">
  <%- include('../partials/sidebar', { user, currentPage: 'devices', activeKeys }) %>
  <div class="vg-main flex-grow-1">
    <div class="sn-hero anim d1">
      <div>
        <h1 class="sn-hero-greet">📱 Quản lý Thiết bị</h1>
        <p class="sn-hero-sub">Xem toàn bộ HWID đang hoạt động, khóa thiết bị từ xa</p>
      </div>
    </div>
    <div class="vg-card anim d2" style="padding: 0;">
      <table class="vg-table">
        <thead>
          <tr>
            <th>HWID</th>
            <th>Tên Thiết Bị</th>
            <th>Thuộc Key</th>
            <th>Trạng thái</th>
            <th>Ngày kích hoạt</th>
          </tr>
        </thead>
        <tbody>
          <% devices.forEach(d => { %>
            <tr>
              <td><code><%= d.hwid.substring(0, 20) %>...</code></td>
              <td><%= d.device_name || 'Chưa đặt tên' %></td>
              <td><span style="color:#4fc3f7"><%= d.Key ? d.Key.key : 'N/A' %></span></td>
              <td><%= d.is_active ? '✅ Hoạt động' : '❌ Bị khóa' %></td>
              <td><%= new Date(d.createdAt).toLocaleString('vi-VN') %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/scripts') %>
