<%- include('../partials/header', { title: 'Quản lý Token' }) %>
<div class="d-flex">
  <%- include('../partials/sidebar', { user, currentPage: 'tokens' }) %>
  <div class="main-content flex-grow-1">
    <div class="d-flex justify-content-between align-items-center mb-4 animate__animated animate__fadeInDown">
      <h4 class="fw-bold mb-0">Token Get Key</h4>
      <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createTokenModal">
        <i class="fas fa-plus me-1"></i> Tạo Token
      </button>
    </div>

    <% if (typeof newToken !== 'undefined') { %>
    <div class="alert alert-success animate__animated animate__fadeInUp">
      <strong>Token mới:</strong> <code><%= newToken %></code><br>
      <% if (typeof shortLink !== 'undefined' && shortLink) { %>
        <strong>Link ngắn:</strong> <a href="<%= shortLink %>" target="_blank"><%= shortLink %></a>
        <button class="btn btn-sm btn-outline-primary ms-2" onclick="navigator.clipboard.writeText('<%= shortLink %>')">Copy</button>
        <br>
      <% } %>
      <strong>Link claim:</strong> <code><%= claimUrl %></code>
    </div>
    <% } %>

    <div class="table-responsive">
      <table class="table-custom w-100">
        <thead><tr><th>Token</th><th>Key</th><th>Đã dùng</th><th>Ngày tạo</th><th></th></tr></thead>
        <tbody>
          <% tokens.forEach(t => { %>
            <tr>
              <td><code><%= t.token %></code></td>
              <td><%= t.key %></td>
              <td><span class="badge bg-<%= t.used ? 'success' : 'warning' %>"><%= t.used ? 'Đã dùng' : 'Chưa dùng' %></span></td>
              <td><%= new Date(t.createdAt).toLocaleString('vi-VN') %></td>
              <td>
                <form method="POST" action="/admin/tokens/delete/<%= t.id %>" onsubmit="return confirm('Xóa token này?')">
                  <button class="btn btn-sm btn-outline text-danger"><i class="fas fa-trash"></i></button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="modal fade" id="createTokenModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
  <div class="modal-header"><h5 class="modal-title">Tạo Token Mới</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
  <form method="POST" action="/admin/tokens/create">
    <div class="modal-body">
      <div class="mb-3"><label class="form-label">Key muốn gán</label><input name="key" class="form-control" placeholder="Nhập key cần cấp" required></div>
    </div>
    <div class="modal-footer"><button type="submit" class="btn btn-primary">Tạo Token</button></div>
  </form>
</div></div></div>
<%- include('../partials/scripts') %>
