<%- include('../partials/header', { title: 'Dashboard' }) %>
<div class="d-flex">
  <%- include('../partials/sidebar', { user, currentPage: 'dashboard' }) %>
  <div class="main-content flex-grow-1">
    <h4 class="fw-bold mb-4">Tổng quan hệ thống</h4>
    <div class="row g-4 mb-5">
      <div class="col-md-3 animate__animated animate__fadeInUp">
        <div class="stat-card">
          <div class="stat-label">Tổng Key</div>
          <div class="stat-value"><%= totalKeys %></div>
        </div>
      </div>
      <div class="col-md-3 animate__animated animate__fadeInUp animate__delay-1s">
        <div class="stat-card">
          <div class="stat-label">Đang hoạt động</div>
          <div class="stat-value" style="color:#059669;"><%= activeKeys %></div>
        </div>
      </div>
      <div class="col-md-3 animate__animated animate__fadeInUp animate__delay-2s">
        <div class="stat-card">
          <div class="stat-label">Hết hạn</div>
          <div class="stat-value" style="color:#DC2626;"><%= expiredKeys %></div>
        </div>
      </div>
      <div class="col-md-3 animate__animated animate__fadeInUp animate__delay-3s">
        <div class="stat-card">
          <div class="stat-label">Thiết bị đã kích hoạt</div>
          <div class="stat-value" style="color:#D97706;"><%= devicesActivated %></div>
        </div>
      </div>
    </div>

    <h5 class="fw-bold mb-3">Hoạt động gần đây</h5>
    <div class="table-responsive">
      <table class="table-custom w-100">
        <thead><tr><th>Thời gian</th><th>Hành động</th><th>Chi tiết</th></tr></thead>
        <tbody>
          <% recentLogs.forEach(log => { %>
            <tr>
              <td class="text-muted" style="font-size:0.85rem;"><%= new Date(log.createdAt).toLocaleString('vi-VN') %></td>
              <td><span class="badge bg-primary bg-opacity-10 text-primary"><%= log.action %></span></td>
              <td class="text-muted"><%= log.details %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/scripts') %>
