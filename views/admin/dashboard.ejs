<%- include('../partials/header', { title: 'Dashboard' }) %>
<div class="d-flex">
  <%- include('../partials/sidebar', { user, currentPage: 'dashboard' }) %>
  <div class="main-content flex-grow-1">
    <h4 class="fw-bold mb-4 animate__animated animate__fadeInDown" style="font-family:'Orbitron'; color: var(--neon-blue);">
      <i class="fas fa-satellite me-2"></i>SYSTEM STATUS
    </h4>
    <div class="row g-4 mb-4">
      <div class="col-md-3 animate__animated animate__fadeInUp">
        <div class="glass-card stat-card">
          <div class="label">TOTAL KEYS</div>
          <div class="value" style="color: var(--neon-blue);"><%= totalKeys %></div>
        </div>
      </div>
      <div class="col-md-3 animate__animated animate__fadeInUp animate__delay-1s">
        <div class="glass-card stat-card">
          <div class="label">ACTIVE</div>
          <div class="value" style="color: #10b981;"><%= activeKeys %></div>
        </div>
      </div>
      <div class="col-md-3 animate__animated animate__fadeInUp animate__delay-2s">
        <div class="glass-card stat-card">
          <div class="label">EXPIRED</div>
          <div class="value" style="color: #ef4444;"><%= expiredKeys %></div>
        </div>
      </div>
      <div class="col-md-3 animate__animated animate__fadeInUp animate__delay-3s">
        <div class="glass-card stat-card">
          <div class="label">DEVICES</div>
          <div class="value" style="color: #fbbf24;"><%= devicesActivated %></div>
        </div>
      </div>
    </div>

    <div class="row g-4 mb-4">
      <div class="col-md-6 animate__animated animate__fadeInUp animate__delay-4s">
        <div class="glass-card">
          <h6 class="fw-bold mb-3" style="font-family:'Orbitron';">KEY TIER DISTRIBUTION</h6>
          <canvas id="tierChart" height="200"></canvas>
        </div>
      </div>
      <div class="col-md-6 animate__animated animate__fadeInUp animate__delay-4s">
        <div class="glass-card">
          <h6 class="fw-bold mb-3" style="font-family:'Orbitron';">RECENT ACTIVITY</h6>
          <div class="timeline">
            <% recentLogs.forEach(log => { %>
              <div class="d-flex mb-3 align-items-center">
                <div class="bg-primary rounded-circle p-2 me-3"><i class="fas fa-circle text-white" style="font-size:0.5rem;"></i></div>
                <div>
                  <small class="text-muted"><%= new Date(log.createdAt).toLocaleString('vi-VN') %></small><br>
                  <span class="badge bg-primary me-2"><%= log.action %></span>
                  <span class="text-muted"><%= log.details %></span>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/scripts') %>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
  new Chart(document.getElementById('tierChart'), {
    type: 'doughnut',
    data: {
      labels: ['VIP', 'Normal'],
      datasets: [{ data: [<%= vipKeys %>, <%= totalKeys - vipKeys %>], backgroundColor: ['#fbbf24','#6b7280'], borderWidth: 0 }]
    },
    options: { responsive: true, plugins: { legend: { position: 'bottom', labels: { color: 'white' } } } }
  });
</script>
