<%- include('../partials/header', { title: 'Dashboard' }) %>
<div class="d-flex">
  <%- include('../partials/sidebar', { user, currentPage: 'dashboard' }) %>
  <div class="main-content flex-grow-1">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2 class="glitch fw-bold" data-text="SYSTEM OVERVIEW">SYSTEM OVERVIEW</h2>
      <div class="text-end text-white-50">
        <i class="fas fa-clock me-2"></i><span id="liveTime">00:00:00</span>
      </div>
    </div>

    <div class="row g-4 mb-4">
      <div class="col-xl-3 col-md-6">
        <div class="cyber-card p-3">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <span class="text-uppercase small" style="color: var(--neon-cyan);">Total Keys</span>
              <h2 class="fw-bold mb-0" id="countTotal" data-target="<%= totalKeys %>">0</h2>
            </div>
            <i class="fas fa-database fa-2x" style="color: var(--neon-cyan); opacity: 0.5;"></i>
          </div>
        </div>
      </div>
      <div class="col-xl-3 col-md-6">
        <div class="cyber-card p-3">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <span class="text-uppercase small" style="color: #2ecc71;">Active</span>
              <h2 class="fw-bold mb-0" id="countActive" data-target="<%= activeKeys %>">0</h2>
            </div>
            <i class="fas fa-check-shield fa-2x" style="color: #2ecc71; opacity: 0.5;"></i>
          </div>
        </div>
      </div>
      <div class="col-xl-3 col-md-6">
        <div class="cyber-card p-3">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <span class="text-uppercase small" style="color: #e74c3c;">Expired</span>
              <h2 class="fw-bold mb-0" id="countExpired" data-target="<%= expiredKeys %>">0</h2>
            </div>
            <i class="fas fa-radiation-alt fa-2x" style="color: #e74c3c; opacity: 0.5;"></i>
          </div>
        </div>
      </div>
      <div class="col-xl-3 col-md-6">
        <div class="cyber-card p-3">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <span class="text-uppercase small" style="color: #f093fb;">Devices</span>
              <h2 class="fw-bold mb-0" id="countDevices" data-target="<%= devicesActivated %>">0</h2>
            </div>
            <i class="fas fa-microchip fa-2x" style="color: #f093fb; opacity: 0.5;"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="card bg-transparent border-0">
      <div class="card-header bg-transparent border-bottom border-neon-cyan fw-bold text-uppercase">Recent Activity</div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-cyber">
            <thead><tr><th>Timestamp</th><th>Action</th><th>Details</th></tr></thead>
            <tbody>
              <% recentLogs.forEach(log => { %>
                <tr>
                  <td><%= new Date(log.createdAt).toLocaleString('vi-VN') %></td>
                  <td><span class="badge bg-outline-neon"><%= log.action %></span></td>
                  <td><%= log.details %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/scripts') %>
<script src="https://cdn.jsdelivr.net/npm/countup.js@2.5.0/dist/countUp.umd.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    new countUp.CountUp('countTotal', <%= totalKeys %>).start();
    new countUp.CountUp('countActive', <%= activeKeys %>).start();
    new countUp.CountUp('countExpired', <%= expiredKeys %>).start();
    new countUp.CountUp('countDevices', <%= devicesActivated %>).start();
    
    // Live Clock
    function updateClock() {
      const now = new Date();
      document.getElementById('liveTime').textContent = now.toLocaleTimeString('vi-VN');
    }
    setInterval(updateClock, 1000);
    updateClock();
  });
</script>
