<%- include('../partials/header', { title: 'Dashboard' }) %>
<div class="d-flex">
  <%- include('../partials/sidebar', { user, currentPage: 'dashboard' }) %>
  <div class="main-content flex-grow-1">
    <h2 class="fw-bold mb-4"><i class="fas fa-chart-line me-2 text-primary"></i>Tổng quan</h2>
    <div class="row g-4 mb-4">
      <div class="col-xl-3 col-md-6"><div class="card card-stats bg-primary p-3"><div class="d-flex justify-content-between align-items-center"><div><h6>Tổng Key</h6><h2><%= totalKeys %></h2></div><i class="fas fa-key icon-bg"></i></div></div></div>
      <div class="col-xl-3 col-md-6"><div class="card card-stats bg-success p-3"><div class="d-flex justify-content-between align-items-center"><div><h6>Đang hoạt động</h6><h2><%= activeKeys %></h2></div><i class="fas fa-check-circle icon-bg"></i></div></div></div>
      <div class="col-xl-3 col-md-6"><div class="card card-stats bg-danger p-3"><div class="d-flex justify-content-between align-items-center"><div><h6>Hết hạn</h6><h2><%= expiredKeys %></h2></div><i class="fas fa-exclamation-triangle icon-bg"></i></div></div></div>
      <div class="col-xl-3 col-md-6"><div class="card card-stats bg-warning p-3"><div class="d-flex justify-content-between align-items-center"><div><h6>VIP</h6><h2><%= vipKeys %></h2></div><i class="fas fa-crown icon-bg"></i></div></div></div>
    </div>
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white fw-bold fs-5"><i class="fas fa-history me-2 text-primary"></i>Hoạt động gần đây</div>
      <div class="card-body p-0"><table class="table table-hover mb-0"><thead class="table-light"><tr><th>Thời gian</th><th>Hành động</th><th>Chi tiết</th></tr></thead><tbody>
      <% recentLogs.forEach(log => { %><tr><td><%= new Date(log.createdAt).toLocaleString('vi-VN') %></td><td><span class="badge bg-primary"><%= log.action %></span></td><td><%= log.details %></td></tr><% }) %>
      </tbody></table></div>
    </div>
  </div>
</div>
<%- include('../partials/scripts') %>
