<%- include('../partials/header', { title: 'Dashboard' }) %>
<div class="d-flex">
  <%- include('../partials/sidebar', { user, currentPage: 'dashboard' }) %>
  <div class="main-content flex-grow-1">
    <h2 class="fw-bold mb-4 animate__animated animate__fadeInDown"><i class="fas fa-chart-line me-2" style="color: var(--primary);"></i>Tổng quan</h2>
    <div class="row g-4 mb-4">
      <div class="col-xl-3 col-md-6"><div class="card card-stats p-3" style="background: linear-gradient(45deg, #6C5CE7, #A29BFE);"><div class="d-flex justify-content-between"><div><h6>Tổng Key</h6><h2 id="countTotal" data-target="<%= totalKeys %>">0</h2></div><i class="fas fa-key" style="font-size:4rem;opacity:0.2;"></i></div></div></div>
      <div class="col-xl-3 col-md-6"><div class="card card-stats p-3" style="background: linear-gradient(45deg, #00B894, #55EFC4);"><div class="d-flex justify-content-between"><div><h6>Hoạt động</h6><h2 id="countActive" data-target="<%= activeKeys %>">0</h2></div><i class="fas fa-check-circle" style="font-size:4rem;opacity:0.2;"></i></div></div></div>
      <div class="col-xl-3 col-md-6"><div class="card card-stats p-3" style="background: linear-gradient(45deg, #E17055, #FDCB6E);"><div class="d-flex justify-content-between"><div><h6>Hết hạn</h6><h2 id="countExpired" data-target="<%= expiredKeys %>">0</h2></div><i class="fas fa-exclamation-triangle" style="font-size:4rem;opacity:0.2;"></i></div></div></div>
      <div class="col-xl-3 col-md-6"><div class="card card-stats p-3" style="background: linear-gradient(45deg, #FD79A8, #E84393);"><div class="d-flex justify-content-between"><div><h6>Thiết bị</h6><h2 id="countDevices" data-target="<%= devicesActivated %>">0</h2></div><i class="fas fa-mobile-alt" style="font-size:4rem;opacity:0.2;"></i></div></div></div>
    </div>
    <div class="row mb-4">
      <div class="col-md-6"><div class="card"><div class="card-header">Phân phối hạng</div><div class="card-body"><canvas id="tierChart" height="200"></canvas></div></div></div>
      <div class="col-md-6"><div class="card"><div class="card-header">Trạng thái</div><div class="card-body"><canvas id="statusChart" height="200"></canvas></div></div></div>
    </div>
    <div class="card"><div class="card-header fw-bold">Hoạt động gần đây</div><div class="card-body p-0"><table class="table table-hover mb-0"><thead><tr><th>Thời gian</th><th>Hành động</th><th>Chi tiết</th></tr></thead><tbody>
      <% recentLogs.forEach(log => { %><tr><td><%= new Date(log.createdAt).toLocaleString('vi-VN') %></td><td><span class="badge bg-primary"><%= log.action %></span></td><td><%= log.details %></td></tr><% }) %>
    </tbody></table></div></div>
  </div>
</div>
<%- include('../partials/scripts') %>
<script src="https://cdn.jsdelivr.net/npm/countup.js@2.5.0/dist/countUp.umd.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    new countUp.CountUp('countTotal', <%= totalKeys %>).start();
    new countUp.CountUp('countActive', <%= activeKeys %>).start();
    new countUp.CountUp('countExpired', <%= expiredKeys %>).start();
    new countUp.CountUp('countDevices', <%= devicesActivated %>).start();

    new Chart(document.getElementById('tierChart'), {
      type: 'doughnut',
      data: { labels: ['VIP', 'Normal'], datasets: [{ data: [<%= vipKeys %>, <%= totalKeys - vipKeys %>], backgroundColor: ['#FD79A8','#B2BEC3'] }] }
    });
    new Chart(document.getElementById('statusChart'), {
      type: 'pie',
      data: { labels: ['Hoạt động','Hết hạn','Khoá'], datasets: [{ data: [<%= activeKeys %>, <%= expiredKeys %>, <%= totalKeys - activeKeys - expiredKeys %>], backgroundColor: ['#00B894','#E17055','#FDCB6E'] }] }
    });
  });
</script>
