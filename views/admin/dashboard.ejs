<%- include('../partials/header', { title: 'Dashboard' }) %>
<div class="d-flex">
  <%- include('../partials/sidebar', { user, currentPage: 'dashboard' }) %>
  <div class="main-content flex-grow-1">
    <h2 class="fw-bold mb-4 animate__animated animate__fadeInDown" style="color: #00f2fe;"><i class="fas fa-chart-line me-2"></i>Tổng quan hệ thống</h2>
    <div class="row g-4 mb-4">
      <div class="col-xl-3 col-md-6 animate__animated animate__fadeInUp">
        <div class="card-stats p-3 position-relative">
          <div class="d-flex justify-content-between"><div><h6>Tổng Key</h6><h2 id="countTotal" data-target="<%= totalKeys %>">0</h2></div><i class="fas fa-key icon-bg"></i></div>
        </div>
      </div>
      <div class="col-xl-3 col-md-6 animate__animated animate__fadeInUp animate__delay-1s">
        <div class="card-stats p-3 position-relative">
          <div class="d-flex justify-content-between"><div><h6>Đang hoạt động</h6><h2 id="countActive" data-target="<%= activeKeys %>">0</h2></div><i class="fas fa-check-circle icon-bg"></i></div>
        </div>
      </div>
      <div class="col-xl-3 col-md-6 animate__animated animate__fadeInUp animate__delay-2s">
        <div class="card-stats p-3 position-relative">
          <div class="d-flex justify-content-between"><div><h6>Hết hạn</h6><h2 id="countExpired" data-target="<%= expiredKeys %>">0</h2></div><i class="fas fa-exclamation-triangle icon-bg"></i></div>
        </div>
      </div>
      <div class="col-xl-3 col-md-6 animate__animated animate__fadeInUp animate__delay-3s">
        <div class="card-stats p-3 position-relative">
          <div class="d-flex justify-content-between"><div><h6>Thiết bị đã kích hoạt</h6><h2 id="countDevices" data-target="<%= devicesActivated %>">0</h2></div><i class="fas fa-mobile-alt icon-bg"></i></div>
        </div>
      </div>
    </div>
    <div class="card bg-transparent border-0 shadow-none"><div class="card-header fw-bold" style="color: #00f2fe;">Hoạt động gần đây</div><div class="card-body p-0"><table class="table table-hover table-keys"><thead><tr><th>Thời gian</th><th>Hành động</th><th>Chi tiết</th></tr></thead><tbody>
      <% recentLogs.forEach(log => { %><tr><td><%= new Date(log.createdAt).toLocaleString('vi-VN') %></td><td><span class="badge bg-info"><%= log.action %></span></td><td><%= log.details %></td></tr><% }) %>
    </tbody></table></div></div>
  </div>
</div>
<%- include('../partials/scripts') %>
<script src="https://cdn.jsdelivr.net/npm/countup.js@2.5.0/dist/countUp.umd.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    new countUp.CountUp('countTotal', <%= totalKeys %>).start();
    new countUp.CountUp('countActive', <%= activeKeys %>).start();
    new countUp.CountUp('countExpired', <%= expiredKeys %>).start();
    new countUp.CountUp('countDevices', <%= devicesActivated %>).start();
  });
</script>
