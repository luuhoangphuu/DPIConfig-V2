<%- include('../partials/header', { title: 'Dashboard' }) %>
<div class="d-flex">
  <%- include('../partials/sidebar', { user, currentPage: 'dashboard' }) %>
  <div class="main-content flex-grow-1">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h4 class="fw-bold mb-0">Tổng quan hệ thống</h4>
      <div>
        <span class="badge bg-<%= showAll ? 'success' : 'secondary' %> me-2">
          <%= showAll ? 'Đang hiển thị tất cả' : 'Đã ẩn log check' %>
        </span>
        <a href="?show=<%= showAll ? '' : 'all' %>" class="btn btn-outline btn-sm">
          <i class="fas <%= showAll ? 'fa-filter' : 'fa-list' %> me-1"></i>
          <%= showAll ? 'Ẩn log check' : 'Hiển thị tất cả' %>
        </a>
      </div>
    </div>

    <div class="row g-4 mb-5">
      <div class="col-md-3 animate__animated animate__fadeInUp">
        <div class="stat-card">
          <div class="stat-icon" style="background: rgba(108,92,231,0.15); color: #6C5CE7;">
            <i class="fas fa-key"></i>
          </div>
          <div>
            <div class="stat-label">Tổng Key</div>
            <div class="stat-value"><%= totalKeys %></div>
          </div>
        </div>
      </div>
      <div class="col-md-3 animate__animated animate__fadeInUp animate__delay-1s">
        <div class="stat-card">
          <div class="stat-icon" style="background: rgba(5,150,105,0.15); color: #059669;">
            <i class="fas fa-check-circle"></i>
          </div>
          <div>
            <div class="stat-label">Đang hoạt động</div>
            <div class="stat-value" style="color:#059669;"><%= activeKeys %></div>
          </div>
        </div>
      </div>
      <div class="col-md-3 animate__animated animate__fadeInUp animate__delay-2s">
        <div class="stat-card">
          <div class="stat-icon" style="background: rgba(220,38,38,0.15); color: #DC2626;">
            <i class="fas fa-exclamation-triangle"></i>
          </div>
          <div>
            <div class="stat-label">Hết hạn</div>
            <div class="stat-value" style="color:#DC2626;"><%= expiredKeys %></div>
          </div>
        </div>
      </div>
      <div class="col-md-3 animate__animated animate__fadeInUp animate__delay-3s">
        <div class="stat-card">
          <div class="stat-icon" style="background: rgba(217,119,6,0.15); color: #D97706;">
            <i class="fas fa-mobile-alt"></i>
          </div>
          <div>
            <div class="stat-label">Thiết bị đã kích hoạt</div>
            <div class="stat-value" style="color:#D97706;"><%= devicesActivated %></div>
          </div>
        </div>
      </div>
    </div>

    <h5 class="fw-bold mb-3">Hoạt động gần đây (20 log mới nhất)</h5>
    <div class="table-responsive">
      <table class="table-custom w-100">
        <thead><tr><th>Thời gian</th><th>Hành động</th><th>Chi tiết</th></tr></thead>
        <tbody>
          <% recentLogs.forEach(log => { %>
            <tr>
              <td class="text-muted" style="font-size:0.85rem;"><%= new Date(log.createdAt).toLocaleString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh' }) %></td>
              <td><span class="badge bg-primary bg-opacity-10 text-primary"><%= log.action %></span></td>
              <td class="text-muted"><%= log.details %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% if (recentLogs.length === 0) { %>
      <p class="text-muted text-center mt-3">Không có hoạt động nào trong 24 giờ qua.</p>
    <% } %>
  </div>
</div>
<%- include('../partials/scripts') %>
