<%- include('../partials/header', { title: 'Dashboard' }) %>
<div class="d-flex">
  <%- include('../partials/sidebar', { user, currentPage: 'dashboard' }) %>
  <div class="main-content flex-grow-1">
    <h4 class="fw-bold mb-4 typing-text animate__animated animate__fadeInDown" style="color:#0f0;">
      <i class="fas fa-terminal me-2"></i>system_status
    </h4>

    <div class="row g-4 mb-4">
      <div class="col-xl-3 col-md-6 animate__animated animate__fadeInUp">
        <div class="stat-card">
          <div class="d-flex justify-content-between align-items-start mb-3">
            <span class="stat-icon">KEY</span>
            <span class="text-muted small">total</span>
          </div>
          <h3 class="fw-bold mb-0" style="color:#0f0;" id="countTotal"><%= totalKeys %></h3>
        </div>
      </div>
      <div class="col-xl-3 col-md-6 animate__animated animate__fadeInUp animate__delay-1s">
        <div class="stat-card">
          <div class="d-flex justify-content-between align-items-start mb-3">
            <span class="stat-icon">ACT</span>
            <span class="text-muted small">active</span>
          </div>
          <h3 class="fw-bold mb-0" style="color:#0f0;" id="countActive"><%= activeKeys %></h3>
        </div>
      </div>
      <div class="col-xl-3 col-md-6 animate__animated animate__fadeInUp animate__delay-2s">
        <div class="stat-card">
          <div class="d-flex justify-content-between align-items-start mb-3">
            <span class="stat-icon">EXP</span>
            <span class="text-muted small">expired</span>
          </div>
          <h3 class="fw-bold mb-0" style="color:#f00;" id="countExpired"><%= expiredKeys %></h3>
        </div>
      </div>
      <div class="col-xl-3 col-md-6 animate__animated animate__fadeInUp animate__delay-3s">
        <div class="stat-card">
          <div class="d-flex justify-content-between align-items-start mb-3">
            <span class="stat-icon">DEV</span>
            <span class="text-muted small">devices</span>
          </div>
          <h3 class="fw-bold mb-0" style="color:#0f0;" id="countDevices"><%= devicesActivated %></h3>
        </div>
      </div>
    </div>

    <div class="stat-card p-3 animate__animated animate__fadeInUp animate__delay-4s">
      <h6 class="fw-bold mb-3" style="color:#0f0;">[recent_activity]</h6>
      <div class="table-responsive">
        <table class="table-custom w-100">
          <thead><tr><th>Timestamp</th><th>Action</th><th>Details</th></tr></thead>
          <tbody>
            <% recentLogs.forEach(log => { %>
              <tr>
                <td class="small"><%= new Date(log.createdAt).toLocaleString('vi-VN') %></td>
                <td><span class="badge-hacker"><%= log.action %></span></td>
                <td><%= log.details %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/scripts') %>
<script src="https://cdn.jsdelivr.net/npm/countup.js@2.5.0/dist/countUp.umd.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const opts = { duration: 1.5, useEasing: true };
    new countUp.CountUp('countTotal', <%= totalKeys %>, opts).start();
    new countUp.CountUp('countActive', <%= activeKeys %>, opts).start();
    new countUp.CountUp('countExpired', <%= expiredKeys %>, opts).start();
    new countUp.CountUp('countDevices', <%= devicesActivated %>, opts).start();
  });
</script>
