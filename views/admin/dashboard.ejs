<%- include('../partials/header', { title: 'Bảng điều khiển', pageName: 'Dashboard', user }) %>
<div class="d-flex">
  <%- include('../partials/sidebar', { user, currentPage: 'dashboard', activeKeys }) %>
  <div class="vg-main flex-grow-1">

    <!-- HERO -->
    <div class="sn-hero anim d1" style="margin-bottom: 24px;">
      <div>
        <h1 class="sn-hero-greet" id="snGreet">Xin chào 👋</h1>
        <p class="sn-hero-sub">Chào mừng trở lại, <b><%= user.name || user.email.split('@')[0] %></b> · <span id="snToday">--</span></p>
      </div>
      <div class="sn-quick-actions">
        <a href="/yncuti/keys" class="sn-quick-btn"><i class="fas fa-plus-circle"></i> Tạo Key mới</a>
      </div>
    </div>

    <!-- 4 THẺ THỐNG KÊ -->
    <div class="sn-stat-grid anim d2">
      <div class="sn-stat total">
        <div class="sn-stat-icon"><i class="fas fa-key"></i></div>
        <div class="sn-stat-label">Tổng Key</div>
        <div class="sn-stat-value sn-animate-num" data-count="<%= totalKeys %>">0</div>
      </div>
      <div class="sn-stat active">
        <div class="sn-stat-icon"><i class="fas fa-check-circle"></i></div>
        <div class="sn-stat-label">Đang hoạt động</div>
        <div class="sn-stat-value sn-animate-num" data-count="<%= activeKeys %>">0</div>
      </div>
      <div class="sn-stat expired">
        <div class="sn-stat-icon"><i class="fas fa-clock"></i></div>
        <div class="sn-stat-label">Đã hết hạn</div>
        <div class="sn-stat-value sn-animate-num" data-count="<%= expiredKeys %>">0</div>
      </div>
      <div class="sn-stat devices">
        <div class="sn-stat-icon"><i class="fas fa-mobile-alt"></i></div>
        <div class="sn-stat-label">Thiết bị kích hoạt</div>
        <div class="sn-stat-value sn-animate-num" data-count="<%= devicesActivated %>">0</div>
      </div>
    </div>

    
    <!-- BIỂU ĐỒ 7 NGÀY -->
    <div class="sn-chart-card anim d3">
      <div class="sn-chart-header">
        <h3 class="sn-chart-title"><i class="fas fa-chart-line" style="color:#4fc3f7"></i> Key tạo mới (7 ngày qua)</h3>
      </div>
      <div style="height: 300px; width: 100%;">
        <canvas id="keyChart"></canvas>
      </div>
    </div>
  
    <!-- CÁC Ô CHỨC NĂNG (MODULES) -->
    <div class="sn-workspace-grid anim d3">
      
      <a href="/yncuti/keys" class="sn-module-card mc-key">
        <div class="sn-mc-header">
          <div class="sn-mc-icon"><i class="fas fa-key"></i></div>
          <div><h3 class="sn-mc-title">Quản lý Key</h3><div class="sn-mc-sub">Tạo, khóa và xem thiết bị</div></div>
        </div>
        <div class="sn-mc-body">
          <div class="sn-mc-stat"><%= totalKeys %> <span>Keys</span></div>
          <div class="sn-mc-action"><i class="fas fa-arrow-right"></i></div>
        </div>
      </a>

      <% if (isSuper) { %>
        <a href="/yncuti/announcements" class="sn-module-card mc-noti">
          <div class="sn-mc-header">
            <div class="sn-mc-icon"><i class="fas fa-bullhorn"></i></div>
            <div><h3 class="sn-mc-title">Thông báo</h3><div class="sn-mc-sub">Gửi tin nhắn đến App</div></div>
          </div>
          <div class="sn-mc-body"><div class="sn-mc-stat" style="font-size:1.1rem; color:#b8c5d9;">Viết thông báo</div><div class="sn-mc-action"><i class="fas fa-arrow-right"></i></div></div>
        </a>

        <a href="/yncuti/sellers" class="sn-module-card mc-seller">
          <div class="sn-mc-header">
            <div class="sn-mc-icon"><i class="fas fa-store"></i></div>
            <div><h3 class="sn-mc-title">Người bán</h3><div class="sn-mc-sub">Quản lý đại lý & Token</div></div>
          </div>
          <div class="sn-mc-body"><div class="sn-mc-stat"><%= topSellers.length %> <span>Đối tác</span></div><div class="sn-mc-action"><i class="fas fa-arrow-right"></i></div></div>
        </a>

        <a href="/yncuti/admins" class="sn-module-card mc-admin">
          <div class="sn-mc-header">
            <div class="sn-mc-icon"><i class="fas fa-user-shield"></i></div>
            <div><h3 class="sn-mc-title">Quản trị viên</h3><div class="sn-mc-sub">Phân quyền nhân viên</div></div>
          </div>
          <div class="sn-mc-body"><div class="sn-mc-stat" style="font-size:1.1rem; color:#b8c5d9;">Thêm Admin</div><div class="sn-mc-action"><i class="fas fa-arrow-right"></i></div></div>
        </a>

        <a href="/yncuti/devices" class="sn-module-card" style="--mc-color: #29b6f6;">
          <div class="sn-mc-header">
            <div class="sn-mc-icon"><i class="fas fa-mobile-alt"></i></div>
            <div><h3 class="sn-mc-title">Thiết bị</h3><div class="sn-mc-sub">Quản lý HWID</div></div>
          </div>
          <div class="sn-mc-body"><div class="sn-mc-stat" style="font-size:1.1rem; color:#b8c5d9;">Xem danh sách</div><div class="sn-mc-action"><i class="fas fa-arrow-right"></i></div></div>
        </a>
      <% } %>

    </div>

    <!-- HOẠT ĐỘNG GẦN ĐÂY -->
    <div class="vg-card anim d4" style="padding: 24px;">
      <div class="sn-module-header">
        <h3 class="sn-module-title"><i class="fas fa-history" style="color:#81c784"></i> Hoạt động gần đây</h3>
      </div>
      <div class="sn-timeline">
        <% 
          const actionMap = {
            'key_created': { cls: 'create', icon: 'fa-plus', label: 'Tạo Key' },
            'seller_key_created': { cls: 'create', icon: 'fa-plus', label: 'Seller tạo Key' },
            'key_expired_deleted': { cls: 'delete', icon: 'fa-trash', label: 'Tự động xóa' },
            'check': { cls: 'check', icon: 'fa-check', label: 'Check Key' },
          };
        %>
        <% recentLogs.slice(0, 5).forEach(log => {
             const a = actionMap[log.action] || { cls: 'default', icon: 'fa-circle', label: log.action };
        %>
          <div class="sn-timeline-item">
            <div class="sn-timeline-icon <%= a.cls %>"><i class="fas <%= a.icon %>"></i></div>
            <div class="sn-timeline-content">
              <div class="sn-timeline-title"><%= a.label %></div>
              <div class="sn-timeline-desc"><%= log.details %></div>
              <div class="sn-timeline-time"><%= new Date(log.createdAt).toLocaleString('vi-VN') %></div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

  </div>
</div>


<script>
  document.addEventListener("DOMContentLoaded", function() {
    const ctx = document.getElementById('keyChart').getContext('2d');
    const gradient = ctx.createLinearGradient(0, 0, 0, 300);
    gradient.addColorStop(0, 'rgba(255, 215, 0, 0.5)'); // Màu vàng mờ
    gradient.addColorStop(1, 'rgba(255, 215, 0, 0.0)');

    new Chart(ctx, {
      type: 'line',
      data: {
        labels: <%- JSON.stringify(chartLabels) %>,
        datasets: [{
          label: 'Số lượng Key',
          data: <%- JSON.stringify(chartData) %>,
          borderColor: '#ffd700',
          backgroundColor: gradient,
          borderWidth: 3,
          pointBackgroundColor: '#0a1e3f',
          pointBorderColor: '#ffd700',
          pointBorderWidth: 2,
          pointRadius: 4,
          pointHoverRadius: 6,
          fill: true,
          tension: 0.4 // Đường cong mượt
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          x: { grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: '#b8c5d9' } },
          y: { grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: '#b8c5d9', stepSize: 1 }, beginAtZero: true }
        }
      }
    });
  });
</script>
  

<script>
  // TỰ ĐỘNG CẬP NHẬT SỐ LIỆU MỖI 15 GIÂY (Realtime)
  setInterval(async () => {
    try {
      const res = await fetch('/yncuti/api/dashboard-stats');
      const data = await res.json();
      
      if (data.totalKeys !== undefined) {
        const updateNum = (selector, val) => {
          const el = document.querySelector(selector);
          if (el && el.innerText !== val.toString()) {
            el.innerText = val.toLocaleString('vi-VN');
            el.style.transform = 'scale(1.2)'; // Hiệu ứng giật nhẹ
            el.style.color = '#81c784';        // Nhấp nháy xanh
            setTimeout(() => { el.style.transform = 'scale(1)'; el.style.color = ''; }, 300);
          }
        };
        
        // Cập nhật từng thẻ
        updateNum('.sn-stat.total .sn-stat-value', data.totalKeys);
        updateNum('.sn-stat.active .sn-stat-value', data.activeKeys);
        updateNum('.sn-stat.expired .sn-stat-value', data.expiredKeys);
        updateNum('.sn-stat.devices .sn-stat-value', data.devicesActivated);
      }
    } catch (e) { console.log('Lỗi cập nhật realtime:', e); }
  }, 15000); // 15 giây cập nhật 1 lần
</script>

<%- include('../partials/scripts') %>
<script>
  (function() {
    const now = new Date();
    const hour = parseInt(now.toLocaleString('en-US', { timeZone: 'Asia/Ho_Chi_Minh', hour: '2-digit', hour12: false }));
    let greet = 'Xin chào'; let emoji = '👋';
    if (hour >= 5 && hour < 12) { greet = 'Chào buổi sáng'; emoji = '☀️'; }
    else if (hour >= 12 && hour < 18) { greet = 'Chào buổi chiều'; emoji = '🌤️'; }
    else if (hour >= 18 && hour < 22) { greet = 'Chào buổi tối'; emoji = '🌆'; }
    else { greet = 'Khuya rồi, nghỉ ngơi nhé'; emoji = '🌙'; }
    const g = document.getElementById('snGreet'); if (g) g.textContent = greet + ' ' + emoji;
    const t = document.getElementById('snToday'); if (t) t.textContent = now.toLocaleDateString('vi-VN', { weekday: 'long', day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'Asia/Ho_Chi_Minh' });
  })();
  document.querySelectorAll('.sn-animate-num').forEach(el => {
    const target = parseInt(el.dataset.count) || 0; const dur = 900; const start = performance.now();
    function tick(t) {
      const p = Math.min(1, (t - start) / dur); const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = Math.round(target * eased).toLocaleString('vi-VN');
      if (p < 1) requestAnimationFrame(tick); else el.textContent = target.toLocaleString('vi-VN');
    }
    requestAnimationFrame(tick);
  });
</script>
