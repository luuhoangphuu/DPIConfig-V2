<%- include('../partials/header', { title: 'Dashboard' }) %>
<div class="d-flex">
  <%- include('../partials/sidebar', { user, currentPage: 'dashboard' }) %>
  <div class="main-content flex-grow-1">
    <div class="d-flex justify-content-between align-items-center mb-4 animate__animated animate__fadeInDown">
      <h4 class="fw-bold mb-0">Tổng quan hệ thống</h4>
      <span class="text-muted small"><i class="far fa-calendar-alt me-1"></i> <%= new Date().toLocaleDateString('vi-VN') %></span>
    </div>
    
    <div class="row g-4 mb-4">
      <div class="col-xl-3 col-md-6 animate__animated animate__fadeInUp">
        <div class="stat-card">
          <div class="d-flex justify-content-between align-items-start mb-3">
            <span class="stat-icon">🔑</span>
            <span class="text-muted small">Tất cả</span>
          </div>
          <h3 class="fw-bold mb-0" id="countTotal"><%= totalKeys %></h3>
        </div>
      </div>
      <div class="col-xl-3 col-md-6 animate__animated animate__fadeInUp animate__delay-1s">
        <div class="stat-card">
          <div class="d-flex justify-content-between align-items-start mb-3">
            <span class="stat-icon">✅</span>
            <span class="text-muted small">Hoạt động</span>
          </div>
          <h3 class="fw-bold mb-0" id="countActive"><%= activeKeys %></h3>
        </div>
      </div>
      <div class="col-xl-3 col-md-6 animate__animated animate__fadeInUp animate__delay-2s">
        <div class="stat-card">
          <div class="d-flex justify-content-between align-items-start mb-3">
            <span class="stat-icon">⏳</span>
            <span class="text-muted small">Hết hạn</span>
          </div>
          <h3 class="fw-bold mb-0" id="countExpired"><%= expiredKeys %></h3>
        </div>
      </div>
      <div class="col-xl-3 col-md-6 animate__animated animate__fadeInUp animate__delay-3s">
        <div class="stat-card">
          <div class="d-flex justify-content-between align-items-start mb-3">
            <span class="stat-icon">📱</span>
            <span class="text-muted small">Thiết bị</span>
          </div>
          <h3 class="fw-bold mb-0" id="countDevices"><%= devicesActivated %></h3>
        </div>
      </div>
    </div>

    <div class="stat-card p-3 animate__animated animate__fadeInUp animate__delay-4s">
      <h6 class="fw-bold mb-3">Hoạt động gần đây</h6>
      <div class="table-responsive">
        <table class="table-custom w-100">
          <thead><tr><th>Thời gian</th><th>Hành động</th><th>Chi tiết</th></tr></thead>
          <tbody>
            <% recentLogs.forEach(log => { %>
              <tr>
                <td class="text-muted small"><%= new Date(log.createdAt).toLocaleString('vi-VN') %></td>
                <td><span class="badge bg-primary-soft text-primary"><%= log.action %></span></td>
                <td><%= log.details %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/scripts') %>
<script src="https://cdn.jsdelivr.net/npm/countup.js@2.5.0/dist/countUp.umd.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const options = { duration: 1.5, useEasing: true };
    new countUp.CountUp('countTotal', <%= totalKeys %>, options).start();
    new countUp.CountUp('countActive', <%= activeKeys %>, options).start();
    new countUp.CountUp('countExpired', <%= expiredKeys %>, options).start();
    new countUp.CountUp('countDevices', <%= devicesActivated %>, options).start();
  });
</script>
