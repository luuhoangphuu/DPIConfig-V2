<%- include('../partials/header', { title: 'Bảng điều khiển', pageName: 'Dashboard', user }) %>
<div class="d-flex">
  <%- include('../partials/sidebar', { user, currentPage: 'dashboard', activeKeys }) %>
  <div class="vg-main flex-grow-1">

    <!-- HERO GREETING -->
    <div class="sn-hero anim d1" style="margin-bottom: 20px;">
      <div>
        <h1 class="sn-hero-greet" id="snGreet">Xin chào 👋</h1>
        <p class="sn-hero-sub">
          Bạn đang ở <b>Trung tâm điều khiển</b>. Chọn một mô-đun bên dưới để bắt đầu làm việc.
        </p>
      </div>
    </div>

    <!-- WORKSPACE GRID -->
    <div class="sn-workspace-grid anim d2">
      
      <!-- MODULE 1: KEYS -->
      <a href="/yncuti/keys" class="sn-module-card mc-key">
        <div class="sn-mc-header">
          <div class="sn-mc-icon"><i class="fas fa-key"></i></div>
          <div>
            <h3 class="sn-mc-title">Quản lý Key</h3>
            <div class="sn-mc-sub">Tạo, khóa và xem thiết bị</div>
          </div>
        </div>
        <div class="sn-mc-body">
          <div class="sn-mc-stat"><%= totalKeys %> <span>Keys</span></div>
          <div class="sn-mc-action"><i class="fas fa-arrow-right"></i></div>
        </div>
      </a>

      <% if (isSuper) { %>
        <!-- MODULE 2: ANNOUNCEMENTS -->
        <a href="/yncuti/announcements" class="sn-module-card mc-noti">
          <div class="sn-mc-header">
            <div class="sn-mc-icon"><i class="fas fa-bullhorn"></i></div>
            <div>
              <h3 class="sn-mc-title">Thông báo</h3>
              <div class="sn-mc-sub">Gửi tin nhắn đến App</div>
            </div>
          </div>
          <div class="sn-mc-body">
            <div class="sn-mc-stat" style="font-size:1.1rem; margin-bottom:5px; color:#b8c5d9;">Viết thông báo mới</div>
            <div class="sn-mc-action"><i class="fas fa-arrow-right"></i></div>
          </div>
        </a>

        <!-- MODULE 3: SELLERS -->
        <a href="/yncuti/sellers" class="sn-module-card mc-seller">
          <div class="sn-mc-header">
            <div class="sn-mc-icon"><i class="fas fa-store"></i></div>
            <div>
              <h3 class="sn-mc-title">Người bán</h3>
              <div class="sn-mc-sub">Quản lý đại lý & cấp Token</div>
            </div>
          </div>
          <div class="sn-mc-body">
            <div class="sn-mc-stat"><%= topSellers.length %> <span>Đối tác</span></div>
            <div class="sn-mc-action"><i class="fas fa-arrow-right"></i></div>
          </div>
        </a>

        <!-- MODULE 4: ADMINS -->
        <a href="/yncuti/admins" class="sn-module-card mc-admin">
          <div class="sn-mc-header">
            <div class="sn-mc-icon"><i class="fas fa-user-shield"></i></div>
            <div>
              <h3 class="sn-mc-title">Quản trị viên</h3>
              <div class="sn-mc-sub">Phân quyền nhân viên</div>
            </div>
          </div>
          <div class="sn-mc-body">
            <div class="sn-mc-stat" style="font-size:1.1rem; margin-bottom:5px; color:#b8c5d9;">Thêm Admin mới</div>
            <div class="sn-mc-action"><i class="fas fa-arrow-right"></i></div>
          </div>
        </a>

        <!-- MODULE 5: VERSIONS -->
        <a href="/yncuti/versions" class="sn-module-card mc-version">
          <div class="sn-mc-header">
            <div class="sn-mc-icon"><i class="fas fa-cloud-download-alt"></i></div>
            <div>
              <h3 class="sn-mc-title">Phiên bản App</h3>
              <div class="sn-mc-sub">Cập nhật & Khóa App cũ</div>
            </div>
          </div>
          <div class="sn-mc-body">
            <div class="sn-mc-stat" style="font-size:1.1rem; margin-bottom:5px; color:#b8c5d9;">Quản lý bản cập nhật</div>
            <div class="sn-mc-action"><i class="fas fa-arrow-right"></i></div>
          </div>
        </a>

        <!-- MODULE 6: API -->
        <a href="#" onclick="alert('Tính năng API đang phát triển!'); return false;" class="sn-module-card mc-api">
          <div class="sn-mc-header">
            <div class="sn-mc-icon"><i class="fas fa-code"></i></div>
            <div>
              <h3 class="sn-mc-title">API & Webhook</h3>
              <div class="sn-mc-sub">Tích hợp bên thứ 3</div>
            </div>
          </div>
          <div class="sn-mc-body">
            <div class="sn-mc-stat" style="font-size:1.1rem; margin-bottom:5px; color:#b8c5d9;">Sắp ra mắt</div>
            <div class="sn-mc-action"><i class="fas fa-arrow-right"></i></div>
          </div>
        </a>
      <% } %>

    </div>

    <!-- SECTION: RECENT ACTIVITY (Dưới cùng) -->
    <div class="vg-card anim d3" style="padding: 24px;">
      <div class="sn-module-header">
        <h3 class="sn-module-title"><i class="fas fa-history" style="color:#81c784"></i> Hoạt động gần đây</h3>
      </div>
      <div class="sn-timeline">
        <% 
          const actionMap = {
            'key_created': { cls: 'create', icon: 'fa-plus', label: 'Tạo Key' },
            'seller_key_created': { cls: 'create', icon: 'fa-plus', label: 'Seller tạo Key' },
            'key_expired_deleted': { cls: 'delete', icon: 'fa-trash', label: 'Tự động xóa' },
            'check': { cls: 'check', icon: 'fa-check', label: 'Check Key' },
            'auto_key_created': { cls: 'create', icon: 'fa-robot', label: 'API tạo Key' },
          };
        %>
        <% recentLogs.slice(0, 5).forEach(log => {
             const a = actionMap[log.action] || { cls: 'default', icon: 'fa-circle', label: log.action };
        %>
          <div class="sn-timeline-item">
            <div class="sn-timeline-icon <%= a.cls %>"><i class="fas <%= a.icon %>"></i></div>
            <div class="sn-timeline-content">
              <div class="sn-timeline-title"><%= a.label %></div>
              <div class="sn-timeline-desc"><%= log.details %></div>
              <div class="sn-timeline-time"><%= new Date(log.createdAt).toLocaleString('vi-VN') %></div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

  </div>
</div>

<%- include('../partials/scripts') %>

<script>
  (function() {
    const now = new Date();
    const hour = parseInt(now.toLocaleString('en-US', { timeZone: 'Asia/Ho_Chi_Minh', hour: '2-digit', hour12: false }));
    let greet = 'Xin chào'; let emoji = '👋';
    if (hour >= 5 && hour < 12) { greet = 'Chào buổi sáng'; emoji = '☀️'; }
    else if (hour >= 12 && hour < 18) { greet = 'Chào buổi chiều'; emoji = '🌤️'; }
    else if (hour >= 18 && hour < 22) { greet = 'Chào buổi tối'; emoji = '🌆'; }
    else { greet = 'Khuya rồi, nghỉ ngơi nhé'; emoji = '🌙'; }
    const g = document.getElementById('snGreet'); if (g) g.textContent = greet + ' ' + emoji;
  })();
</script>
