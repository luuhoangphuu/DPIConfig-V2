<%- include('../partials/header', { title: 'Seller Dashboard', pageName: 'Dashboard', user: seller }) %>
<div class="d-flex">
  <%- include('../partials/sidebar', { user: seller, currentPage: 'dashboard', activeKeys: 0 }) %>
  <div class="vg-main flex-grow-1">

    <!-- HERO -->
    <div class="sn-hero anim d1" style="margin-bottom: 24px;">
      <div>
        <h1 class="sn-hero-greet">Xin chào, <%= seller.name %> 👋</h1>
        <p class="sn-hero-sub">Chào mừng đến với Kênh Người Bán · <span id="snToday">--</span></p>
      </div>
      <div class="sn-quick-actions">
        <a href="/seller/keys" class="sn-quick-btn"><i class="fas fa-plus-circle"></i> Tạo Key mới</a>
      </div>
    </div>

    <!-- QUOTA CARD (Dành cho Seller) -->
    <div class="sn-quota anim d2" style="margin-bottom: 24px;">
      <div class="sn-quota-head">
        <h3 class="sn-quota-title">📊 Quota của bạn</h3>
        <div class="sn-quota-nums"><%= seller.quota_used %> / <%= seller.quota %> <small>(còn <%= Math.max(0, seller.quota - seller.quota_used) %> key)</small></div>
      </div>
      <div class="sn-progress">
        <div class="sn-progress-fill <%= (seller.quota_used/seller.quota) > 0.8 ? 'danger' : '' %>" style="width: <%= Math.min(100, (seller.quota_used / seller.quota) * 100) %>%"></div>
      </div>
      <% if (seller.quota_used >= seller.quota) { %>
        <div style="margin-top:12px; padding:10px; background:rgba(239,83,80,0.15); border-left:3px solid #ef5350; border-radius:6px; color:#ff8a80; font-size:0.9rem;">
          <i class="fas fa-exclamation-triangle"></i> Đã hết quota. Vui lòng liên hệ Admin để nạp thêm.
        </div>
      <% } %>
    </div>

    <!-- STAT CARDS -->
    <div class="sn-stat-grid anim d3">
      <div class="sn-stat total">
        <div class="sn-stat-icon"><i class="fas fa-key"></i></div>
        <div class="sn-stat-label">Tổng Key</div>
        <div class="sn-stat-value"><%= totalKeys %></div>
      </div>
      <div class="sn-stat active">
        <div class="sn-stat-icon"><i class="fas fa-check-circle"></i></div>
        <div class="sn-stat-label">Đang hoạt động</div>
        <div class="sn-stat-value"><%= activeKeys %></div>
      </div>
      <div class="sn-stat expired">
        <div class="sn-stat-icon"><i class="fas fa-clock"></i></div>
        <div class="sn-stat-label">Đã hết hạn</div>
        <div class="sn-stat-value"><%= expiredKeys %></div>
      </div>
    </div>

  </div>
</div>
<%- include('../partials/scripts') %>
<script>
  const now = new Date();
  const t = document.getElementById('snToday'); if (t) t.textContent = now.toLocaleDateString('vi-VN', { weekday: 'long', day: '2-digit', month: '2-digit', year: 'numeric' });
</script>
