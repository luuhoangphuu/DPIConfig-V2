<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Seller Dashboard</title>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body { margin: 0; min-height: 100vh; font-family: 'Inter', sans-serif; background: url('/images/starry-night.jpg') center/cover fixed; color: #fff; }
    body::before { content: ''; position: fixed; inset: 0; background: rgba(5,13,31,0.65); z-index: -1; }
    .nav { background: rgba(10,30,63,0.85); backdrop-filter: blur(20px); border-bottom: 1px solid rgba(255,215,0,0.2); padding: 16px 32px; display: flex; justify-content: space-between; align-items: center; }
    .nav h2 { font-family: 'Caveat'; font-size: 1.6rem; color: #ffd700; margin: 0; }
    .nav a { color: #8ba3c7; text-decoration: none; margin-right: 20px; font-weight: 600; }
    .nav a:hover, .nav a.active { color: #ffd700; }
    .container-main { max-width: 1200px; margin: 0 auto; padding: 30px; }
    .welcome { font-family: 'Caveat'; font-size: 2.2rem; color: #ffd700; }
    .sub { color: #81d4fa; margin-bottom: 30px; }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 30px; }
    .card { background: rgba(10,30,63,0.55); backdrop-filter: blur(20px); border: 1px solid rgba(255,215,0,0.2); border-radius: 20px; padding: 24px; }
    .card .label { color: #8ba3c7; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 2px; font-weight: 700; margin-bottom: 10px; }
    .card .value { font-family: 'Caveat'; font-size: 3rem; font-weight: 700; line-height: 1; }
    .v-blue { color: #4fc3f7; } .v-green { color: #81c784; } .v-red { color: #ef5350; } .v-gold { color: #ffd700; }
    .btn-gold { padding: 11px 24px; background: linear-gradient(135deg, #ffd700, #f59e0b); color: #0a1e3f; border: none; border-radius: 12px; font-weight: 800; text-decoration: none; display: inline-block; }
    .btn-gold:hover { color: #0a1e3f; transform: translateY(-2px); }
    .btn-ghost { padding: 9px 18px; background: rgba(5,13,31,0.6); color: #4fc3f7; border: 1.5px solid rgba(79,195,247,0.4); border-radius: 10px; text-decoration: none; }
    .quota-bar { background: rgba(5,13,31,0.6); border-radius: 12px; padding: 20px 24px; border: 1px solid rgba(255,215,0,0.2); margin-bottom: 30px; }
    .quota-progress { height: 12px; background: rgba(5,13,31,0.8); border-radius: 8px; overflow: hidden; margin: 10px 0; }
    .quota-fill { height: 100%; background: linear-gradient(90deg, #4fc3f7, #ffd700); }
  </style>
</head>
<body>
<div class="nav">
  <div style="display: flex; align-items: center; gap: 24px;">
    <h2><i class="fas fa-store"></i> Seller Panel</h2>
    <div>
      <a href="/seller/dashboard" class="active">Dashboard</a>
      <a href="/seller/keys">Key của tôi</a>
    </div>
  </div>
  <div style="display: flex; align-items: center; gap: 14px;">
    <span style="color: #81d4fa; font-size: 0.9rem;"><i class="fas fa-user-circle"></i> <%= seller.name %></span>
    <a href="/seller/logout" class="btn-ghost" style="color: #ef5350; border-color: rgba(239,83,80,0.4);"><i class="fas fa-sign-out-alt"></i></a>
  </div>
</div>
<div class="container-main">
  <div class="welcome">Xin chào, <%= seller.name %>!</div>
  <div class="sub">Đại lý phân phối key · <%= seller.email %></div>

  <div class="quota-bar">
    <div style="display: flex; justify-content: space-between;">
      <div>
        <div style="color: #8ba3c7; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 2px; font-weight: 700;">Quota đã dùng</div>
        <div style="font-family: 'Caveat'; font-size: 2.2rem; color: #ffd700; line-height: 1;"><%= seller.quota_used %> / <%= seller.quota %></div>
      </div>
      <div style="text-align: right;">
        <div style="color: #8ba3c7; font-size: 0.85rem;">Còn lại</div>
        <div style="font-size: 1.6rem; color: #81c784; font-weight: 800;"><%= Math.max(0, seller.quota - seller.quota_used) %> key</div>
      </div>
    </div>
    <div class="quota-progress">
      <div class="quota-fill" style="width: <%= seller.quota > 0 ? Math.min(100, (seller.quota_used / seller.quota * 100)) : 0 %>%"></div>
    </div>
  </div>

  <div class="grid">
    <div class="card"><div class="label">Tổng Key</div><div class="value v-blue"><%= totalKeys %></div></div>
    <div class="card"><div class="label">Hoạt động</div><div class="value v-green"><%= activeKeys %></div></div>
    <div class="card"><div class="label">Hết hạn</div><div class="value v-red"><%= expiredKeys %></div></div>
    <div class="card"><div class="label">Còn quota</div><div class="value v-gold"><%= Math.max(0, seller.quota - seller.quota_used) %></div></div>
  </div>

  <a href="/seller/keys" class="btn-gold"><i class="fas fa-key"></i> Quản lý Key</a>
</div>
</body>
</html>
