<%- include('../partials/header', { title: 'Quản lý Key', pageName: 'Quản lý Key', user: seller }) %>
<div class="d-flex">
  <%- include('../partials/sidebar', { user: seller, currentPage: 'keys', activeKeys: 0 }) %>
  <div class="vg-main flex-grow-1">

    <!-- HERO -->
    <div class="sn-hero anim d1" style="margin-bottom: 20px;">
      <div>
        <h1 class="sn-hero-greet">🔑 Kho Key của bạn</h1>
        <p class="sn-hero-sub">Tổng <b><%= keys.length %></b> key đang hiển thị</p>
      </div>
      <div class="sn-quick-actions">
        <button class="sn-quick-btn" data-bs-toggle="modal" data-bs-target="#createKeyModal">
          <i class="fas fa-plus-circle"></i> Tạo Key mới
        </button>
      </div>
    </div>

    <!-- BẢNG DỮ LIỆU -->
    <div class="vg-card vg-table-wrap anim d2" style="padding: 0; overflow-x: auto;">
      <table class="vg-table" style="min-width: 800px;">
        <thead>
          <tr>
            <th>Key</th>
            <th>Hạng</th>
            <th>Thiết bị</th>
            <th>Còn lại</th>
            <th>Bật/Tắt</th>
            <th style="text-align:right;">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          <% keys.forEach(k => {
               const devs = k.devices || [];
               const active = devs.filter(d => d.is_active).length;
               const isExpired = new Date(k.expires_at) < new Date();
          %>
            <tr class="sn-key-row">
              <td><code class="sn-key-code"><%= k.key %></code></td>
              <td>
                <span class="<%= k.tier === 'VIP' ? 'vg-badge-vip' : 'vg-badge-normal' %>">
                  <%= k.tier === 'VIP' ? '★ VIP' : 'Thường' %>
                </span>
              </td>
              <td>
                <span style="font-weight:800;color:#4fc3f7;font-family:'Caveat';font-size:1.2rem;"><%= active %></span>
                <span style="color:#b8c5d9;">/ <%= k.max_devices %></span>
              </td>
              <td><span class="countdown" data-expiry="<%= k.expires_at.toISOString() %>">--</span></td>
              <td>
                <form method="POST" action="/seller/keys/toggle/<%= k.id %>" style="margin:0;">
                  <label class="vg-toggle">
                    <input type="checkbox" <%= k.is_active && !isExpired ? 'checked' : '' %> onchange="this.form.submit()">
                    <span class="vg-slider"></span>
                  </label>
                </form>
              </td>
              <td style="text-align:right;">
                <!-- CHỈ GIỮ LẠI NÚT XEM THIẾT BỊ -->
                <button class="vg-btn-icon view-devices-btn" data-key-id="<%= k.id %>" data-tooltip="Xem thiết bị">
                  <i class="fas fa-mobile-alt"></i>
                </button>
              </td>
            </tr>
          <% }) %>
          <% if (keys.length === 0) { %>
            <tr><td colspan="6" style="text-align:center; padding: 40px; color:#6b7a94;">Chưa có Key nào. Hãy tạo Key mới!</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- PHÂN TRANG -->
    <div class="sn-pagination-bar anim d3" style="margin-top: 24px;">
      <div class="sn-page-info">
        Hiển thị <b><%= (currentPage - 1) * 15 + 1 %></b> - <b><%= Math.min(currentPage * 15, totalPages * 15) %></b>
      </div>
      <div class="sn-page-controls">
        <a href="?page=<%= currentPage - 1 %>&search=<%= search %>" class="sn-page-btn <%= currentPage === 1 ? 'disabled' : '' %>">
          <i class="fas fa-chevron-left"></i> Trước
        </a>
        <a href="?page=<%= currentPage + 1 %>&search=<%= search %>" class="sn-page-btn <%= currentPage === totalPages || totalPages === 0 ? 'disabled' : '' %>">
          Sau <i class="fas fa-chevron-right"></i>
        </a>
      </div>
    </div>

  </div>
</div>

<!-- MODAL: TẠO KEY (ÉP CỨNG TIỀN TỐ) -->
<div class="modal fade" id="createKeyModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content vg-modal">
      <div class="modal-header">
        <h5 class="modal-title"><i class="fas fa-star"></i> Tạo Key mới</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form method="POST" action="/seller/keys/create">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Tiền tố</label>
            <input type="text" class="form-control" value="ZwicApex" readonly style="background: rgba(0,0,0,0.3); color: #b8c5d9; cursor: not-allowed;">
            <small style="color:#ffd700; font-size:0.75rem; margin-top:4px; display:block;">* Hệ thống tự động gán tiền tố ZwicApex</small>
          </div>
          <div class="mb-3">
            <label class="form-label">Hạng</label>
            <select name="tier" class="form-select" id="tierSelectSeller" required>
              <option value="VIP">★ VIP</option>
              <option value="Normal" selected>Thường</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Thời hạn</label>
            <select name="duration" class="form-select" id="durationSelectSeller" required>
              <option value="0.333333" selected>8 giờ (Mặc định Thường)</option>
              <option value="0.083333">2 giờ (Mặc định VIP)</option>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="vg-btn-ghost" data-bs-dismiss="modal">Hủy</button>
          <button type="submit" class="vg-btn"><i class="fas fa-check"></i> Tạo Key</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- DRAWER: XEM THIẾT BỊ -->
<div class="sn-drawer-overlay" id="drawerOverlay"></div>
<div class="sn-drawer" id="devicesDrawer">
  <div class="sn-drawer-header">
    <h3 class="sn-drawer-title"><i class="fas fa-mobile-alt"></i> Thiết bị</h3>
    <button class="sn-drawer-close" onclick="closeDrawer()"><i class="fas fa-times"></i></button>
  </div>
  <div class="sn-drawer-body" id="devicesDrawerBody"></div>
</div>


<script>
  document.addEventListener('DOMContentLoaded', function() {
    const tierSeller = document.getElementById('tierSelectSeller');
    const durSeller = document.getElementById('durationSelectSeller');
    
    if (tierSeller && durSeller) {
      tierSeller.addEventListener('change', function() {
        if (this.value === 'VIP') {
          durSeller.value = '0.083333'; // 2 giờ
        } else {
          durSeller.value = '0.333333'; // 8 giờ
        }
      });
    }
  });
</script>

<%- include('../partials/scripts') %>
<script>
function closeDrawer() {
  document.getElementById('devicesDrawer').classList.remove('open');
  document.getElementById('drawerOverlay').classList.remove('open');
}
document.getElementById('drawerOverlay')?.addEventListener('click', closeDrawer);

document.querySelectorAll('.view-devices-btn').forEach(btn => {
  btn.addEventListener('click', async function() {
    const keyId = this.dataset.keyId; const body = document.getElementById('devicesDrawerBody');
    body.innerHTML = '<div class="sn-skeleton sn-skeleton-row" style="height:50px;"></div><div class="sn-skeleton sn-skeleton-row" style="height:50px;"></div>';
    document.getElementById('devicesDrawer').classList.add('open'); document.getElementById('drawerOverlay').classList.add('open');
    
    try {
      const res = await fetch('/seller/keys/devices/' + keyId); const data = await res.json();
      if (data.success && data.devices.length) {
        let html = '<table class="vg-table"><thead><tr><th>HWID</th><th>Tên</th><th>Trạng thái</th></tr></thead><tbody>';
        data.devices.forEach(d => { html += `<tr><td><code>${d.hwid.substring(0,18)}...</code></td><td>${d.device_name || 'Chưa đặt'}</td><td>${d.is_active ? '<span style="color:#81c784">● Hoạt động</span>' : '<span style="color:#ef5350">● Bị khóa</span>'}</td></tr>`; });
        body.innerHTML = html + '</tbody></table>';
      } else { body.innerHTML = '<div class="vg-empty"><p>Chưa có thiết bị</p></div>'; }
    } catch (e) { body.innerHTML = '<p style="text-align:center;color:#ef5350;">Lỗi tải dữ liệu</p>'; }
  });
});
</script>
